+/// Fire Emblem Fates keeps a chapter's people in GameData/Person/[A|B|C/]<STEM>.bin.lz: one
+/// Person block whose first word points at its archive name. Person::Serialize (0044AB60)
+/// writes the names of the loaded chapter blocks into a battle save and Person::Deserialize
+/// (0044A0FC) loads GameData/Person/<route>/<name>.bin.lz (else GameData/Person/<name>.bin.lz)
+/// back, so a block must carry its own file's name, as every file of the game does. A mod's
+/// file that kept the name of the file it was copied from (Seal of Flames v6: its 41 new
+/// chapters) makes the reload take the original chapter's people: other enemies, a black
+/// screen, or back to the title (docs/tests/SEAL_SAVE.md). Served under its own name: only a
+/// mod's file under GameData/Person, only a name of the same length that nothing else points
+/// at; every other byte is kept.
+pub fn fates_person_name(path: &str, bytes: &[u8]) -> Option<Vec<u8>> {
+    use crate::fates_rando_file::{inplace_margin, lz11_compress, lz_decompress, IsBin};
+    let stem = path.strip_prefix("GameData/Person/")?.rsplit('/').next()?.strip_suffix(".bin.lz")?;
+    let lz = lz_decompress(bytes).ok()?;
+    if lz.format != 0x13 && lz.format != 0x11 {
+        return None;
+    }
+    let mut bin = IsBin::parse(&lz.data).ok()?;
+    if !bin.relocs.contains(&0) {
+        return None;
+    }
+    let ptr = bin.word(0)?;
+    let name = bin.string_at(ptr)?.to_vec();
+    if name == stem.as_bytes() {
+        return None;
+    }
+    if name.len() != stem.len() || bin.relocs.iter().filter(|&&r| bin.word(r) == Some(ptr)).count() != 1 {
+        log::warn!("mods: {path}: its person archive is named {}; not changed (a battle save of this chapter will not reload its own people)", String::from_utf8_lossy(&name));
+        return None;
+    }
+    let at = (ptr - bin.se()) as usize;
+    bin.strtab[at..at + stem.len()].copy_from_slice(stem.as_bytes());
+    let data = bin.build();
+    let mut out = lz11_compress(&data, lz.format, if lz.format == 0x13 { data.len() as u32 } else { 0 });
+    if lz.format == 0x13 {
+        // decoded in place by the game: the outer size keeps every write behind the reads
+        // (the same rule as fates_rando_file's patched files, patch 0017)
+        let need = (out.len() as i64 + inplace_margin(&out)).max(data.len() as i64);
+        if need >= 1 << 24 {
+            return None;
+        }
+        out[1..4].copy_from_slice(&(need as u32).to_le_bytes()[..3]);
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod person_name_tests {
+    use super::*;
+    use crate::fates_rando_file::{lz11_compress, lz_decompress, IsBin};
+
+    /// a small Person block: word 0 points at the archive name, one more pointer at a person.
+    fn block(name: &str) -> Vec<u8> {
+        let mut strtab = name.as_bytes().to_vec();
+        strtab.push(0);
+        let pid_at = strtab.len() as u32;
+        strtab.extend_from_slice(b"PID_X\0");
+        let mut bin = IsBin { pad: [0; 16], data: vec![0; 16], relocs: vec![0, 8], labels: vec![], strtab };
+        let se = bin.se();
+        bin.data[0..4].copy_from_slice(&se.to_le_bytes());
+        bin.data[8..12].copy_from_slice(&(se + pid_at).to_le_bytes());
+        let raw = bin.build();
+        lz11_compress(&raw, 0x13, raw.len() as u32)
+    }
+
+    #[test]
+    fn a_copied_name_is_served_as_the_files_own() {
+        let out = fates_person_name("GameData/Person/C/R002.bin.lz", &block("X020")).expect("renamed");
+        let want = lz_decompress(&block("R002")).unwrap().data;
+        assert_eq!(lz_decompress(&out).unwrap().data, want);
+        let orig = lz_decompress(&block("X020")).unwrap().data;
+        let diff = orig.iter().zip(&want).filter(|(a, b)| a != b).count();
+        assert!(diff >= 1 && diff <= 4, "only the name differs");
+    }
+
+    #[test]
+    fn everything_else_is_left_alone() {
+        assert_eq!(fates_person_name("GameData/Person/C/R002.bin.lz", &block("R002")), None);
+        assert_eq!(fates_person_name("GameData/Person/C/R002.bin.lz", &block("X0201")), None);
+        assert_eq!(fates_person_name("GameData/Dispos/C/R002.bin.lz", &block("X020")), None);
+        assert_eq!(fates_person_name("GameData/Person/C/R002.bin.lz", b"not lz at all"), None);
+    }
+}
