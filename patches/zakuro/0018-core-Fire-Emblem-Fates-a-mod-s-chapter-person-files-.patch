+    /// fix over every file the mod put in, under the directory at `at` (path `path`).
+    fn fix(&mut self, at: usize, path: &str, fix: Fix, game: (&RomFs, &[u8]), fixed: &mut Vec<String>) {
+        for leaf in self.dirs[at].files.clone() {
+            if self.leaves[leaf].modded.is_none() {
+                continue;
+            }
+            let p = join(path, &self.leaves[leaf].name);
+            let Ok(data) = self.data(leaf, game) else { continue };
+            if let Some(new) = fix(&p, &data) {
+                self.leaves[leaf].size = new.len() as u64;
+                self.leaves[leaf].modded = Some(Source::Memory(new));
+                fixed.push(p);
+            }
+        }
+        for child in self.dirs[at].children.clone() {
+            let p = join(path, &self.dirs[child].name);
+            self.fix(child, &p, fix, game, fixed);
+        }
+    }
