+    #[test]
+    fn an_off_chapter_passes_everything() {
+        let f = Full::parse(&file().replace("end 5", "off C008\nend 6")).unwrap();
+        let s = Swap::new(&f, TEXT_LANG).unwrap();
+        assert!(s.off_in(Some("C008")) && !s.off_in(Some("C009")) && !s.off_in(None));
+        let mut m = Fake::default();
+        m.put(0x5000_0000, &vec![0u8; 0x1000]);
