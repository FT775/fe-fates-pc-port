+        // the Person list's last chapter file names C008: nothing changes; C009: changed
+        let put_chapter = |m: &mut Fake, ch: &[u8]| {
+            let mut node = vec![0u8; 12];
+            node[0..4].copy_from_slice(&0x3400_0020u32.to_le_bytes());
+            m.put(0x3300_0000, &node);
+            let mut blk = vec![0u8; 0x40];
+            blk[0..4].copy_from_slice(&(0x3400_0020u32 + 0x30).to_le_bytes());
+            blk[0x30..0x30 + ch.len()].copy_from_slice(ch);
+            m.put(0x3400_0020, &blk);
+            m.put(fates_rando::PERSON_LIST, &0x3300_0000u32.to_le_bytes());
+        };
+        put_chapter(&mut m, b"C008");
+        assert_eq!(chapter_now(&mut m).as_deref(), Some("C008"));
+        let mut st = (0, 0);
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_0000, b"MID_TEST_1", false, &mut st), None);
+        put_chapter(&mut m, b"C009");
