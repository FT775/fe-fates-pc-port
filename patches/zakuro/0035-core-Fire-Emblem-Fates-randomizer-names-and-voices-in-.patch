+    fn both_places_are_trapped_and_their_labels_are_found() {
+        assert_eq!(TRAP_SITES, [MESS_GET_RETURN, NOREPLACE_RETURN]);
+        let mut m = Fake::default();
+        m.put(0x3100_0000, b"MID_TEST_1\0");
+        // GetNoReplace: the label is read from the "<label>_COM" in the stack buffer at sp
+        let mut stack = vec![0u8; 0x50];
+        stack[..15].copy_from_slice(b"MID_SCENE_2_COM");
+        m.put(0x0FFF_0000, &stack);
+        assert_eq!(label_at(&mut m, MESS_GET_RETURN, 0x3100_0000, 0x0FFF_0000), b"MID_TEST_1".to_vec());
+        assert_eq!(label_at(&mut m, NOREPLACE_RETURN, 0x3100_0000, 0x0FFF_0000), b"MID_SCENE_2".to_vec());
+        // a person's name label behind GetNoReplace is still left
+        stack[..14].copy_from_slice(b"MPID_TEST_COM\0");
+        m.put(0x0FFF_0000, &stack);
+        let l = label_at(&mut m, NOREPLACE_RETURN, 0, 0x0FFF_0000);
+        assert_eq!(l, b"MPID_TEST".to_vec());
+        let s = swap();
+        m.put(0x5000_0000, &vec![0u8; 0x1000]);
+        let mut ring = Ring::new(0x5000_0000, 0x1000);
+        let line: Vec<u8> = u("Aaron!").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        m.put(0x3000_0000, &line);
+        let mut st = (0, 0);
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_0000, &l, false, &mut st), None);
+        // a scene line with a silenced voice behind GetNoReplace: changed
+        let scene: Vec<u8> = u("$SvpVOICE_AARON_EVT_01|Carl, wait!$k").iter().flat_map(|c| c.to_le_bytes())
+            .chain([0, 0]).collect();
+        m.put(0x3000_4000, &scene);
+        let at = on_result(&s, &mut m, &mut ring, 0x3000_4000, b"MID_SCENE_2", false, &mut st).unwrap();
+        assert_eq!(String::from_utf16(&read_text(&mut m, at, 64).unwrap()).unwrap(), "Doran, wait!$k");
+    }
