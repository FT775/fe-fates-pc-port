+    #[test]
+    fn the_ring_wraps_and_keeps_the_last_two_results() {
+        const BASE: u32 = 0x5000_0000;
+        let mut m = Fake::default();
+        m.put(BASE, &[0u8; 256]);
+        let mut ring = Ring::new(BASE, 256);
+        let texts = ["aaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbb", "cccccccccccccccccccccc", "dddddddddddddddddddddddd",
+                     "eeeeeeeeeeeeeeeeeeeee", "ffffffffffffffffffff"];
+        let mut held: Vec<(u32, &str)> = Vec::new();
+        let mut wrapped = false;
+        for t in texts {
+            let at = write_text(&mut m, &mut ring, &u(t)).unwrap();
+            if let Some(&(last, _)) = held.last() {
+                wrapped |= at < last;
+            }
+            held.push((at, t));
+            // the result before this one and this one are both whole (a caller holding two)
+            for &(a, want) in held.iter().rev().take(2) {
+                assert_eq!(read_text(&mut m, a, 64).map(|v| String::from_utf16(&v).unwrap()).as_deref(), Some(want));
+            }
+            assert!(at % 4 == 0 && at >= BASE && at < BASE + 256);
+        }
+        assert!(wrapped, "six texts of 42-52 bytes go round a 256-byte ring");
+        // a text over a quarter of the ring is not placed (it stays unchanged)
+        assert!(write_text(&mut m, &mut ring, &u(&"x".repeat(40))).is_none());
+    }
