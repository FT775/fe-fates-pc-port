+    #[test]
+    fn the_trap_changes_a_line_and_leaves_names_and_untouched_texts() {
+        let s = swap();
+        let mut m = Fake::default();
+        const RING: u32 = 0x5000_0000;
+        m.put(RING, &vec![0u8; 0x1000]);
+        let mut ring = Ring::new(RING, 0x1000);
+        // the message file (a line naming Aaron), a name text, a line naming no one, labels
+        let line: Vec<u8> = u("Aaron!").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        let name: Vec<u8> = u("Baker").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        let none: Vec<u8> = u("Hello.").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        m.put(0x3000_0000, &line);
+        m.put(0x3000_1000, &name);
+        m.put(0x3000_2000, &none);
+        m.put(0x3100_0000, b"MID_TEST_1\0");
+        m.put(0x3100_1000, b"MPID_TEST\0");
+        let mut st = (0, 0);
+        let at = on_result(&s, &mut m, &mut ring, 0x3000_0000, b"MID_TEST_1", false, &mut st).unwrap();
+        assert_eq!(String::from_utf16(&read_text(&mut m, at, 64).unwrap()).unwrap(), "Baker!");
+        // the file's own text is never written
+        assert_eq!(read_text(&mut m, 0x3000_0000, 64).unwrap(), u("Aaron!"));
+        // a person's name label (the table cells already point it at the filler): left
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_1000, b"MPID_TEST", false, &mut st), None);
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_2000, b"MID_TEST_1", false, &mut st), None);
+        // unreadable or odd text pointers (the not-found path) are left
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0, b"MID_TEST_1", false, &mut st), None);
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_0001, b"MID_TEST_1", false, &mut st), None);
+        // an unterminated text past the limit is left
+        m.put(0x3200_0000, &vec![0x41u8; 64]);
+        assert_eq!(read_text(&mut m, 0x3200_0000, 16), None);
+    }
