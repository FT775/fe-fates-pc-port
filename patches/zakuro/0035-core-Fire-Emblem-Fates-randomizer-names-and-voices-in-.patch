+    #[test]
+    fn a_built_message_is_returned_as_the_game_built_it() {
+        let s = swap();
+        let mut m = Fake::default();
+        m.put(0x5000_0000, &vec![0u8; 0x1000]);
+        let mut ring = Ring::new(0x5000_0000, 0x1000);
+        // the message with arguments ("$a" first) and the shared buffer holding the built text
+        let tmpl: Vec<u8> = u("$a$0 and $1 met.").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        let done: Vec<u8> = u("Baker and Aaron met.").iter().flat_map(|c| c.to_le_bytes()).chain([0, 0]).collect();
+        m.put(0x3000_0000, &tmpl);
+        m.put(0x3000_1000, &done);
+        assert!(built(&mut m, MESS_GET_RETURN, 0x3000_0000));
+        assert!(!built(&mut m, MESS_GET_RETURN, 0x3000_1000), "a plain message");
+        assert!(!built(&mut m, NOREPLACE_RETURN, 0x3000_0000), "GetNoReplace fills nothing in");
+        assert!(!built(&mut m, MESS_GET_RETURN, 0) && !built(&mut m, MESS_GET_RETURN, 0x7000_0000));
+        let mut st = (0, 0);
+        assert_eq!(on_result(&s, &mut m, &mut ring, 0x3000_1000, b"MID_MSG_X", true, &mut st), None, "never B -> C");
+        assert!(on_result(&s, &mut m, &mut ring, 0x3000_1000, b"MID_MSG_X", false, &mut st).is_some());
+    }
+
+    #[test]
+    fn a_repeated_text_shares_one_copy_while_it_is_young() {
+        const BASE: u32 = 0x5000_0000;
+        let mut m = Fake::default();
+        m.put(BASE, &[0u8; 256]);
+        let mut ring = Ring::new(BASE, 256);
+        let a = write_text(&mut m, &mut ring, &u("hello Baker")).unwrap();
+        let used = ring.total;
+        assert_eq!(write_text(&mut m, &mut ring, &u("hello Baker")), Some(a), "the same copy again");
+        assert_eq!(ring.total, used, "nothing written");
+        // after more than half the ring of other text, a fresh copy is written
+        for t in ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "yyyyyyyyyyyyyyyyyyyyyyyyyyyyy", "zzzzzzzzzzzzzzzzzzzzzzzzzzzzz"] {
+            write_text(&mut m, &mut ring, &u(t)).unwrap();
+        }
+        let b = write_text(&mut m, &mut ring, &u("hello Baker")).unwrap();
+        assert_ne!(b, a);
+        assert_eq!(String::from_utf16(&read_text(&mut m, b, 64).unwrap()).unwrap(), "hello Baker");
+        // a copy whose bytes were changed is not handed out
+        m.write(b, &[0x41, 0]);
+        let c = write_text(&mut m, &mut ring, &u("hello Baker")).unwrap();
+        assert_ne!(c, b);
+        assert_eq!(String::from_utf16(&read_text(&mut m, c, 64).unwrap()).unwrap(), "hello Baker");
+    }
+}
