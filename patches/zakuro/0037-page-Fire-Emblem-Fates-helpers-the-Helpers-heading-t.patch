@@ -0,0 +1,116 @@
+//! Fire Emblem Fates: the Helpers (round 80, owner pick F-057): two comfort rows under the Esc
+//! window's Randomizer button, kept in Zakuro's settings.toml as a `[fates_helpers]` table.
+//!
+//! The getters the other parts call (their names are fixed here):
+//! - `System::helpers()` -> [`Helpers`]: the rows in force for the running game; the defaults
+//!   (Normal, Off) for any title that is not Fire Emblem Fates (Seal of Flames shares its title id).
+//! - [`Helpers::enemy_phase()`] -> [`EnemyPhase`] (Normal / X2 / X4) and
+//!   [`EnemyPhase::factor()`] -> 1, 2 or 4 (the enemy-phase pacing reads it, round 80 A2).
+//! - [`Helpers::true_hit()`] -> bool (the forecast's real-chance painter reads it, round 80 A3).
+//! - `System::set_helpers(Helpers)`: the frontend hands the rows over at game start and on every
+//!   settings change (`apply_settings`).
+//!
+//! The defaults are today's game: with Normal and Off nothing reads guest memory for these rows
+//! and nothing changes. Neither row is ever a randomizer input, so no seed or share code moves.
+//! True hit only paints the host's copy of the screen; the enemy-phase pacing only runs more
+//! emulated frames per real second. Neither writes guest memory. The game's own enemy-phase
+//! option (its Options line 6, Off / Move / All) and the Start key are left as they are.
+//!
+//! Round 80 cut 3 (docs/ROUND80_PLAN.md; robot proof E2 found the 2x / 4x pacing could not reach
+//! its time goal while every fight and turn banner stays at normal speed): the Esc window has no
+//! Enemy phase row and nothing in this build reads [`Helpers::enemy_phase()`]. The field stays in
+//! the `[fates_helpers]` table (read and written as before) so a later round can bring the row
+//! back without a new file format.
+
+use serde::{Deserialize, Serialize};
+
+/// how fast the enemy turn plays (the Esc window's "Enemy phase" row).
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum EnemyPhase {
+    /// today's game, the default.
+    #[default]
+    #[serde(rename = "normal")]
+    Normal,
+    #[serde(rename = "2x")]
+    X2,
+    #[serde(rename = "4x")]
+    X4,
+}
+
+impl EnemyPhase {
+    pub const ALL: [EnemyPhase; 3] = [EnemyPhase::Normal, EnemyPhase::X2, EnemyPhase::X4];
+
+    /// emulated frames per screen frame while the enemy phase may run fast: 1, 2 or 4.
+    pub fn factor(self) -> u32 {
+        match self {
+            EnemyPhase::Normal => 1,
+            EnemyPhase::X2 => 2,
+            EnemyPhase::X4 => 4,
+        }
+    }
+
+    /// the word the row shows.
+    pub fn name(self) -> &'static str {
+        match self {
+            EnemyPhase::Normal => "Normal",
+            EnemyPhase::X2 => "2x",
+            EnemyPhase::X4 => "4x",
+        }
+    }
+
+    /// the value written in settings.toml (and in the page robot's target names).
+    pub fn key(self) -> &'static str {
+        match self {
+            EnemyPhase::Normal => "normal",
+            EnemyPhase::X2 => "2x",
+            EnemyPhase::X4 => "4x",
+        }
+    }
+}
+
+/// the Helpers rows. `Default` (Normal, Off) is today's game and is never written to the file.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Helpers {
+    pub enemy_phase: EnemyPhase,
+    pub true_hit: bool,
+}
+
+impl Helpers {
+    /// the "Enemy phase" row.
+    pub fn enemy_phase(&self) -> EnemyPhase {
+        self.enemy_phase
+    }
+
+    /// the "True hit" row: the forecast also shows the real chance to hit.
+    pub fn true_hit(&self) -> bool {
+        self.true_hit
+    }
+
+    /// both rows at today's game.
+    pub fn is_default(&self) -> bool {
+        *self == Helpers::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_defaults_are_todays_game() {
+        let helpers = Helpers::default();
+        assert_eq!(helpers.enemy_phase(), EnemyPhase::Normal);
+        assert_eq!(helpers.enemy_phase().factor(), 1);
+        assert!(!helpers.true_hit());
+        assert!(helpers.is_default());
+    }
+
+    #[test]
+    fn the_factors_and_words() {
+        let got: Vec<_> = EnemyPhase::ALL.iter().map(|p| (p.factor(), p.name(), p.key())).collect();
+        assert_eq!(got, [(1, "Normal", "normal"), (2, "2x", "2x"), (4, "4x", "4x")]);
+        assert!(!Helpers { enemy_phase: EnemyPhase::X4, true_hit: false }.is_default());
+        assert!(!Helpers { enemy_phase: EnemyPhase::Normal, true_hit: true }.is_default());
+    }
+}
