+    /// one frame of the Paused window over a game, with a click at `click` when given.
+    fn paused_frame(ctx: &egui::Context, menus: &mut Menus, program_id: u64, helpers: &mut Helpers, screen: Vec2, click: Option<egui::Pos2>) -> Vec<Action> {
+        let mut events = Vec::new();
+        if let Some(at) = click {
+            let press = |pressed| egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE };
+            events.extend([egui::Event::PointerMoved(at), press(true), press(false)]);
+        }
+        let input = egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, screen)), events, ..Default::default() };
+        let mut actions = Vec::new();
+        ctx.run_ui(input, |ui| {
+            actions = menus.game(ui, "A game", Some(program_id), None, false, false, &[], 0, None, helpers);
+        })
+        .drop_without_applying_deltas();
+        actions
