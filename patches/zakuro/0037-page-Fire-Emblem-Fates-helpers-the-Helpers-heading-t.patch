 /// a line a GameOverlay keeps over the game, in the bottom right corner.
+/// round 80: the Helpers rows' words (Grok's, docs/collab/ROUND80_HELPERS_GROK.md).
+pub const HELPERS_HEADING: &str = "Helpers";
+pub const TRUE_HIT_HELP: &str = "Also shows the real chance to hit, such as 70 (real 79). It never changes a roll.";
+/// round 80 cut 3 (docs/ROUND80_PLAN.md): no 2x / 4x row; the line points at the game's own
+/// enemy-turn skip, with what robot proof E1 (R4) found about it.
+pub const HELPERS_LINE: &str = "Faster enemy turns: use the game's own Options line 6 (Off, Move, or All), or press the Start key during the enemy turn. Units, HP and hits stay the same, but later enemy moves can differ, as when you take more or less time on your turn.";
+
+/// round 80: Fire Emblem Fates' Helpers in the Paused window, under the Randomizer button: the
+/// heading, the True hit row and the help line (the Enemy phase row was cut, round 80 cut 3:
+/// the line points at the game's own skip). Each control reports where it is drawn
+/// (`helpers:section`, `helpers:opt:true_hit=<off|on>`), for the page robot. True when a row changed (the caller
+/// saves the settings and hands them to the game).
+pub fn helper_rows(ui: &mut egui::Ui, helpers: &mut Helpers, targets: &mut Vec<(String, egui::Rect)>) -> bool {
+    let before = *helpers;
+    ui.add_space(4.0);
+    let heading = ui.label(RichText::new(HELPERS_HEADING).strong().color(Color32::from_rgb(150, 200, 255)));
+    targets.push(("helpers:section".to_owned(), heading.rect));
+    egui::Grid::new("fates helpers").num_columns(2).spacing([8.0, 4.0]).show(ui, |ui| {
+        ui.label("True hit").on_hover_text(TRUE_HIT_HELP);
+        ui.horizontal(|ui| {
+            let off = ui.selectable_value(&mut helpers.true_hit, false, "Off").on_hover_text(TRUE_HIT_HELP);
+            targets.push(("helpers:opt:true_hit=off".to_owned(), off.rect));
+            let on = ui.selectable_value(&mut helpers.true_hit, true, "On").on_hover_text(TRUE_HIT_HELP);
+            targets.push(("helpers:opt:true_hit=on".to_owned(), on.rect));
+        });
+        ui.end_row();
+    });
+    ui.scope(|ui| {
+        ui.set_max_width(210.0);
+        ui.label(RichText::new(HELPERS_LINE).weak().small());
+    });
+    ui.add_space(4.0);
+    *helpers != before
+}
