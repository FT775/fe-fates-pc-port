+// ------------------------------------------------------------------ whether the page shows
+
+/// round 83 (H1): whether a start with a window shows the Choose your game page: only
+/// in a program the page applies to, and only when Seal of Flames is there (installed,
+/// or there but needing repair, so its repair line can show). With no Seal profile the
+/// page is skipped: a player who never added the mod never sees it.
+pub fn page_wanted(applies: bool, seal: &SealStatus) -> bool {
+    applies && *seal != SealStatus::Missing
+}
+
+/// round 83 (H5): the headless report's line on whether a start with a window would
+/// show the page.
+pub fn page_line(applies: bool, seal: &SealStatus) -> &'static str {
+    if !applies {
+        "skipped (not a Fire Emblem Fates program)"
+    } else if page_wanted(applies, seal) {
+        "would open"
+    } else {
+        "skipped (Seal not installed)"
+    }
+}
+
+/// what a start with a window does in a program the page applies to.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Start {
+    /// the Choose your game page, with this game pre-selected.
+    Page(Game),
+    /// no page: this game starts at once (never remembered: the player's own
+    /// game-choice.txt is left as it is), and the log line to write, if any.
+    Play(Game, Option<String>),
+}
+
+/// round 83 (H1, H3): the page when Seal of Flames is there; else Fire Emblem Fates at
+/// once. A remembered or asked-for (`--game seal`, FEF_GAME_CHOICE) Seal of Flames that
+/// is not there starts Fire Emblem Fates too, with one log line saying so.
+pub fn windowed_start(seal: &SealStatus, preselect: Game) -> Start {
+    if page_wanted(true, seal) {
+        return Start::Page(preselect);
+    }
+    let note = (preselect == Game::Seal).then(|| format!("{SEAL_NAME} was asked for but is not installed; starting {FATES_NAME}"));
+    Start::Play(Game::Fates, note)
+}
+
+/// round 83 (H2): the Esc menu's Switch game while `playing` plays: the other game and
+/// why it can't be chosen now; none when the other game is a Seal of Flames that was
+/// never added.
+pub fn switch_offer(playing: Game, seal: &SealStatus) -> Option<(Game, Option<String>)> {
+    let to = playing.other();
+    if to == Game::Seal && *seal == SealStatus::Missing {
+        return None;
+    }
+    Some((to, if to == Game::Seal { seal.reason() } else { None }))
+}
