+        install_fake(&dir);
+        let launcher_said = seal_status(Some(&dir), true);
+        let mut cases = vec![(launcher_said, true)];
+        std::fs::write(dir.join("profile.json"), "{not json").unwrap();
+        cases.push((seal_status(Some(&dir), false), false));
+        for (status, broken_flag) in cases {
+            assert!(matches!(status, SealStatus::Broken(_)), "{status:?}");
+            assert!(page_wanted(true, &status));
+            assert_eq!(windowed_start(&status, Game::Seal), Start::Page(Game::Seal));
+            assert_eq!(page_line(true, &status), "would open");
+            let (to, why) = switch_offer(Game::Fates, &status).expect("Switch game offered");
+            assert_eq!(to, Game::Seal);
+            assert!(why.unwrap().contains("repair"));
+            // the page pre-selects Fire Emblem Fates, Seal greyed with Install
+            let pick = GamePick::new(Some(dir.clone()), broken_flag, Game::Seal);
