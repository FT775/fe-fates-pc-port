+/// round 83 (H4): where the port keeps sof.py, in the order looked for: the Seal of
+/// Flames edition's `tools\seal\sof.py` first, then the old `tools\play\sof.py`.
+fn sof_places(repo: &Path) -> [PathBuf; 2] {
+    [repo.join("tools").join("seal").join("sof.py"), repo.join("tools").join("play").join("sof.py")]
+}
+
+/// the port's sof.py in this folder: `tools\seal\sof.py` when it is there, else
+/// `tools\play\sof.py` (also when neither is, so an error names a real place).
+pub fn sof_script(repo: &Path) -> PathBuf {
+    let [seal, play] = sof_places(repo);
+    if seal.is_file() {
+        seal
+    } else {
+        play
+    }
+}
+
+/// the first of these folders that holds the port's sof.py (either place).
+fn port_folder<'a>(mut dirs: impl Iterator<Item = &'a Path>) -> Option<PathBuf> {
+    dirs.find(|dir| sof_places(dir).iter().any(|script| script.is_file())).map(Path::to_owned)
+}
