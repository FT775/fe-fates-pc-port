+//! Fire Emblem Fates randomizer: the session glue around `fates_rando` (round 51,
+//! docs/RANDOMIZER_INGAME.md). Everything here does nothing unless the game is Fire
+//! Emblem Fates, and writes nothing to the game unless a randomized run is active: a run
+//! becomes active only by an answer with Randomizer on at the New Game mode pick, or by
+//! loading a save whose side file names one.
+//!
+//! - **after every frame** (`after_frame`, called by `System::run_frame`, so headless runs
+//!   and boot-server get it as well as the window): watches for the mode pick
+//!   (`NewGameWatch`, read only). Interactive (the window set `interactive`): marks a
+//!   pending new game for the page (`take_pending`), which pauses the game and answers
+//!   with `answer`. Not interactive (headless, boot-server): answers at once with the
+//!   queued answer (`queue_answer`: boot-server's `rando-answer FILE`), or the file named
+//!   by `FEF_RANDO_ANSWER`, or "Randomizer off".
+//! - **answer**: Randomizer off = any active run reverted, the original game goes on. On =
+//!   Python (`rando.py make --patch-out`, started hidden: CREATE_NO_WINDOW, its output
+//!   into the log) makes the patch, then every GameData cell is checked and laid (or
+//!   nothing), and the run's files are kept in `<data>/rando/<title>/runs/<id>/`.
+//! - **placement files** are patched inside the game's own read (`overlay_read`,
+//!   `fates_rando_file`).
+//! - **saves**: every open-for-read of a save file (`Chapter0..2`, `Map0.bak`, `Map1.bak`)
+//!   lays that save's run or reverts to the original (`save_opened_for_read`); a write of
+//!   one writes or removes its side file (`save_written`).
+//! - **save states**: `state_run` / `state_restore` and the `<state>.rando.json` sidecar.
+
+use std::collections::{HashMap, HashSet};
+use std::io::{BufRead, BufReader, Read};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use crate::fates_rando::{self, Guest, NewGameWatch, Patch, Run, TITLE};
+use crate::System;
+
+/// Windows' CREATE_NO_WINDOW: a console program started with it never opens a window.
+pub const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+/// the longest `rando.py make` may take.
+pub const MAKE_TIMEOUT: Duration = Duration::from_secs(120);
+/// the longest `python --version` may take.
+pub const PROBE_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// a placement file of the active run and where it sits in the RomFS the game reads.
+#[derive(Debug)]
+struct Placement {
+    file: usize,
+    /// offset of the stored file from the start of the "romfs:/" file the game reads
+    start: u64,
+    len: u64,
+    /// the patched stored bytes, made at the first read (None inside = refused)
+    served: Option<Option<Arc<Vec<u8>>>>,
+    /// refused only because the patched copy is bigger than the original (it is laid in
+    /// memory at the next system call instead)
+    late: bool,
+}
+
+/// system calls to wait, after a placement read, for the game to store the file.
+const SVC_WAIT: u32 = 20_000;
+
+#[derive(Debug, Default)]
+pub struct Session {
+    /// the window shows the Randomizer page at the mode pick; off (the default), the
+    /// answer comes from `queue_answer` / FEF_RANDO_ANSWER or is "off".
+    pub interactive: bool,
+    watch: NewGameWatch,
+    pending: bool,
+    queued: Option<String>,
+    run: Option<Run>,
+    placements: Vec<Placement>,
+    /// files of the save archives written since they were opened
+    written: HashSet<u32>,
+    /// a placement file read whose patched copy did not fit in the original's size:
+    /// (its name, index in the patch, the data start of the placements in memory at the
+    /// read, system calls left to wait). Laid in memory at the first system call after
+    /// the game stored the new data start (`before_svc`).
+    dispos_wait: Option<(String, usize, Option<u32>, u32)>,
+    /// frames since the game last opened a save slot at the title: a load from the title
+    /// reads its save in the very frame the mode word changes, and a save made before the
+    /// Prologue starts still has GameConfigData's +0xB at 1 then (round 51, robot T5), so
+    /// that change is a load, not a new game
+    since_slot_read: Option<u32>,
+    pub notices: Vec<String>,
+}
+
+/// a mode-word change at most this many frames after a save slot was read is a load.
+const LOAD_WINDOW: u32 = 2;
+
+fn is_fates(system: &System) -> bool {
+    system.title.as_ref().is_some_and(|t| t.program_id() == TITLE)
+}
+
+fn data_dir(system: &System) -> PathBuf {
+    system.config.data_dir.clone().unwrap_or_else(|| PathBuf::from("."))
+}
+
+/// `<data>/rando/<title>/runs/<id>/`
+pub fn run_dir(data: &Path, id: &str) -> PathBuf {
+    data.join("rando").join(format!("{TITLE:016X}")).join("runs").join(id)
+}
+
+fn notice(system: &mut System, text: String) {
+    log::warn!("fates_rando: {text}");
+    system.rando.notices.push(text);
+}
+
+/// the run id of an answer: `<seed>-<8 hex of the answer>`.
+pub fn run_id(seed: &str, answer: &str) -> String {
+    format!("{seed}-{:08x}", fnv(answer))
+}
+
+/// a JSON value's text for a top-level key (true/false/number, or a string's contents).
+/// Enough for the page's flat answer object; the whole answer goes to Python as it is.
+pub fn json_field(text: &str, key: &str) -> Option<String> {
+    let at = text.find(&format!("\"{key}\""))?;
+    let rest = text[at + key.len() + 2..].trim_start().strip_prefix(':')?.trim_start();
+    if let Some(s) = rest.strip_prefix('"') {
+        let mut out = String::new();
+        let mut esc = false;
+        for c in s.chars() {
+            match (esc, c) {
+                (true, c) => { out.push(c); esc = false; }
+                (false, '\\') => esc = true,
+                (false, '"') => return Some(out),
+                (false, c) => out.push(c),
+            }
+        }
+        return None;
+    }
+    let end = rest.find([',', '}', '\n', '\r', ' ']).unwrap_or(rest.len());
+    Some(rest[..end].to_string())
+}
+
+fn fnv(text: &str) -> u32 {
+    text.bytes().fold(0x811C_9DC5u32, |h, b| (h ^ b as u32).wrapping_mul(0x0100_0193))
+}
+
+fn seed_ok(seed: &str) -> bool {
+    (1..=32).contains(&seed.len()) && seed.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
+
+/// what the frame hook asks of the program after a frame.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Pick {
+    /// no mode pick this frame
+    None,
+    /// the mode was picked; the page answers (interactive)
+    Page,
+    /// the mode was picked; this answer (None = Randomizer off) is taken at once
+    Answer(Option<String>),
+}
+
+impl Session {
+    /// after a frame: the mode pick, and what answers it.
+    pub fn frame(&mut self, g: &mut dyn Guest) -> Pick {
+        let loaded = self.since_slot_read.is_some_and(|n| n <= LOAD_WINDOW);
+        self.since_slot_read = self.since_slot_read.map(|n| n.saturating_add(1));
+        if !self.watch.after_frame(g) {
+            return Pick::None;
+        }
+        if loaded {
+            log::info!("fates_rando: the mode word changed in the frame a save was read: a load, not a new game");
+            return Pick::None;
+        }
+        if self.interactive {
+            self.pending = true;
+            return Pick::Page;
+        }
+        Pick::Answer(self.queued.take().or_else(|| {
+            let path = std::env::var_os("FEF_RANDO_ANSWER")?;
+            std::fs::read_to_string(&path)
+                .map_err(|e| log::warn!("fates_rando: FEF_RANDO_ANSWER {path:?} could not be read: {e}"))
+                .ok()
+        }))
+    }
+
+    /// the active run's id (None = the original game).
+    pub fn active(&self) -> Option<String> {
+        self.run.as_ref().filter(|r| r.gamedata_applied()).map(|r| r.id.clone())
+    }
+
+    /// the original game: the active run's GameData cells put back.
+    pub fn original(&mut self, g: &mut dyn Guest) {
+        self.placements.clear();
+        let Some(mut run) = self.run.take() else { return };
+        if let Err(bad) = run.revert_gamedata(g) {
+            self.note(format!("{}: the tables could not be put back ({} cells differ, first: {})",
+                              run.id, bad.len(), bad[0]));
+        }
+    }
+
+    fn note(&mut self, text: String) {
+        log::warn!("fates_rando: {text}");
+        self.notices.push(text);
+    }
+
+    /// lays a run already made (`<data>/rando/<title>/runs/<id>/patch.txt`): any other run
+    /// put back first, then every GameData cell checked and written (or nothing).
+    pub fn lay(&mut self, g: &mut dyn Guest, data: &Path, id: &str) -> Result<(), String> {
+        let path = run_dir(data, id).join("patch.txt");
+        let text = std::fs::read_to_string(&path).map_err(|e| format!("{}: {e}", path.display()))?;
+        let patch = Patch::parse(&text).map_err(|e| format!("{}: {e}", path.display()))?;
+        self.original(g);
+        let mut run = Run::new(patch, id);
+        match run.apply_gamedata(g) {
+            Ok(n) => log::info!("fates_rando: {id}: {n} GameData cells laid"),
+            Err(bad) => {
+                return Err(format!("the game's tables are not the original's ({} cells differ, first: {}); \
+                                    nothing was written (another mod or a PLAY RANDOMIZED profile?)",
+                                   bad.len(), bad[0]));
+            }
+        }
+        self.run = Some(run);
+        Ok(())
+    }
+
+    /// the page's answer. Ok(None) = the original game goes on; Ok(Some(id)) = the
+    /// randomized game `id` is laid; Err = nothing was written, and why. `make` makes a run
+    /// that is not made yet (Python: `make_run` in the program).
+    pub fn answer(&mut self, g: &mut dyn Guest, data: &Path, answer: &str,
+                  make: &mut dyn FnMut(&Path, &str, &str, &str) -> Result<PathBuf, String>)
+        -> Result<Option<String>, String>
+    {
+        self.pending = false;
+        if json_field(answer, "randomizer").as_deref() != Some("true") {
+            self.original(g);
+            return Ok(None);
+        }
+        let mut seed = json_field(answer, "seed").unwrap_or_default();
+        if seed.is_empty() {
+            seed = format!("r{:08x}", fnv(&format!("{:?}", std::time::SystemTime::now())));
+        }
+        if !seed_ok(&seed) {
+            return Err(format!("the seed {seed:?} is not 1-32 letters, digits, - or _"));
+        }
+        let id = run_id(&seed, answer);
+        if !run_dir(data, &id).join("patch.txt").is_file() {
+            make(data, &id, &seed, answer)?;
+        }
+        self.lay(g, data, &id)?;
+        Ok(Some(id))
+    }
+
+    /// the game opened save file `path` to read it: that save's run is laid, or the
+    /// original game put back, before the game parses a byte of it. Every open, not only
+    /// the first: the Load list may read every slot while the player browses.
+    ///
+    /// Only while no chapter is going on (`at_title`: GameConfigData's byte +0xB still 1,
+    /// as at the title and the mode pick; round 50, T1): a save menu inside the game may
+    /// read every slot's file to show it, and that must not change the tables of the game
+    /// being played. A load from the title reads the file before the game parses it, so
+    /// the byte is still 1 then; Restart Chapter reads the same game's save inside it.
+    pub fn save_read(&mut self, g: &mut dyn Guest, data: &Path, path: &str, at_title: bool) {
+        if fates_rando::slot_name(path).is_none() || !at_title {
+            return;
+        }
+        self.since_slot_read = Some(0);
+        // the game reads the save slots once at boot, before GameData is loaded (round 51,
+        // robot T5): there is nothing to lay or put back yet (GameData is then made from the
+        // original file), and a load reads its save again later
+        if fates_rando::gamedata_start(g).is_none() {
+            return;
+        }
+        let want = fates_rando::slot_run(data, path);
+        if want.is_some() && want == self.active() {
+            return;
+        }
+        match want {
+            None => self.original(g),
+            Some(id) => {
+                if let Err(e) = self.lay(g, data, &id) {
+                    self.original(g);
+                    self.note(format!("{path}: its randomized game {id} could not be laid, so it loads as the \
+                                       original game: {e}"));
+                }
+            }
+        }
+    }
+
+    /// the game wrote save file `path`: its side file names the active run, or is removed.
+    pub fn save_written(&mut self, data: &Path, path: &str) {
+        let run = self.active();
+        if let Err(e) = fates_rando::slot_written(data, path, run.as_deref()) {
+            self.note(format!("{path}: the randomizer side file could not be written: {e}"));
+        }
+    }
+
+    /// a save state of run `id` (None = the original) was loaded: memory already holds its
+    /// tables, so the run is only remembered (nothing written).
+    pub fn restore(&mut self, g: &mut dyn Guest, data: &Path, id: Option<&str>) {
+        self.placements.clear();
+        self.dispos_wait = None;
+        self.run = None;
+        let Some(id) = id else { return };
+        let path = run_dir(data, id).join("patch.txt");
+        match std::fs::read_to_string(&path).map_err(|e| e.to_string()).and_then(|t| Patch::parse(&t)) {
+            Ok(patch) => {
+                let mut r = Run::new(patch, id);
+                if let Some(base) = fates_rando::gamedata_start(g) {
+                    r.assume_applied(base);
+                }
+                self.run = Some(r);
+            }
+            Err(e) => self.note(format!("the state's randomized game {id} is missing ({e}); its tables stay as saved")),
+        }
+    }
+}
+
+// --------------------------------------------------------------------------- the program's calls
+
+/// placement extents follow the active run.
+fn refresh_placements(system: &mut System) {
+    let want = system.rando.run.as_ref().map(|r| placements(system, &r.patch)).unwrap_or_default();
+    system.rando.placements = want;
+}
+
+/// called by `System::run_frame` after every frame.
+pub fn after_frame(system: &mut System) {
+    if !is_fates(system) {
+        return;
+    }
+    match system.rando.frame(&mut system.memory) {
+        Pick::None | Pick::Page => {}
+        Pick::Answer(a) => {
+            log::info!("fates_rando: New Game mode picked at frame {}; answered {}", system.frames,
+                       if a.is_some() { "from the test hook" } else { "off" });
+            match answer(system, a.as_deref().unwrap_or("{\"randomizer\": false}")) {
+                Ok(Some(id)) => log::info!("fates_rando: randomized game {id} laid"),
+                Ok(None) => {}
+                Err(e) => notice(system, format!("the randomizer was not laid: {e}")),
+            }
+        }
+    }
+}
+
+/// true once, after the frame in which the mode was picked (interactive only): the page
+/// opens and the game waits for `answer`.
+pub fn take_pending(system: &mut System) -> bool {
+    std::mem::take(&mut system.rando.pending)
+}
+
+/// the answer boot-server's `rando-answer FILE` (or a test) gives the next mode pick.
+pub fn queue_answer(system: &mut System, answer: String) {
+    system.rando.queued = Some(answer);
+}
+
+/// the active run's id (None = the original game).
+pub fn active_run(system: &System) -> Option<String> {
+    system.rando.active()
+}
+
+pub fn notices(system: &System) -> Vec<String> {
+    let mut out = system.rando.notices.clone();
+    if let Some(run) = &system.rando.run {
+        out.extend(run.notices.iter().cloned());
+    }
+    out
+}
+
+/// the page's answer (JSON); see `Session::answer`. Python runs here when the run is not
+/// made yet (a few seconds, hidden).
+pub fn answer(system: &mut System, answer: &str) -> Result<Option<String>, String> {
+    let data = data_dir(system);
+    let r = system.rando.answer(&mut system.memory, &data, answer, &mut make_run);
+    refresh_placements(system);
+    r
+}
+
+/// lays a run already made (see `Session::lay`).
+pub fn lay_run(system: &mut System, id: &str) -> Result<(), String> {
+    let data = data_dir(system);
+    let r = system.rando.lay(&mut system.memory, &data, id);
+    refresh_placements(system);
+    r
+}
+
+/// the original game: any active run put back.
+pub fn go_original(system: &mut System) {
+    system.rando.original(&mut system.memory);
+}
+
+fn placements(system: &System, patch: &Patch) -> Vec<Placement> {
+    let Some(title) = system.title.as_ref() else { return Vec::new() };
+    // only the plain RomFS the game reads as "romfs:/"; with mods laid over it (a PLAY
+    // RANDOMIZED profile) the GameData guard has already refused
+    if title.layered.is_some() {
+        return Vec::new();
+    }
+    let Some(romfs) = title.romfs.as_ref() else { return Vec::new() };
+    let mut out = Vec::new();
+    for (i, f) in patch.files.iter().enumerate() {
+        if f.kind != fates_rando::Kind::Dispos {
+            continue;
+        }
+        match romfs.lookup(&f.rel) {
+            Ok(entry) => out.push(Placement {
+                file: i,
+                start: romfs.file_data_offset(&entry) - romfs.base,
+                len: entry.data_size,
+                served: None,
+                late: false,
+            }),
+            Err(e) => log::warn!("fates_rando: {}: not in the RomFS ({e})", f.rel),
+        }
+    }
+    out
+}
+
+// --------------------------------------------------------------------------- placement reads
+
+/// the part of a placement extent (`start`, `len`, its patched `bytes`) that a read of
+/// `data.len()` bytes from `offset` covers, laid over `data`.
+pub fn overlay(offset: u64, data: &mut [u8], start: u64, len: u64, bytes: &[u8]) {
+    let end = offset + data.len() as u64;
+    if start >= end || start + len <= offset {
+        return;
+    }
+    let from = start.max(offset);
+    let to = (start + len).min(end);
+    data[(from - offset) as usize..(to - offset) as usize]
+        .copy_from_slice(&bytes[(from - start) as usize..(to - start) as usize]);
+}
+
+/// a read of the game's RomFS (`romfs:/`, from `offset`) gets the patched bytes of every
+/// placement file of the active run it covers. Nothing at all without an active run.
+pub fn overlay_read(system: &mut System, path: &str, offset: u64, data: &mut [u8]) {
+    if system.rando.placements.is_empty() || path != "romfs:/" || data.is_empty() {
+        return;
+    }
+    let end = offset + data.len() as u64;
+    for k in 0..system.rando.placements.len() {
+        let (start, len) = (system.rando.placements[k].start, system.rando.placements[k].len);
+        if start >= end || start + len <= offset {
+            continue;
+        }
+        if system.rando.placements[k].served.is_none() {
+            let made = make_placement(system, k);
+            system.rando.placements[k].served = Some(made);
+        }
+        match system.rando.placements[k].served.clone() {
+            Some(Some(bytes)) => overlay(offset, data, start, len, &bytes),
+            // too big to hand over in the read: laid in memory at the next system call
+            // once the game has stored it (the data start at +20 changes)
+            _ if system.rando.placements[k].late && system.rando.dispos_wait.is_some() => {
+                // one wait at a time: a second file read while one waits keeps its
+                // original placements, and says so
+                let i = system.rando.placements[k].file;
+                let waiting = system.rando.dispos_wait.as_ref().map(|w| w.1);
+                if waiting != Some(i) {
+                    let rel = system.rando.run.as_ref().map(|r| r.patch.files[i].rel.clone()).unwrap_or_default();
+                    notice(system, format!("{rel}: placements kept original (read while another file waited to be laid)"));
+                    system.rando.placements[k].late = false;
+                }
+            }
+            _ if system.rando.placements[k].late && system.rando.dispos_wait.is_none() => {
+                let i = system.rando.placements[k].file;
+                let Some(name) = system.rando.run.as_ref().map(|r| fates_rando::stem(&r.patch.files[i].rel).to_string())
+                else { continue };
+                let before = fates_rando::dispos_now(&mut system.memory).map(|(_, b)| b);
+                system.rando.dispos_wait = Some((name, i, before, SVC_WAIT));
+            }
+            _ => {}
+        }
+    }
+}
+
+fn make_placement(system: &mut System, k: usize) -> Option<Arc<Vec<u8>>> {
+    let p = &system.rando.placements[k];
+    let run = system.rando.run.as_ref()?;
+    let f = run.patch.files.get(p.file)?.clone();
+    let title = system.title.as_ref()?;
+    let romfs = title.romfs.as_ref()?;
+    let at = (romfs.base + p.start) as usize;
+    let stored = title.shared_image().data().get(at..at + p.len as usize)?.to_vec();
+    match crate::fates_rando_file::patch_stored(&stored, &f) {
+        Ok(bytes) => {
+            log::info!("fates_rando: {} patched in the read ({} cells)", f.rel, f.values.len() + f.ptrs.len());
+            Some(Arc::new(bytes))
+        }
+        Err(bad) if bad.len() == 1 && bad[0].contains("does not fit") => {
+            log::info!("fates_rando: {}; laid in memory at the next system call after the game stores it", bad[0]);
+            system.rando.placements[k].late = true;
+            None
+        }
+        Err(bad) => {
+            notice(system, format!("{}: placements kept original ({} problems, first: {})", f.rel, bad.len(), bad[0]));
+            None
+        }
+    }
+}
+
+/// at every system call (kernel::svc::dispatch); nothing unless a placement file too big
+/// to patch in the read is waiting: once the placement object names it with a new data
+/// start, its cells are checked and laid in memory (round 50's in-memory apply).
+pub fn before_svc(system: &mut System) {
+    let Some((name, i, before, left)) = system.rando.dispos_wait.take() else { return };
+    let now = fates_rando::dispos_now(&mut system.memory);
+    let stored = matches!(&now, Some((n, b)) if n.eq_ignore_ascii_case(&name) && Some(*b) != before);
+    if !stored {
+        if left == 0 {
+            notice(system, format!("{name}: placements kept original (the game made no system call after storing the file)"));
+        } else {
+            system.rando.dispos_wait = Some((name, i, before, left - 1));
+        }
+        return;
+    }
+    let (_, base) = now.unwrap();
+    let Some(gd) = fates_rando::gamedata_start(&mut system.memory) else { return };
+    let Some(f) = system.rando.run.as_ref().and_then(|r| r.patch.files.get(i)).cloned() else { return };
+    match fates_rando::apply_file(&mut system.memory, &f, base, gd, false) {
+        Ok(n) => log::info!("fates_rando: {name}: {n} placement cells laid in memory at a system call after the read (frame {})", system.frames),
+        Err(bad) => notice(system, format!("{name}: placements kept original ({} cells differ, first: {})",
+                                           bad.len(), bad[0])),
+    }
+}
+
+// --------------------------------------------------------------------------- saves
+
+/// no chapter is going on: GameConfigData's byte +0xB is 1 (or GameConfigData is not made
+/// yet).
+pub fn at_title(g: &mut dyn Guest) -> bool {
+    let Some(cfg) = g.r32(fates_rando::GAME_CONFIG).filter(|&c| c != 0) else { return true };
+    let at = cfg.wrapping_add(0xB);
+    if !g.readable(at, 1) {
+        return true;
+    }
+    let mut b = [0u8; 1];
+    g.read(at, &mut b);
+    b[0] == 1
+}
+
+/// the game opened a save file to read it (file service): see `Session::save_read`.
+pub fn save_opened_for_read(system: &mut System, path: &str) {
+    if !is_fates(system) || fates_rando::slot_name(path).is_none() {
+        return;
+    }
+    let data = data_dir(system);
+    let before = system.rando.active();
+    let at_title = at_title(&mut system.memory);
+    system.rando.save_read(&mut system.memory, &data, path, at_title);
+    if system.rando.active() != before {
+        refresh_placements(system);
+    }
+}
+
+/// the game wrote a save file (closed after writing, or renamed onto its name).
+pub fn save_written(system: &mut System, path: &str) {
+    if !is_fates(system) || fates_rando::slot_name(path).is_none() {
+        return;
+    }
+    let data = data_dir(system);
+    system.rando.save_written(&data, path);
+}
+
+/// a write to an open file (file service).
+pub fn file_wrote(system: &mut System, file_id: u32) {
+    if is_fates(system) {
+        system.rando.written.insert(file_id);
+    }
+}
+
+/// a file closed (file service).
+pub fn file_closed(system: &mut System, file_id: u32, path: &str) {
+    if system.rando.written.remove(&file_id) {
+        save_written(system, path);
+    }
+}
