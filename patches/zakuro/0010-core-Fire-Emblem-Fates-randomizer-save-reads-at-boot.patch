+/// `<state file>.rando.json`
+pub fn sidecar_path(state: &Path) -> PathBuf {
+    let mut name = state.as_os_str().to_owned();
+    name.push(".rando.json");
+    PathBuf::from(name)
+}
+
+/// writes (run active) or removes (original game) the sidecar of a state file.
+pub fn write_sidecar(state: &Path, run: Option<&str>) -> std::io::Result<()> {
+    let side = sidecar_path(state);
+    match run {
+        Some(id) => {
+            let tmp = sidecar_path(&side);
+            let id = id.replace('\\', "\\\\").replace('"', "\\\"");
+            std::fs::write(&tmp, format!("{{\"format\": {}, \"run\": \"{id}\"}}\n", fates_rando::FORMAT))?;
+            std::fs::rename(&tmp, &side)
+        }
+        None => match std::fs::remove_file(&side) {
+            Err(e) if e.kind() != std::io::ErrorKind::NotFound => Err(e),
+            _ => Ok(()),
+        },
+    }
+}
+
+/// the run a state file's sidecar names (None = the original game, or no sidecar).
+pub fn read_sidecar(state: &Path) -> Option<String> {
+    std::fs::read_to_string(sidecar_path(state)).ok().and_then(|t| json_field(&t, "run"))
+}
+
+/// after a state file was saved.
+pub fn write_state_sidecar(system: &System, state: &Path) -> std::io::Result<()> {
+    if !is_fates(system) {
+        return Ok(());
+    }
+    write_sidecar(state, state_run(system).as_deref())
+}
+
+/// after a state file was loaded: the active run from its sidecar (none = original).
+pub fn read_state_sidecar(system: &mut System, state: &Path) {
+    let run = read_sidecar(state);
+    state_restore(system, run.as_deref());
+}
