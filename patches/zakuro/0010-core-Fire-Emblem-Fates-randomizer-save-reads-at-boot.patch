+    use crate::fates_rando::{GAMEDATA_ARCHIVE, GAME_CONFIG};
+    use std::collections::BTreeMap;
+
+    #[derive(Default, Clone, PartialEq, Debug)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+        writes: usize,
+    }
+
+    impl Fake {
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+        fn mem(&self) -> BTreeMap<u32, Vec<u8>> {
+            self.blocks.clone()
+        }
+        /// GameConfigData's byte +0xB (1 = no chapter going on)
+        fn set_title(&mut self, title: bool) {
+            self.blocks.get_mut(&0x2300_0000).unwrap()[0xB] = title as u8;
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, addr: u32, data: &[u8]) {
+            let (b, o) = self.find(addr, data.len() as u32).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + data.len()].copy_from_slice(data);
+            self.writes += 1;
+        }
+    }
+
+    const GD_FILE: u32 = 0x3000_0000;
+
+    /// GameData loaded (value 7 at +0x10 of its data), GameConfigData at the title
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        let mut gd = vec![0u8; 0x80];
+        gd[32 + 0x10] = 7;
+        m.blocks.insert(GD_FILE, gd);
+        let mut arch = vec![0u8; 8];
+        arch[4..8].copy_from_slice(&0x2000_0100u32.to_le_bytes());
+        m.blocks.insert(0x2000_0000, arch);
+        let mut x = vec![0u8; 120];
+        x[112..116].copy_from_slice(&GD_FILE.to_le_bytes());
+        m.blocks.insert(0x2000_0100, x);
+        m.blocks.insert(GAMEDATA_ARCHIVE, 0x2000_0000u32.to_le_bytes().to_vec());
+        let mut cfg = vec![0u8; 16];
+        cfg[4..8].copy_from_slice(&0x0001_1E5Eu32.to_le_bytes());
+        cfg[0xB] = 1;
+        m.blocks.insert(0x2300_0000, cfg);
+        m.blocks.insert(GAME_CONFIG, 0x2300_0000u32.to_le_bytes().to_vec());
+        m
+    }
+
+    fn gd_value(m: &Fake) -> u8 {
