+    #[test]
+    fn a_save_read_before_gamedata_is_loaded_does_nothing() {
+        let data = top("boot");
+        made(&data, "rA", 9);
+        fates_rando::slot_written(&data, "/Chapter0", Some("rA")).unwrap();
+        let mut m = game();
+        m.blocks.insert(GAMEDATA_ARCHIVE, 0u32.to_le_bytes().to_vec()); // not loaded yet
+        let mut s = Session::default();
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        assert_eq!((m.writes, s.active(), s.notices.len()), (0, None, 0));
+        // loaded: the next read of the same save lays its run
+        let mut m = game();
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        let _ = std::fs::remove_dir_all(&data);
+    }
