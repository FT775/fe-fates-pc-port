+// --------------------------------------------------------------------------- save states
+
+/// the run a save state made now belongs to.
+pub fn state_run(system: &System) -> Option<String> {
+    active_run(system)
+}
+
+/// a save state was loaded: see `Session::restore`.
+pub fn state_restore(system: &mut System, run: Option<&str>) {
+    if !is_fates(system) {
+        return;
+    }
+    let data = data_dir(system);
+    system.rando.restore(&mut system.memory, &data, run);
+    refresh_placements(system);
+}
