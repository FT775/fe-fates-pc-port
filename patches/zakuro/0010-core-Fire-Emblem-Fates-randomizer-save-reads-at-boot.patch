+    #[test]
+    fn every_save_read_lays_its_own_run_or_the_original() {
+        let data = top("load");
+        made(&data, "rA", 9);
+        made(&data, "rB", 11);
+        fates_rando::slot_written(&data, "/Chapter0", Some("rA")).unwrap();
+        fates_rando::slot_written(&data, "/Chapter2", Some("rB")).unwrap();
+        let mut m = game();
+        let original = m.mem();
+        let mut s = Session::default();
+        // browsing the Load list: every read lays that slot's run, the last read wins
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        s.save_read(&mut m, &data, "/Chapter1", true); // no side file: the original game
+        assert_eq!((gd_value(&m), s.active()), (7, None));
+        assert_eq!(m.blocks, original);
+        s.save_read(&mut m, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (11, Some("rB")));
+        s.save_read(&mut m, &data, "/Chapter0", true); // run to run: rB put back, rA laid
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        let writes = m.writes;
+        s.save_read(&mut m, &data, "/Chapter0", true); // the same run again: nothing written
+        assert_eq!(m.writes, writes);
+        // a battle save with its side file
+        fates_rando::slot_written(&data, "ext:/Map0.bak", Some("rB")).unwrap();
+        s.save_read(&mut m, &data, "/Map0.bak", true);
+        assert_eq!(s.active().as_deref(), Some("rB"));
+        // inside a chapter (a save menu reading the slots) nothing changes
+        m.set_title(false);
+        s.save_read(&mut m, &data, "/Chapter1", false);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (11, Some("rB")));
+        assert!(!at_title(&mut m));
+        m.set_title(true);
+        assert!(at_title(&mut m));
+        // files that are not slots are ignored
+        s.save_read(&mut m, &data, "/Global", true);
+        assert_eq!(s.active().as_deref(), Some("rB"));
+        // a side file whose run folder is gone: the original game, and a notice
+        fates_rando::slot_written(&data, "/Chapter1", Some("gone")).unwrap();
+        s.save_read(&mut m, &data, "/Chapter1", true);
+        assert_eq!((gd_value(&m), s.active()), (7, None));
+        assert!(s.notices.iter().any(|n| n.contains("gone")));
+        let _ = std::fs::remove_dir_all(&data);
+    }
