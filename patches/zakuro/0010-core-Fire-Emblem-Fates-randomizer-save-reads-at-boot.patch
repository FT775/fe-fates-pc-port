+    #[test]
+    fn side_files_round_trip_through_saves_and_states() {
+        let data = top("side");
+        made(&data, "rA", 9);
+        let mut m = game();
+        let mut s = Session::default();
+        s.lay(&mut m, &data, "rA").unwrap();
+        // the game writes slot 2 and its battle save: both name the run
+        s.save_written(&data, "/Chapter2");
+        s.save_written(&data, "/Map1.bak");
+        s.save_written(&data, "/Global");
+        assert_eq!(fates_rando::slot_run(&data, "/Chapter2").as_deref(), Some("rA"));
+        assert_eq!(fates_rando::slot_run(&data, "/Map1.bak").as_deref(), Some("rA"));
+        assert!(!fates_rando::slots_dir(&data).join("Global.json").exists());
+        // a fresh session reading slot 2 lays the same run
+        let mut m2 = game();
+        let mut s2 = Session::default();
+        s2.save_read(&mut m2, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m2), s2.active().as_deref()), (9, Some("rA")));
+        // the original game overwrites slot 2: its side file goes
+        s.original(&mut m);
+        s.save_written(&data, "/Chapter2");
+        assert_eq!(fates_rando::slot_run(&data, "/Chapter2"), None);
+        // a save state's sidecar
+        let state = data.join("state1.bin");
+        write_sidecar(&state, Some("rA")).unwrap();
+        assert_eq!(read_sidecar(&state).as_deref(), Some("rA"));
+        // loading that state: memory already holds rA's tables, so nothing is written
+        let mut m3 = m2.clone();
+        let writes = m3.writes;
+        let mut s3 = Session::default();
+        s3.restore(&mut m3, &data, read_sidecar(&state).as_deref());
+        assert_eq!((s3.active().as_deref(), m3.writes), (Some("rA"), writes));
+        // and a later load of an original save puts the tables back
+        s3.save_read(&mut m3, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m3), s3.active()), (7, None));
+        write_sidecar(&state, None).unwrap();
+        assert_eq!(read_sidecar(&state), None);
+        s3.restore(&mut m3, &data, None);
+        assert_eq!(s3.active(), None);
+        let _ = std::fs::remove_dir_all(&data);
+    }
