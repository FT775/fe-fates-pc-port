+    #[test]
+    fn a_mode_word_change_in_the_frame_a_save_is_read_is_a_load() {
+        let data = top("loadpick");
+        made(&data, "rA", 9);
+        fates_rando::slot_written(&data, "/Chapter0", Some("rA")).unwrap();
+        let mut m = game();
+        let mut s = Session::default();
+        s.frame(&mut m);
+        // a save made before the Prologue: the load reads it, and the mode word changes
+        // in the same frame with +0xB still 1
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        m.blocks.get_mut(&0x2300_0000).unwrap()[4..8].copy_from_slice(&0x4001_5EDEu32.to_le_bytes());
+        queue_answer_session(&mut s, r#"{"randomizer": false}"#);
+        assert_eq!(s.frame(&mut m), Pick::None);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        // a new game long after the Load list was browsed is still a new game
+        let mut m = game();
+        let mut s = Session::default();
+        s.frame(&mut m);
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        for _ in 0..30 {
+            s.frame(&mut m);
+        }
+        m.blocks.get_mut(&0x2300_0000).unwrap()[4..8].copy_from_slice(&0x4001_5EDEu32.to_le_bytes());
+        queue_answer_session(&mut s, r#"{"randomizer": false}"#);
+        assert!(matches!(s.frame(&mut m), Pick::Answer(Some(_))));
+        let _ = std::fs::remove_dir_all(&data);
+    }
