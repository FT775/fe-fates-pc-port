+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// the rows as `rando.py schema` printed them on 2026-11-20 (a few of each kind).
+    const SCHEMA: &str = r#"{"format": 1, "rows": [
+        {"key": "randomizer", "label": "Randomizer", "kind": "onoff", "default": false, "all": true},
+        {"key": "seed", "label": "Seed", "kind": "seed", "default": "", "pattern": "[A-Za-z0-9][A-Za-z0-9_-]{0,31}"},
+        {"key": "classes", "label": "Classes", "kind": "onoff", "default": true, "all": true, "flag": "--classes"},
+        {"key": "trees", "label": "Class trees (own side / any)", "kind": "choice", "choices": ["own", "any"], "default": "own", "all": "own", "flag": "--trees"},
+        {"key": "children", "label": "Children (not built)", "kind": "onoff", "default": false, "all": false, "fixed": true, "flag": "--children"},
+        {"key": "growth_mode", "label": "Growths mode", "indent": false, "default": "slice1", "all": "redistribute", "flag": "--growth-mode", "kind": "choice", "choices": ["slice1", "redistribute", "delta", "full"]},
+        {"key": "growth_variance", "label": "Growth variance %", "indent": true, "default": 30, "all": 30, "flag": "--growth-variance", "kind": "number", "min": 0, "max": 100},
+        {"key": "starting_items", "label": "Starting items", "indent": false, "default": false, "all": true, "flag": "--starting-items", "kind": "onoff"},
+        {"key": "enemy_classes", "label": "Enemy classes", "indent": false, "default": false, "all": true, "flag": "--enemy-classes", "kind": "onoff"}
+    ]}"#;
+
+    fn form() -> RandoForm {
+        RandoForm::new(parse_schema(SCHEMA).unwrap())
+    }
+
+    #[test]
+    fn python_is_started_with_no_window() {
+        assert_eq!(CREATE_NO_WINDOW, 0x0800_0000);
+        // every program this module starts goes through hidden(), which sets the flag
+        let source = include_str!("rando_page.rs");
+        let body = source.split("pub fn hidden(").nth(1).unwrap().split("\n}\n").next().unwrap();
+        assert!(body.contains("creation_flags(CREATE_NO_WINDOW)"));
+        assert!(body.contains("stdout(Stdio::piped())") && body.contains("stderr(Stdio::piped())"));
+        let spawns = source.matches(concat!("Comm", "and::new(")).count();
+        let hidden = source.matches(concat!("hidden(&mut Comm", "and::new(")).count();
+        assert_eq!(spawns, hidden, "a program started without hidden()");
+        assert_eq!(spawns, 1);
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn a_missing_program_is_a_plain_error() {
+        let error = run_hidden("zakuro-no-such-program-here", &[], Duration::from_secs(1)).unwrap_err();
+        assert!(error.contains("could not be started"));
+    }
+
+    #[test]
+    fn the_schema_is_read() {
+        let rows = parse_schema(SCHEMA).unwrap();
+        assert_eq!(rows.len(), 9);
+        assert_eq!(rows[3].kind, Kind::Choice(vec!["own".into(), "any".into()]));
+        assert_eq!(rows[6].kind, Kind::Number(0, 100));
+        assert!(rows[6].indent && rows[4].fixed);
+        assert!(parse_schema("{\"format\": 2, \"rows\": []}").is_err());
+        assert!(parse_schema("not json").is_err());
+        assert!(parse_schema("{\"format\": 1, \"rows\": [{\"key\": \"seed\", \"kind\": \"seed\", \"default\": \"\"}]}").is_err());
+    }
+
+    #[test]
+    fn defaults_are_randomizer_off() {
+        let mut form = form();
+        assert!(!form.on());
+        assert_eq!(form.seed(), "");
+        assert_eq!(form.get("classes"), &json!(true));
+        assert_eq!(form.get("growth_mode"), &json!("slice1"));
+        assert_eq!(form.get("starting_items"), &json!(false));
+        // off = the original game, nothing else said
+        assert_eq!(form.answers(), json!({"randomizer": false}));
+        assert_eq!(form.problem(), None);
+    }
+
+    #[test]
+    fn everything_on_is_the_suggested_values_and_keeps_the_seed() {
+        let mut form = form();
+        form.set("seed", json!("r51all"));
+        form.everything_on();
+        assert!(form.on());
+        assert_eq!(form.seed(), "r51all");
+        assert_eq!(form.get("growth_mode"), &json!("redistribute"));
+        assert_eq!(form.get("starting_items"), &json!(true));
+        assert_eq!(form.get("enemy_classes"), &json!(true));
+        assert_eq!(form.get("children"), &json!(false));
+        form.defaults();
+        assert_eq!(form, self::form());
+    }
+
+    #[test]
+    fn the_answers_hold_every_row() {
+        let mut form = form();
+        form.set("randomizer", json!(true));
+        form.set("seed", json!("abc-1_2"));
+        form.set("enemy_classes", json!(true));
+        form.set("growth_variance", json!(55));
+        let answers = form.answers();
+        assert_eq!(answers, json!({
+            "randomizer": true, "seed": "abc-1_2", "classes": true, "trees": "own", "children": false,
+            "growth_mode": "slice1", "growth_variance": 55, "starting_items": false, "enemy_classes": true
+        }));
+        let text = answers.to_string();
+        assert_eq!(serde_json::from_str::<Value>(&text).unwrap(), answers);
+        assert_eq!(RandoForm::changed(&answers, &form.rows), vec!["Growth variance %: 55", "Enemy classes: On"]);
+    }
+
+    #[test]
+    fn rows_take_only_values_that_fit() {
+        let mut form = form();
+        assert!(!form.set("children", json!(true)), "Children is not built");
+        assert!(!form.set("trees", json!("sideways")));
+        assert!(!form.set("growth_variance", json!(101)));
+        assert!(!form.set("classes", json!("yes")));
+        assert!(!form.set("nothing", json!(true)));
+        assert!(!form.set("seed", json!("-starts-badly")));
+        assert!(!form.set("seed", json!("x".repeat(33))));
+        assert!(form.set("seed", json!("x".repeat(32))));
+        assert!(form.set("seed", json!("")));
+        // placement rows are settable like the rest
+        assert!(form.set("starting_items", json!(true)) && form.set("enemy_classes", json!(true)));
+        assert_eq!(form.get("children"), &json!(false));
+    }
+
+    #[test]
+    fn an_empty_seed_is_made_at_start_and_shown() {
+        let mut form = form();
+        form.set("randomizer", json!(true));
+        let answers = form.answers();
+        let seed = answers["seed"].as_str().unwrap().to_owned();
+        assert!(seed_ok(&seed) && seed.len() == 8);
+        assert_eq!(form.seed(), seed);
+    }
+
+    #[test]
+    fn a_bad_typed_seed_stops_start() {
+        let mut form = form();
+        form.values.insert("seed".into(), json!("bad seed!"));
+        assert_eq!(form.problem(), None, "with Randomizer off the seed is not used");
+        form.set("randomizer", json!(true));
+        assert!(form.problem().is_some());
+    }
+
+    #[test]
+    fn last_choices_come_back_where_they_fit() {
+        let mut form = form();
+        form.restore(r#"{"randomizer": true, "seed": "kept", "trees": "any", "children": true, "growth_variance": 900, "gone": 1}"#);
+        assert!(form.on());
+        assert_eq!(form.seed(), "kept");
+        assert_eq!(form.get("trees"), &json!("any"));
+        assert_eq!(form.get("children"), &json!(false));
+        assert_eq!(form.get("growth_variance"), &json!(30));
+        form.restore("not json");
+        assert_eq!(form.seed(), "kept");
+    }
+
+    #[test]
+    fn the_page_waits_until_answered() {
+        let mut page = RandoPage::default();
+        page.rows = Rows::Missing("Python 3 was not found".into());
+        assert!(!page.over_game());
+        page.open_new_game();
+        assert!(page.over_game(), "the game waits while the page is open");
+        page.answered(Err("make failed".into()), None);
+        assert!(page.over_game() && page.failed);
+        page.answered(Ok(ThisRun::default()), None);
+        assert!(!page.over_game() && !page.failed);
+        assert_eq!(page.this_run.seed, None);
+    }
+
+    #[test]
+    fn this_run_lists_what_is_not_default() {
+        let mut page = RandoPage::default();
+        page.rows = Rows::Ready(Found { python: ("py".into(), vec![]), tool: PathBuf::new(), rows: parse_schema(SCHEMA).unwrap() });
+        let run = page.run_from(&json!({"randomizer": true, "seed": "s1", "classes": false, "trees": "own"}), None, vec![]);
+        assert_eq!(run.seed.as_deref(), Some("s1"));
+        assert_eq!(run.changed, vec!["Classes: Off"]);
+        assert_eq!(page.run_from(&json!({"randomizer": false}), None, vec![]).seed, None);
+    }
+
+    #[test]
+    fn the_page_draws_without_a_window() {
+        let ctx = egui::Context::default();
+        let mut page = RandoPage::default();
+        page.rows = Rows::Ready(Found { python: ("py".into(), vec![]), tool: PathBuf::new(), rows: parse_schema(SCHEMA).unwrap() });
+        page.form = Some(form());
+        page.open_new_game();
+        page.this_run_open = true;
+        let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, Vec2::new(800.0, 480.0));
+        for _ in 0..3 {
+            let input = egui::RawInput { screen_rect: Some(screen), ..Default::default() };
+            ctx.run_ui(input, |ui| {
+                assert!(page.draw_new_game(ui.ctx(), None).is_empty());
+                assert!(page.draw_this_run(ui.ctx()).is_empty());
+            })
+            .drop_without_applying_deltas();
+        }
+        let window = ctx.memory(|memory| memory.area_rect(egui::Id::new("rando new game"))).unwrap();
+        assert!(screen.contains_rect(window), "{window:?} in {screen:?}");
+    }
+
+    /// the port's own tool, through a real Python started hidden:
+    /// FEF_RANDO_TOOL=<repo>/tools/randomizer cargo test -p zakuro --lib -- --ignored real_tool
+    #[test]
+    #[ignore]
+    fn the_real_tool_gives_its_rows() {
+        let found = find().unwrap();
+        let keys: Vec<&str> = found.rows.iter().map(|row| row.key.as_str()).collect();
+        for key in ["randomizer", "seed", "classes", "growths", "join_stats", "trees", "keep_royals", "children",
+                    "growth_mode", "starting_items", "shops", "rewards", "enemy_weapons", "enemy_classes", "boss_classes"] {
+            assert!(keys.contains(&key), "{key} missing from {keys:?}");
+        }
+        let mut form = RandoForm::new(found.rows);
+        assert!(!form.on());
+        assert!(form.rows.iter().any(|row| row.fixed && row.key == "children"));
+        form.everything_on();
+        assert_eq!(form.get("starting_items"), &json!(true));
+        assert_eq!(form.get("enemy_classes"), &json!(true));
+    }
