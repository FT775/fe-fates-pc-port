diff --git a/crates/zakuro/src/rando_link.rs b/crates/zakuro/src/rando_link.rs
new file mode 100644
index 0000000..1e34383
--- /dev/null
+++ b/crates/zakuro/src/rando_link.rs
@@ -0,0 +1,124 @@
+//! The one place the Randomizer page (rando_page.rs) meets zakuro-core's `fates_rando`.
+//!
+//! What the page needs of the core (docs/RANDOMIZER_INGAME.md, round 51), by the design's
+//! names:
+//!
+//! - a **pending new game**: the core's own after-frame hook (in `System::run_frame`, so
+//!   headless runs and boot-server have it too) saw the mode pick and now waits for an
+//!   answer; headless, it answers by itself from `FEF_RANDO_ANSWER` or "off";
+//! - **answer(answers JSON)**: `{"randomizer": false}` lets the game go on as the
+//!   original; with Randomizer on the core runs `rando.py make --patch-out` hidden,
+//!   checks every cell and lays it (or nothing), and names the run;
+//! - the **active run** (its id, `<data>/rando/<title>/runs/<id>/`), and its notices.
+//!
+//! The core (patch 0008, `zakuro_core::fates_rando_session`) has these calls; this file
+//! only forwards to them, so the page and the core share one data folder (the program's
+//! `--data`, given to the core as `config.data_dir`), one run folder and one state sidecar
+//! writer.
+
+use std::path::Path;
+
+use zakuro_core::System;
+use zakuro_core::fates_rando_session as core;
+
+use crate::rando_page::FATES;
+
+/// whether the game running is Fire Emblem Fates.
+pub fn is_fates(system: &System) -> bool {
+    system.title.as_ref().is_some_and(|title| title.program_id() == FATES)
+}
+
+/// true once, in the frame the core saw the New Game mode pick and began waiting for the
+/// page's answer.
+pub fn take_pending(system: &mut System) -> bool {
+    core::take_pending(system)
+}
+
+/// the program has a window: the mode pick waits for the page (headless runs leave this
+/// off, and the core answers by itself from `FEF_RANDO_ANSWER` or "off").
+pub fn set_interactive(system: &mut System, interactive: bool) {
+    system.rando.interactive = interactive;
+}
+
+/// whether the answers ask for a randomized game (anything unreadable = the original).
+#[cfg_attr(not(test), allow(dead_code))]
+pub fn randomizer_on(answers: &str) -> bool {
+    serde_json::from_str::<serde_json::Value>(answers).ok().and_then(|value| value.get("randomizer")?.as_bool()).unwrap_or(false)
+}
+
+/// gives the core the page's answers. Ok(None) = the original game goes on; Ok(Some(id))
+/// = the randomized game `id` was laid; Err = nothing was written, and why.
+pub fn answer(system: &mut System, answers: &str) -> Result<Option<String>, String> {
+    core::answer(system, answers)
+}
+
+/// the randomized game in memory now (None = the original game).
+pub fn active_run(system: &System) -> Option<String> {
+    core::active_run(system)
+}
+
+/// what the core has to say about the active run (a chapter's placements kept original,
+/// a guard that failed).
+pub fn notices(system: &System) -> Vec<String> {
+    core::notices(system)
+}
+
+/// `<state>.rando.json`, the randomized game a Zakuro save state holds (the core's name).
+pub fn state_sidecar(state: &Path) -> std::path::PathBuf {
+    core::sidecar_path(state)
+}
+
+/// a save state was written: the run in it goes beside it; with none, nothing is left
+/// beside it (that state is the original game). The core writes it.
+pub fn state_saved(system: &System, state: &Path) {
+    if let Err(error) = core::write_state_sidecar(system, state) {
+        log::warn!(target: "zakuro::rando", "{}: {error}", state_sidecar(state).display());
+    }
+}
+
+/// the run a save state names, None = the original game.
+pub fn state_run(state: &Path) -> Option<String> {
+    core::read_sidecar(state)
+}
+
+/// a save state was loaded: the core takes the state's run (its patch and placements;
+/// the memory already holds that game's tables, so no table is written).
+pub fn state_loaded(system: &mut System, state: &Path) {
+    if let Some(id) = state_run(state) {
+        log::info!(target: "zakuro::rando", "the state holds the randomized game {id}");
+    }
+    core::read_state_sidecar(system, state);
+}
+
+/// the answers a run was made from: `<data>/rando/<title>/runs/<id>/options.json`.
+pub fn run_answers(data: &Path, run: &str) -> Option<serde_json::Value> {
+    let text = std::fs::read_to_string(core::run_dir(data, run).join("options.json")).ok()?;
+    let mut answers: serde_json::Value = serde_json::from_str(&text).ok()?;
+    // a run is a randomized game, whatever its file says of the switch
+    answers.as_object_mut()?.insert("randomizer".into(), serde_json::Value::Bool(true));
+    Some(answers)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_states_run_is_kept_beside_it() {
+        let dir = std::env::temp_dir().join(format!("zakuro-rando-link-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let state = dir.join("1.state");
+        assert_eq!(state_sidecar(&state), dir.join("1.state.rando.json"));
+        assert_eq!(state_run(&state), None);
+        std::fs::write(state_sidecar(&state), r#"{"format": 1, "run": "r51-0a1b2c3d"}"#).unwrap();
+        assert_eq!(state_run(&state).as_deref(), Some("r51-0a1b2c3d"));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn an_answer_with_randomizer_off_is_the_original_game() {
+        assert!(!randomizer_on(r#"{"randomizer": false}"#));
+        assert!(!randomizer_on("garbage") && !randomizer_on(r#"{"seed": "x"}"#));
+        assert!(randomizer_on(r#"{"randomizer": true, "seed": "x"}"#));
+    }
+}
