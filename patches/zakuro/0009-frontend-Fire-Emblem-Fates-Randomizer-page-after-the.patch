--- /dev/null
+++ b/crates/zakuro/src/rando_page.rs
@@ -0,0 +1,937 @@
+//! Fire Emblem Fates: the Randomizer page (docs/RANDOMIZER_INGAME.md sections 2, 5 and 6).
+//!
+//! It opens by itself, pausing the game like the menu over it, in the frame the core says
+//! the New Game mode (Casual / Classic / Phoenix) was picked, and shows every row of the
+//! port's randomizer (`tools/randomizer/rando.py schema`: one list, the same as PLAY
+//! RANDOMIZED's). **Start game** hands the core the answers as JSON
+//! (`{"randomizer": bool, "seed": "...", key: value, ...}`); the core makes the game from
+//! them (`rando.py make --patch-out`) and lays it, or does nothing with Randomizer off.
+//! The menu's **Randomizer** shows what the game playing now was started with.
+//!
+//! Python is started only hidden: on Windows with CREATE_NO_WINDOW, its output read
+//! through pipes into zakuro.log, never a console window. Without Python or the tool the
+//! page says so in one line and the game goes on as the original.
+//!
+//! The form ([`RandoForm`]) is a plain model, apart from its drawing, so it is tested
+//! without a window.
+
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::mpsc::{channel, Receiver, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::{Color32, RichText, Vec2};
+use serde_json::{json, Map, Value};
+
+/// Fire Emblem Fates (USA), the one game the page is for.
+pub const FATES: u64 = 0x0004_0000_0017_9800;
+
+/// Windows' process creation flag that starts a console program with no window.
+pub const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+/// how long Python may take to answer `--version` and `schema`.
+const ANSWER_WITHIN: Duration = Duration::from_secs(5);
+
+/// a command that opens no window: CREATE_NO_WINDOW on Windows, nothing typed in, its
+/// output piped (read by [`run_hidden`], which writes it to the log). Every program this
+/// module starts goes through here.
+pub fn hidden(command: &mut Command) -> &mut Command {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(CREATE_NO_WINDOW);
+    }
+    command.stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped())
+}
+
+/// runs a program hidden and gives its output, or why it gave none. What it writes to
+/// its error output goes to zakuro.log. A program still running after `within` is
+/// stopped.
+pub fn run_hidden(program: &str, args: &[String], within: Duration) -> Result<String, String> {
+    let mut child = hidden(&mut Command::new(program))
+        .args(args)
+        .spawn()
+        .map_err(|error| format!("{program} could not be started: {error}"))?;
+    let mut out = child.stdout.take();
+    let mut err = child.stderr.take();
+    let out = std::thread::spawn(move || {
+        let mut text = String::new();
+        if let Some(out) = out.as_mut() {
+            let _ = out.read_to_string(&mut text);
+        }
+        text
+    });
+    let err = std::thread::spawn(move || {
+        let mut text = String::new();
+        if let Some(err) = err.as_mut() {
+            let _ = err.read_to_string(&mut text);
+        }
+        text
+    });
+    let start = Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if start.elapsed() < within => std::thread::sleep(Duration::from_millis(20)),
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                break None;
+            }
+        }
+    };
+    let text = out.join().unwrap_or_default();
+    for line in err.join().unwrap_or_default().lines().filter(|line| !line.trim().is_empty()) {
+        log::info!(target: "zakuro::rando", "{program}: {line}");
+    }
+    match status {
+        None => Err(format!("{program} did not answer within {} s", within.as_secs())),
+        Some(status) if status.success() => Ok(text),
+        Some(status) => Err(format!("{program} stopped with {status}")),
+    }
+}
+
+/// the Pythons to try, in order: FEF_PYTHON, then `py -3`, then `python`.
+pub fn pythons() -> Vec<(String, Vec<String>)> {
+    let mut out = Vec::new();
+    if let Some(own) = std::env::var_os("FEF_PYTHON").filter(|value| !value.is_empty()) {
+        out.push((own.to_string_lossy().into_owned(), vec![]));
+    }
+    out.push(("py".to_owned(), vec!["-3".to_owned()]));
+    out.push(("python".to_owned(), vec![]));
+    out
+}
+
+/// the port's randomizer, `tools/randomizer/rando.py`: FEF_RANDO_TOOL (the folder or the
+/// file), else next to the program (`play/game/../../tools/randomizer`) or a few folders
+/// above it.
+pub fn tool() -> Option<PathBuf> {
+    if let Some(own) = std::env::var_os("FEF_RANDO_TOOL").filter(|value| !value.is_empty()) {
+        let own = PathBuf::from(own);
+        let file = if own.is_dir() { own.join("rando.py") } else { own };
+        return file.is_file().then_some(file);
+    }
+    let exe = std::env::current_exe().ok()?;
+    exe.ancestors().skip(1).take(6).map(|dir| dir.join("tools").join("randomizer").join("rando.py")).find(|file| file.is_file())
+}
+
+/// a Python that runs, and the rows the randomizer's page has.
+#[derive(Debug, Clone)]
+pub struct Found {
+    pub python: (String, Vec<String>),
+    pub tool: PathBuf,
+    pub rows: Vec<Row>,
+}
+
+/// finds Python and asks the randomizer for its rows, each answer within 5 s, hidden.
+pub fn find() -> Result<Found, String> {
+    let tool = tool().ok_or("The randomizer (tools/randomizer) was not found next to the program; the game plays as the original.")?;
+    let mut any_python = false;
+    let mut last = String::new();
+    for (program, prefix) in pythons() {
+        let mut version = prefix.clone();
+        version.push("--version".to_owned());
+        match run_hidden(&program, &version, ANSWER_WITHIN) {
+            Ok(_) => any_python = true,
+            Err(_) => continue,
+        }
+        let mut args = prefix.clone();
+        args.push(tool.to_string_lossy().into_owned());
+        args.push("schema".to_owned());
+        match run_hidden(&program, &args, ANSWER_WITHIN).and_then(|text| parse_schema(&text)) {
+            Ok(rows) => return Ok(Found { python: (program, prefix), tool, rows }),
+            Err(error) => last = error,
+        }
+    }
+    if any_python {
+        Err(format!("The randomizer did not give its settings ({last}); the game plays as the original."))
+    } else {
+        Err("Python 3 was not found; the randomizer needs it. The game plays as the original.".to_owned())
+    }
+}
+
+// ---------------------------------------------------------------------------- the rows
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Kind {
+    OnOff,
+    Seed,
+    Choice(Vec<String>),
+    Number(i64, i64),
+}
+
+/// one row of the page, as `rando.py schema` gives it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Row {
+    pub key: String,
+    pub label: String,
+    pub kind: Kind,
+    pub default: Value,
+    /// the value "Everything on" gives.
+    pub all: Value,
+    /// shown greyed, always its default (Children: not built).
+    pub fixed: bool,
+    pub indent: bool,
+}
+
+/// `rando.py schema`'s JSON -> the rows (format 1).
+pub fn parse_schema(text: &str) -> Result<Vec<Row>, String> {
+    let root: Value = serde_json::from_str(text.trim()).map_err(|error| format!("its settings are not JSON: {error}"))?;
+    if root.get("format").and_then(Value::as_u64) != Some(1) {
+        return Err("its settings are of another format".to_owned());
+    }
+    let rows = root.get("rows").and_then(Value::as_array).ok_or("its settings have no rows")?;
+    let mut out = Vec::new();
+    for row in rows {
+        let text = |name: &str| row.get(name).and_then(Value::as_str).map(str::to_owned);
+        let key = text("key").ok_or("a row has no key")?;
+        let kind = match text("kind").as_deref() {
+            Some("onoff") => Kind::OnOff,
+            Some("seed") => Kind::Seed,
+            Some("choice") => Kind::Choice(
+                row.get("choices").and_then(Value::as_array).ok_or(format!("{key}: no choices"))?
+                    .iter().filter_map(|choice| choice.as_str().map(str::to_owned)).collect(),
+            ),
+            Some("number") => Kind::Number(
+                row.get("min").and_then(Value::as_i64).ok_or(format!("{key}: no min"))?,
+                row.get("max").and_then(Value::as_i64).ok_or(format!("{key}: no max"))?,
+            ),
+            other => return Err(format!("{key}: unknown kind {other:?}")),
+        };
+        let default = row.get("default").cloned().ok_or(format!("{key}: no default"))?;
+        out.push(Row {
+            label: text("label").unwrap_or_else(|| key.clone()),
+            all: row.get("all").cloned().unwrap_or_else(|| default.clone()),
+            fixed: row.get("fixed").and_then(Value::as_bool).unwrap_or(false),
+            indent: row.get("indent").and_then(Value::as_bool).unwrap_or(false),
+            key,
+            kind,
+            default,
+        });
+    }
+    if !out.iter().any(|row| row.key == "randomizer") || !out.iter().any(|row| row.key == "seed") {
+        return Err("its settings lack Randomizer or Seed".to_owned());
+    }
+    Ok(out)
+}
+
+/// a seed the randomizer takes: 1 to 32 letters, digits, '-' and '_', starting with a
+/// letter or digit (PLAY RANDOMIZED's SEED_RX).
+pub fn seed_ok(seed: &str) -> bool {
+    let mut chars = seed.chars();
+    matches!(chars.next(), Some(c) if c.is_ascii_alphanumeric())
+        && seed.len() <= 32
+        && chars.all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+}
+
+/// a new seed, 8 letters and digits, different each time.
+pub fn random_seed() -> String {
+    use std::hash::{BuildHasher, Hasher};
+    let mut hasher = std::collections::hash_map::RandomState::new().build_hasher();
+    hasher.write_u128(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |time| time.as_nanos()));
+    let mut n = hasher.finish();
+    const LETTERS: &[u8] = b"abcdefghijkmnpqrstuvwxyz23456789";
+    (0..8).map(|_| { let c = LETTERS[(n % 32) as usize] as char; n /= 32; c }).collect()
+}
+
+// ---------------------------------------------------------------------------- the form
+
+/// the page's values, apart from its drawing.
+#[derive(Debug, Clone, PartialEq)]
+pub struct RandoForm {
+    pub rows: Vec<Row>,
+    pub values: Map<String, Value>,
+}
+
+impl RandoForm {
+    /// every row at its default: Randomizer off.
+    pub fn new(rows: Vec<Row>) -> RandoForm {
+        let mut form = RandoForm { rows, values: Map::new() };
+        form.defaults();
+        form
+    }
+
+    pub fn defaults(&mut self) {
+        self.values = self.rows.iter().map(|row| (row.key.clone(), row.default.clone())).collect();
+    }
+
+    /// "Everything on": the suggested values, Randomizer on; the seed is kept.
+    pub fn everything_on(&mut self) {
+        let seed = self.get("seed").clone();
+        for row in &self.rows {
+            let value = if row.fixed { row.default.clone() } else { row.all.clone() };
+            self.values.insert(row.key.clone(), value);
+        }
+        self.values.insert("seed".into(), seed);
+        self.values.insert("randomizer".into(), Value::Bool(true));
+    }
+
+    pub fn get(&self, key: &str) -> &Value {
+        self.values.get(key).unwrap_or(&Value::Null)
+    }
+
+    pub fn on(&self) -> bool {
+        self.get("randomizer").as_bool().unwrap_or(false)
+    }
+
+    pub fn seed(&self) -> &str {
+        self.get("seed").as_str().unwrap_or("")
+    }
+
+    /// sets a row, when the value fits it (a fixed row keeps its default).
+    pub fn set(&mut self, key: &str, value: Value) -> bool {
+        let Some(row) = self.rows.iter().find(|row| row.key == key) else { return false };
+        let fits = match (&row.kind, &value) {
+            _ if row.fixed => false,
+            (Kind::OnOff, Value::Bool(_)) => true,
+            (Kind::Seed, Value::String(seed)) => seed.is_empty() || seed_ok(seed),
+            (Kind::Choice(choices), Value::String(choice)) => choices.contains(choice),
+            (Kind::Number(min, max), Value::Number(n)) => n.as_i64().is_some_and(|n| (*min..=*max).contains(&n)),
+            _ => false,
+        };
+        if fits {
+            self.values.insert(key.to_owned(), value);
+        }
+        fits
+    }
+
+    /// what is wrong with the form, for Start game; None when it can start.
+    pub fn problem(&self) -> Option<String> {
+        let seed = self.seed();
+        (self.on() && !seed.is_empty() && !seed_ok(seed))
+            .then(|| "The seed takes 1 to 32 letters, digits, - and _, starting with a letter or digit.".to_owned())
+    }
+
+    /// the answers the core is given at Start game. With Randomizer off it is
+    /// {"randomizer": false} and nothing else; with it on, every row, the fixed ones at
+    /// their defaults, and a new seed made when none was typed (and shown in the form).
+    pub fn answers(&mut self) -> Value {
+        if !self.on() {
+            return json!({"randomizer": false});
+        }
+        if self.seed().is_empty() {
+            self.values.insert("seed".into(), Value::String(random_seed()));
+        }
+        let mut out = Map::new();
+        for row in &self.rows {
+            let value = if row.fixed { row.default.clone() } else { self.get(&row.key).clone() };
+            out.insert(row.key.clone(), value);
+        }
+        Value::Object(out)
+    }
+
+    /// the rows not at their default, as "label: value", for This run.
+    pub fn changed(answers: &Value, rows: &[Row]) -> Vec<String> {
+        rows.iter()
+            .filter(|row| row.key != "randomizer" && row.key != "seed")
+            .filter_map(|row| {
+                let value = answers.get(&row.key)?;
+                (value != &row.default).then(|| format!("{}: {}", row.label, shown(value)))
+            })
+            .collect()
+    }
+
+    /// last choices, from `<data>/rando/last.json`, laid over the defaults (rows that
+    /// no longer fit are left at their default).
+    pub fn restore(&mut self, text: &str) {
+        let Ok(Value::Object(last)) = serde_json::from_str::<Value>(text) else { return };
+        for (key, value) in last {
+            self.set(&key, value);
+        }
+    }
+}
+
+fn shown(value: &Value) -> String {
+    match value {
+        Value::Bool(true) => "On".into(),
+        Value::Bool(false) => "Off".into(),
+        Value::String(text) => text.clone(),
+        other => other.to_string(),
+    }
+}
+
+/// `<data>/rando/last.json`, the page's last choices.
+pub fn last_path(data: &Path) -> PathBuf {
+    data.join("rando").join("last.json")
+}
+
+/// `<data>/rando/<title>/runs/<run>/`, what the core keeps of a randomized game (the
+/// core's own folder, one definition).
+pub fn run_dir(data: &Path, run: &str) -> PathBuf {
+    zakuro_core::fates_rando_session::run_dir(data, run)
+}
+
+// ---------------------------------------------------------------------------- the page
+
+/// what the page asks of the program.
+#[derive(Debug, Clone, PartialEq)]
+pub enum PageAction {
+    /// give the core these answers (Start game, or Play the original game).
+    Answer(String),
+    /// show the spoiler log of the game playing now.
+    Spoiler(PathBuf),
+}
+
+enum Rows {
+    /// not asked yet (no Fates game started).
+    Unasked,
+    Asking(Receiver<Result<Found, String>>),
+    Ready(Found),
+    Missing(String),
+}
+
+/// the game playing now, as This run shows it.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct ThisRun {
+    /// None = the original game.
+    pub seed: Option<String>,
+    pub changed: Vec<String>,
+    pub spoiler: Option<PathBuf>,
+    /// the core's notices (a chapter's placements kept original, a guard failed, ...).
+    pub notices: Vec<String>,
+}
+
+pub struct RandoPage {
+    rows: Rows,
+    form: Option<RandoForm>,
+    /// the New Game page is open: the core waits for its answer.
+    pub new_game: bool,
+    /// the menu's Randomizer window is open.
+    pub this_run_open: bool,
+    /// what the page says now (making the game, or why it could not).
+    pub status: Option<String>,
+    /// the core failed to make or lay the game: Back to the settings / Play the original game.
+    pub failed: bool,
+    /// the answer was drawn as "making" for a frame and is to be given now.
+    pending_answer: Option<String>,
+    pub this_run: ThisRun,
+    /// the run (and how many notices) This run was last read for, while it is open.
+    pub shown_for: Option<(Option<String>, usize)>,
+}
+
+impl Default for RandoPage {
+    fn default() -> Self {
+        RandoPage {
+            rows: Rows::Unasked,
+            form: None,
+            new_game: false,
+            this_run_open: false,
+            status: None,
+            failed: false,
+            pending_answer: None,
+            this_run: ThisRun::default(),
+            shown_for: None,
+        }
+    }
+}
+
+impl RandoPage {
+    pub fn over_game(&self) -> bool {
+        self.new_game
+    }
+
+    /// a game (re)started: nothing open, the original game; the rows read, kept.
+    pub fn reset(&mut self) {
+        self.new_game = false;
+        self.this_run_open = false;
+        self.status = None;
+        self.failed = false;
+        self.pending_answer = None;
+        self.this_run = ThisRun::default();
+        self.shown_for = None;
+    }
+
+    /// asks the randomizer for its rows, in a thread, once (a Fates game started).
+    pub fn ask(&mut self) {
+        if matches!(self.rows, Rows::Unasked) {
+            let (send, receive) = channel();
+            std::thread::spawn(move || {
+                let _ = send.send(find());
+            });
+            self.rows = Rows::Asking(receive);
+        }
+    }
+
+    fn poll(&mut self, data: Option<&Path>) {
+        if let Rows::Asking(receive) = &self.rows {
+            match receive.try_recv() {
+                Ok(Ok(found)) => {
+                    log::info!(target: "zakuro::rando", "the randomizer page has {} rows ({} via {})", found.rows.len(), found.tool.display(), found.python.0);
+                    let mut form = RandoForm::new(found.rows.clone());
+                    if let Some(text) = data.and_then(|data| std::fs::read_to_string(last_path(data)).ok()) {
+                        form.restore(&text);
+                    }
+                    self.form = Some(form);
+                    self.rows = Rows::Ready(found);
+                }
+                Ok(Err(why)) => {
+                    log::warn!(target: "zakuro::rando", "{why}");
+                    self.rows = Rows::Missing(why);
+                }
+                Err(TryRecvError::Empty) => {}
+                Err(TryRecvError::Disconnected) => self.rows = Rows::Missing("The randomizer could not be asked; the game plays as the original.".into()),
+            }
+        }
+    }
+
+    /// the core picked up the mode pick: open the page (the game waits).
+    pub fn open_new_game(&mut self) {
+        self.ask();
+        self.new_game = true;
+        self.status = None;
+        self.failed = false;
+        self.pending_answer = None;
+    }
+
+    /// the answer to give the core this frame, after "making" was shown for one.
+    pub fn take_answer(&mut self) -> Option<String> {
+        self.pending_answer.take()
+    }
+
+    /// the core's reply to an answer: Ok closes the page (the game goes on), Err keeps it
+    /// open with the reason and Back to the settings / Play the original game.
+    pub fn answered(&mut self, result: Result<ThisRun, String>, data: Option<&Path>) {
+        match result {
+            Ok(run) => {
+                if let (Some(data), Some(form)) = (data, &self.form) {
+                    // kept only for a randomized game: an original one writes nothing
+                    if run.seed.is_some() {
+                        let path = last_path(data);
+                        let text = serde_json::to_string_pretty(&Value::Object(form.values.clone())).unwrap_or_default();
+                        if let Err(error) = path.parent().map_or(Ok(()), std::fs::create_dir_all).and_then(|()| std::fs::write(&path, text)) {
+                            log::warn!(target: "zakuro::rando", "{} could not be written: {error}", path.display());
+                        }
+                    }
+                }
+                self.this_run = run;
+                self.new_game = false;
+                self.status = None;
+                self.failed = false;
+            }
+            Err(why) => {
+                self.status = Some(why);
+                self.failed = true;
+            }
+        }
+    }
+
+    /// This run for a randomized game: the seed, the rows not at their default and the
+    /// spoiler log, from the answers the core was given or a run's options.json.
+    pub fn run_from(&self, answers: &Value, spoiler: Option<PathBuf>, notices: Vec<String>) -> ThisRun {
+        if !answers.get("randomizer").and_then(Value::as_bool).unwrap_or(false) {
+            return ThisRun { notices, ..ThisRun::default() };
+        }
+        let rows = match &self.rows {
+            Rows::Ready(found) => found.rows.as_slice(),
+            _ => &[],
+        };
+        ThisRun {
+            seed: answers.get("seed").and_then(Value::as_str).map(str::to_owned),
+            changed: RandoForm::changed(answers, rows),
+            spoiler: spoiler.filter(|path| path.is_file()),
+            notices,
+        }
+    }
+
+    /// the New Game page, while open.
+    pub fn draw_new_game(&mut self, ctx: &egui::Context, data: Option<&Path>) -> Vec<PageAction> {
+        let mut actions = Vec::new();
+        self.poll(data);
+        if !self.new_game {
+            return actions;
+        }
+        let height = (ctx.content_rect().height() - 140.0).max(120.0);
+        egui::Window::new("Randomizer")
+            .id(egui::Id::new("rando new game"))
+            .collapsible(false)
+            .resizable(false)
+            .anchor(egui::Align2::CENTER_CENTER, Vec2::ZERO)
+            .show(ctx, |ui| {
+                ui.label(RichText::new("New game: randomize it?").strong());
+                if let Some(status) = &self.status {
+                    ui.label(RichText::new(status).color(if self.failed { Color32::LIGHT_RED } else { Color32::LIGHT_GREEN }));
+                    if self.failed {
+                        ui.horizontal(|ui| {
+                            if ui.button("Back to the settings").clicked() {
+                                self.status = None;
+                                self.failed = false;
+                            }
+                            if ui.button("Play the original game").clicked() {
+                                actions.push(PageAction::Answer(json!({"randomizer": false}).to_string()));
+                            }
+                        });
+                    }
+                    if !self.failed {
+                        ctx.request_repaint();
+                        return;
+                    }
+                    ui.separator();
+                }
+                match (&self.rows, &mut self.form) {
+                    (Rows::Ready(_), Some(form)) => {
+                        egui::ScrollArea::vertical().max_height(height).show(ui, |ui| rows(ui, form));
+                        ui.separator();
+                        ui.horizontal(|ui| {
+                            if ui.button("Everything on").clicked() {
+                                form.everything_on();
+                            }
+                            if ui.button("Defaults").clicked() {
+                                form.defaults();
+                            }
+                            let problem = form.problem();
+                            let start = ui.add_enabled(problem.is_none() && !self.failed, egui::Button::new(RichText::new("Start game").strong()));
+                            if start.clicked() {
+                                let answers = form.answers();
+                                if form.on() {
+                                    self.status = Some(format!("Making the game from seed {}... (a few seconds)", form.seed()));
+                                    self.failed = false;
+                                    // drawn once, then given to the core next frame
+                                    self.pending_answer = Some(answers.to_string());
+                                } else {
+                                    actions.push(PageAction::Answer(answers.to_string()));
+                                }
+                            }
+                            if let Some(problem) = problem {
+                                ui.label(RichText::new(problem).color(Color32::LIGHT_RED));
+                            }
+                        });
+                    }
+                    (Rows::Missing(why), _) => {
+                        ui.label(RichText::new(why).weak());
+                        if ui.button("Start game").clicked() {
+                            actions.push(PageAction::Answer(json!({"randomizer": false}).to_string()));
+                        }
+                    }
+                    _ => {
+                        ui.label(RichText::new("Asking the randomizer for its settings...").weak());
+                        ctx.request_repaint();
+                        if ui.button("Play the original game").clicked() {
+                            actions.push(PageAction::Answer(json!({"randomizer": false}).to_string()));
+                        }
+                    }
+                }
+            });
+        actions
+    }
+
+    /// the menu's Randomizer window, when open: This run, read only.
+    pub fn draw_this_run(&mut self, ctx: &egui::Context) -> Vec<PageAction> {
+        let mut actions = Vec::new();
+        let mut open = self.this_run_open;
+        egui::Window::new("Randomizer").id(egui::Id::new("rando this run")).open(&mut open).default_width(360.0).show(ctx, |ui| {
+            ui.label(RichText::new("This run").strong());
+            match &self.this_run.seed {
+                None => ui.label("Randomizer: Off (the original game)"),
+                Some(seed) => ui.label(format!("Randomizer: On, seed {seed}")),
+            };
+            if self.this_run.seed.is_some() {
+                if self.this_run.changed.is_empty() {
+                    ui.label(RichText::new("Every setting at its default").weak());
+                }
+                for line in &self.this_run.changed {
+                    ui.label(line);
+                }
+                if let Some(spoiler) = &self.this_run.spoiler {
+                    if ui.button("Open spoiler log").clicked() {
+                        actions.push(PageAction::Spoiler(spoiler.clone()));
+                    }
+                }
+            }
+            for notice in &self.this_run.notices {
+                ui.label(RichText::new(notice).color(Color32::LIGHT_RED));
+            }
+            ui.separator();
+            ui.label(RichText::new("The settings are chosen when a New Game's mode is picked. Changing them never changes a game already started.").weak().small());
+            if let Rows::Missing(why) = &self.rows {
+                ui.label(RichText::new(why).weak().small());
+            }
+        });
+        self.this_run_open = open;
+        actions
+    }
+}
+
+/// the rows. With Randomizer off they show grey but can still be set (the FE8 port's
+/// rule); a fixed row (Children) is grey and cannot be changed.
+fn rows(ui: &mut egui::Ui, form: &mut RandoForm) {
+    let on = form.on();
+    let rows = form.rows.clone();
+    egui::Grid::new("rando rows").num_columns(2).spacing([12.0, 4.0]).show(ui, |ui| {
+        for row in &rows {
+            let mut label = RichText::new(if row.indent { format!("    {}", row.label) } else { row.label.clone() });
+            let grey = row.fixed || (!on && row.key != "randomizer");
+            if grey {
+                label = label.weak();
+            }
+            ui.label(label);
+            ui.add_enabled_ui(!row.fixed, |ui| {
+                let value = form.get(&row.key).clone();
+                match &row.kind {
+                    Kind::OnOff => {
+                        let mut v = value.as_bool().unwrap_or(false);
+                        ui.horizontal(|ui| {
+                            ui.selectable_value(&mut v, false, "Off");
+                            ui.selectable_value(&mut v, true, "On");
+                        });
+                        if Value::Bool(v) != value {
+                            form.set(&row.key, Value::Bool(v));
+                        }
+                    }
+                    Kind::Seed => {
+                        let mut text = value.as_str().unwrap_or("").to_owned();
+                        ui.horizontal(|ui| {
+                            ui.add(egui::TextEdit::singleline(&mut text).char_limit(32).hint_text("new one at Start game").desired_width(160.0));
+                            if ui.button("Random").clicked() {
+                                text = random_seed();
+                            }
+                        });
+                        if text != value.as_str().unwrap_or("") {
+                            // kept as typed so the problem shows; Start game checks it
+                            form.values.insert(row.key.clone(), Value::String(text));
+                        }
+                    }
+                    Kind::Choice(choices) => {
+                        let mut v = value.as_str().unwrap_or("").to_owned();
+                        egui::ComboBox::from_id_salt(&row.key).selected_text(v.clone()).show_ui(ui, |ui| {
+                            for choice in choices {
+                                ui.selectable_value(&mut v, choice.clone(), choice);
+                            }
+                        });
+                        if value.as_str() != Some(v.as_str()) {
+                            form.set(&row.key, Value::String(v));
+                        }
+                    }
+                    Kind::Number(min, max) => {
+                        let mut v = value.as_i64().unwrap_or(*min);
+                        ui.add(egui::DragValue::new(&mut v).range(*min..=*max));
+                        if value.as_i64() != Some(v) {
+                            form.set(&row.key, json!(v));
+                        }
+                    }
+                }
+            });
+            ui.end_row();
+        }
+    });
+}
