+    // ----------------------------------------------------------------- a fake game
+
+    use crate::fates_rando::{GAMEDATA_ARCHIVE, GAME_CONFIG};
+    use std::collections::BTreeMap;
+
+    #[derive(Default, Clone, PartialEq, Debug)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+        writes: usize,
+    }
+
+    impl Fake {
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+        fn mem(&self) -> BTreeMap<u32, Vec<u8>> {
+            self.blocks.clone()
+        }
+        /// GameConfigData's byte +0xB (1 = no chapter going on)
+        fn set_title(&mut self, title: bool) {
+            self.blocks.get_mut(&0x2300_0000).unwrap()[0xB] = title as u8;
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, addr: u32, data: &[u8]) {
+            let (b, o) = self.find(addr, data.len() as u32).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + data.len()].copy_from_slice(data);
+            self.writes += 1;
+        }
+    }
+
+    const GD_FILE: u32 = 0x3000_0000;
+
+    /// GameData loaded (value 7 at +0x10 of its data), GameConfigData at the title
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        let mut gd = vec![0u8; 0x80];
+        gd[32 + 0x10] = 7;
+        m.blocks.insert(GD_FILE, gd);
+        let mut arch = vec![0u8; 8];
+        arch[4..8].copy_from_slice(&0x2000_0100u32.to_le_bytes());
+        m.blocks.insert(0x2000_0000, arch);
+        let mut x = vec![0u8; 120];
+        x[112..116].copy_from_slice(&GD_FILE.to_le_bytes());
+        m.blocks.insert(0x2000_0100, x);
+        m.blocks.insert(GAMEDATA_ARCHIVE, 0x2000_0000u32.to_le_bytes().to_vec());
+        let mut cfg = vec![0u8; 16];
+        cfg[4..8].copy_from_slice(&0x0001_1E5Eu32.to_le_bytes());
+        cfg[0xB] = 1;
+        m.blocks.insert(0x2300_0000, cfg);
+        m.blocks.insert(GAME_CONFIG, 0x2300_0000u32.to_le_bytes().to_vec());
+        m
+    }
+
+    fn gd_value(m: &Fake) -> u8 {
+        m.blocks[&GD_FILE][32 + 0x10]
+    }
+
+    fn top(name: &str) -> PathBuf {
+        let t = std::env::temp_dir().join(format!("fates_rando_session_{name}_{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&t);
+        t
+    }
+
+    /// a made run: its patch in runs/<id>/patch.txt (GameData +0x10: 7 -> new)
+    fn made(data: &Path, id: &str, new: u8) {
+        let dir = run_dir(data, id);
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("patch.txt"), format!("fates-rando-patch 1\nseed {id}\noptions {{}}\n\
+gamedata-sha256 00\nfile gamedata GameData/GameData.bin.lz\nv 10 07 {new:02x}\nend 1\n")).unwrap();
+    }
+
+    fn no_make(_: &Path, _: &str, _: &str, _: &str) -> Result<PathBuf, String> {
+        panic!("Python must not run for a run already made")
+    }
+
+    #[test]
+    fn the_test_hook_answers_the_mode_pick_like_the_page() {
+        let data = top("hook");
+        let answer = r#"{"randomizer": true, "seed": "r51t"}"#;
+        let id = run_id("r51t", answer);
+        made(&data, &id, 9);
+        let mut m = game();
+        let before = m.mem();
+        let mut s = Session::default();
+        assert_eq!(s.frame(&mut m), Pick::None, "first look only remembers");
+        queue_answer_session(&mut s, answer);
+        assert_eq!(s.frame(&mut m), Pick::None, "no pick yet");
+        assert_eq!(m.writes, 0, "the watch only reads");
+        // the mode pick (word +4 changes, +0xB still 1)
+        m.blocks.get_mut(&0x2300_0000).unwrap()[4..8].copy_from_slice(&0x4001_5EDEu32.to_le_bytes());
+        let pick = s.frame(&mut m);
+        assert_eq!(pick, Pick::Answer(Some(answer.to_string())));
+        assert_eq!(s.answer(&mut m, &data, answer, &mut no_make), Ok(Some(id.clone())));
+        assert_eq!(gd_value(&m), 9);
+        assert_eq!(s.active(), Some(id));
+        // Randomizer off at the next new game: the original tables back
+        assert_eq!(s.answer(&mut m, &data, r#"{"randomizer": false, "seed": "x"}"#, &mut no_make), Ok(None));
+        assert_eq!(m.blocks[&GD_FILE], before[&GD_FILE]);
+        assert_eq!(s.active(), None);
+        // interactive: the page answers instead
+        let mut s = Session { interactive: true, ..Session::default() };
+        s.frame(&mut m);
+        m.blocks.get_mut(&0x2300_0000).unwrap()[4..8].copy_from_slice(&0x5001_5EDEu32.to_le_bytes());
+        assert_eq!(s.frame(&mut m), Pick::Page);
+        assert!(std::mem::take(&mut s.pending));
+        // no answer at all = off: nothing written
+        let mut s = Session::default();
+        let mut m = game();
+        s.frame(&mut m);
+        m.blocks.get_mut(&0x2300_0000).unwrap()[4..8].copy_from_slice(&0x4001_5EDEu32.to_le_bytes());
+        if std::env::var_os("FEF_RANDO_ANSWER").is_none() {
+            assert_eq!(s.frame(&mut m), Pick::Answer(None));
+        }
+        assert_eq!(m.writes, 0);
+        let _ = std::fs::remove_dir_all(&data);
+    }
+
+    fn queue_answer_session(s: &mut Session, a: &str) {
+        s.queued = Some(a.to_string());
+    }
+
+    #[test]
+    fn every_save_read_lays_its_own_run_or_the_original() {
+        let data = top("load");
+        made(&data, "rA", 9);
+        made(&data, "rB", 11);
+        fates_rando::slot_written(&data, "/Chapter0", Some("rA")).unwrap();
+        fates_rando::slot_written(&data, "/Chapter2", Some("rB")).unwrap();
+        let mut m = game();
+        let original = m.mem();
+        let mut s = Session::default();
+        // browsing the Load list: every read lays that slot's run, the last read wins
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        s.save_read(&mut m, &data, "/Chapter1", true); // no side file: the original game
+        assert_eq!((gd_value(&m), s.active()), (7, None));
+        assert_eq!(m.blocks, original);
+        s.save_read(&mut m, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (11, Some("rB")));
+        s.save_read(&mut m, &data, "/Chapter0", true); // run to run: rB put back, rA laid
+        assert_eq!((gd_value(&m), s.active().as_deref()), (9, Some("rA")));
+        let writes = m.writes;
+        s.save_read(&mut m, &data, "/Chapter0", true); // the same run again: nothing written
+        assert_eq!(m.writes, writes);
+        // a battle save with its side file
+        fates_rando::slot_written(&data, "ext:/Map0.bak", Some("rB")).unwrap();
+        s.save_read(&mut m, &data, "/Map0.bak", true);
+        assert_eq!(s.active().as_deref(), Some("rB"));
+        // inside a chapter (a save menu reading the slots) nothing changes
+        m.set_title(false);
+        s.save_read(&mut m, &data, "/Chapter1", false);
+        assert_eq!((gd_value(&m), s.active().as_deref()), (11, Some("rB")));
+        assert!(!at_title(&mut m));
+        m.set_title(true);
+        assert!(at_title(&mut m));
+        // files that are not slots are ignored
+        s.save_read(&mut m, &data, "/Global", true);
+        assert_eq!(s.active().as_deref(), Some("rB"));
+        // a side file whose run folder is gone: the original game, and a notice
+        fates_rando::slot_written(&data, "/Chapter1", Some("gone")).unwrap();
+        s.save_read(&mut m, &data, "/Chapter1", true);
+        assert_eq!((gd_value(&m), s.active()), (7, None));
+        assert!(s.notices.iter().any(|n| n.contains("gone")));
+        let _ = std::fs::remove_dir_all(&data);
+    }
+
+    #[test]
+    fn a_save_whose_tables_were_changed_by_another_mod_is_not_laid() {
+        let data = top("guard");
+        made(&data, "rA", 9);
+        fates_rando::slot_written(&data, "/Chapter0", Some("rA")).unwrap();
+        let mut m = game();
+        m.blocks.get_mut(&GD_FILE).unwrap()[32 + 0x10] = 8;
+        let before = m.mem();
+        let mut s = Session::default();
+        s.save_read(&mut m, &data, "/Chapter0", true);
+        assert_eq!(m.writes, 0);
+        assert_eq!(m.blocks, before);
+        assert_eq!(s.active(), None);
+        assert_eq!(s.lay(&mut m, &data, "rA").map_err(|e| e.contains("not the original")), Err(true));
+        let _ = std::fs::remove_dir_all(&data);
+    }
+
+    #[test]
+    fn side_files_round_trip_through_saves_and_states() {
+        let data = top("side");
+        made(&data, "rA", 9);
+        let mut m = game();
+        let mut s = Session::default();
+        s.lay(&mut m, &data, "rA").unwrap();
+        // the game writes slot 2 and its battle save: both name the run
+        s.save_written(&data, "/Chapter2");
+        s.save_written(&data, "/Map1.bak");
+        s.save_written(&data, "/Global");
+        assert_eq!(fates_rando::slot_run(&data, "/Chapter2").as_deref(), Some("rA"));
+        assert_eq!(fates_rando::slot_run(&data, "/Map1.bak").as_deref(), Some("rA"));
+        assert!(!fates_rando::slots_dir(&data).join("Global.json").exists());
+        // a fresh session reading slot 2 lays the same run
+        let mut m2 = game();
+        let mut s2 = Session::default();
+        s2.save_read(&mut m2, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m2), s2.active().as_deref()), (9, Some("rA")));
+        // the original game overwrites slot 2: its side file goes
+        s.original(&mut m);
+        s.save_written(&data, "/Chapter2");
+        assert_eq!(fates_rando::slot_run(&data, "/Chapter2"), None);
+        // a save state's sidecar
+        let state = data.join("state1.bin");
+        write_sidecar(&state, Some("rA")).unwrap();
+        assert_eq!(read_sidecar(&state).as_deref(), Some("rA"));
+        // loading that state: memory already holds rA's tables, so nothing is written
+        let mut m3 = m2.clone();
+        let writes = m3.writes;
+        let mut s3 = Session::default();
+        s3.restore(&mut m3, &data, read_sidecar(&state).as_deref());
+        assert_eq!((s3.active().as_deref(), m3.writes), (Some("rA"), writes));
+        // and a later load of an original save puts the tables back
+        s3.save_read(&mut m3, &data, "/Chapter2", true);
+        assert_eq!((gd_value(&m3), s3.active()), (7, None));
+        write_sidecar(&state, None).unwrap();
+        assert_eq!(read_sidecar(&state), None);
+        s3.restore(&mut m3, &data, None);
+        assert_eq!(s3.active(), None);
+        let _ = std::fs::remove_dir_all(&data);
+    }
+
+    #[test]
+    fn reads_in_pieces_get_the_patched_bytes_only_inside_the_file() {
+        let patched: Vec<u8> = (0..100u8).map(|b| b ^ 0xFF).collect();
+        let mut whole = vec![0u8; 400];
+        // the file sits at 150..250 of the RomFS; read in 64-byte pieces
+        for at in (0..400).step_by(64) {
+            let n = 64.min(400 - at);
+            let mut piece = vec![0u8; n];
+            overlay(at as u64, &mut piece, 150, 100, &patched);
+            whole[at..at + n].copy_from_slice(&piece);
+        }
+        assert!(whole[..150].iter().all(|&b| b == 0));
+        assert_eq!(&whole[150..250], &patched[..]);
+        assert!(whole[250..].iter().all(|&b| b == 0));
+    }
+}
