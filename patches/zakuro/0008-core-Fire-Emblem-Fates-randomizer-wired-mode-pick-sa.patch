+    #[test]
+    fn state_sidecar_names_the_file() {
+        assert_eq!(sidecar_path(Path::new("build/s/state1.zst")), PathBuf::from("build/s/state1.zst.rando.json"));
+        assert!(run_dir(Path::new("d"), "r51-0000abcd").ends_with("rando/0004000000179800/runs/r51-0000abcd"));
