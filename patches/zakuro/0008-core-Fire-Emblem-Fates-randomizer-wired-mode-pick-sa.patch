+//! Fire Emblem Fates randomizer: chapter placement files patched inside the game's own
+//! read (docs/RANDOMIZER_INGAME.md, section 3b, the "precise hook").
+//!
+//! Round 50's robot test T3 showed the game makes a chapter's units in the same frame it
+//! loads that chapter's placement file (`map::Dispos::Load` 0x0039ED9C ->
+//! `ArchiveFile::ArchiveFile` 0x00193408: open, read, decompress, relocate, all inside one
+//! call), so laying the cells after the frame is too late. Instead the file service hands
+//! the game a patched copy of the file's bytes in the read itself: the game reads its
+//! RomFS through one SelfNCCH file, so a read that covers a placement file's extent gets
+//! the patched bytes there. No game code changes, and nothing at all happens without an
+//! active randomized run.
+//!
+//! The patched copy is made host side from the original stored file:
+//! 1. LZ13/LZ11/LZ10 decompress;
+//! 2. the IS .bin container (header 0x20: file size, data size, relocation count, label
+//!    count; data; relocations; labels; string pool);
+//! 3. the original-byte guard: every cell of the patch must hold its original value (plain
+//!    bytes byte for byte; a pointer cell must be a relocated pointer showing the original
+//!    label text, or a plain null) - one difference and the file is served unchanged;
+//! 4. the cells written in file form: plain bytes in place; a label pointer gets the
+//!    label's offset in this file's string pool (labels the file does not have, the ones
+//!    the patch takes from GameData's pool, are appended to the end of the pool); a slot
+//!    that becomes a pointer gains a relocation entry, one that becomes null loses its
+//!    entry, and every pointer into the string pool moves by the change in the size of
+//!    the relocation list;
+//! 5. LZ11 compressed again (an optimal parse, so it is no bigger than the game's own
+//!    greedy one on nearly the same bytes) in the original's format, and zero-padded to
+//!    the original stored size (the game reads the size its RomFS directory says; bytes
+//!    past the end of an LZ stream are not read, as in the 74 game files that carry some).
+//!    A patched file that does not fit is refused like a guard failure.
+//!
+//! After the game's relocation the patched file is the same as round 50's in-memory apply
+//! of the original (`fates_rando::apply_file`): the same plain bytes, every pointer showing
+//! the same label text (labels from GameData are this file's own copies of the text).
+
+use crate::fates_rando::{FilePatch, Where};
+
+// --------------------------------------------------------------------------- LZ
+
+/// the decompressed bytes and the facts a rebuild needs: the format byte (0x10, 0x11 or
+/// 0x13) and, for 0x13, the outer size.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Lz {
+    pub data: Vec<u8>,
+    pub format: u8,
+    pub outer: u32,
+}
+
+fn lz_header(src: &[u8], pos: usize) -> Result<(usize, usize), String> {
+    let b = src.get(pos..pos + 4).ok_or("LZ: cut header")?;
+    let size = b[1] as usize | (b[2] as usize) << 8 | (b[3] as usize) << 16;
+    if size == 0 {
+        let e = src.get(pos + 4..pos + 8).ok_or("LZ: cut extended header")?;
+        return Ok((u32::from_le_bytes([e[0], e[1], e[2], e[3]]) as usize, pos + 8));
+    }
+    Ok((size, pos + 4))
+}
+
+pub fn lz_decompress(src: &[u8]) -> Result<Lz, String> {
+    let format = *src.first().ok_or("LZ: empty")?;
+    let (outer, mut kind, mut pos) = match format {
+        0x13 => {
+            let (outer, p) = lz_header(src, 0)?;
+            if src.get(p) != Some(&0x11) {
+                return Err("LZ13: inner stream is not LZ11".into());
+            }
+            (outer as u32, 0x11u8, p)
+        }
+        0x10 | 0x11 => (0, format, 0),
+        _ => return Err(format!("not an LZ stream (format byte {format:#04x})")),
+    };
+    let (size, p) = lz_header(src, pos)?;
+    pos = p;
+    if kind == 0x13 {
+        kind = 0x11;
+    }
+    let mut out: Vec<u8> = Vec::with_capacity(size);
+    let byte = |pos: usize| src.get(pos).copied().ok_or_else(|| "LZ: truncated stream".to_string());
+    while out.len() < size {
+        let flags = byte(pos)?;
+        pos += 1;
+        for bit in (0..8).rev() {
+            if out.len() >= size {
+                break;
+            }
+            if flags >> bit & 1 == 0 {
+                out.push(byte(pos)?);
+                pos += 1;
+                continue;
+            }
+            let b0 = byte(pos)? as usize;
+            let (len, disp) = if kind == 0x10 {
+                let b1 = byte(pos + 1)? as usize;
+                pos += 2;
+                ((b0 >> 4) + 3, ((b0 & 15) << 8 | b1) + 1)
+            } else {
+                match b0 >> 4 {
+                    0 => {
+                        let (b1, b2) = (byte(pos + 1)? as usize, byte(pos + 2)? as usize);
+                        pos += 3;
+                        (((b0 & 15) << 4 | b1 >> 4) + 0x11, ((b1 & 15) << 8 | b2) + 1)
+                    }
+                    1 => {
+                        let (b1, b2, b3) = (byte(pos + 1)? as usize, byte(pos + 2)? as usize, byte(pos + 3)? as usize);
+                        pos += 4;
+                        (((b0 & 15) << 12 | b1 << 4 | b2 >> 4) + 0x111, ((b2 & 15) << 8 | b3) + 1)
+                    }
+                    n => {
+                        let b1 = byte(pos + 1)? as usize;
+                        pos += 2;
+                        (n + 1, ((b0 & 15) << 8 | b1) + 1)
+                    }
+                }
+            };
+            if disp > out.len() {
+                return Err("LZ: displacement before the start".into());
+            }
+            for _ in 0..len {
+                out.push(out[out.len() - disp]);
+            }
+        }
+    }
+    if out.len() != size {
+        return Err("LZ: stream overruns its size".into());
+    }
+    Ok(Lz { data: out, format, outer })
+}
+
+const WINDOW: usize = 0x1000;
+const MAX_LEN: usize = 0x10110;
+/// as the game's own compressor ("VRAM-safe"): never a displacement of 1.
+const MIN_DISP: usize = 2;
+const CHAIN: usize = 512;
+
+fn match_bits(len: usize) -> u32 {
+    1 + if len <= 16 { 16 } else if len <= 0x110 { 24 } else { 32 }
+}
+
+/// LZ11 (or LZ13 around LZ11) with an optimal parse. `outer` is the LZ13 outer size.
+pub fn lz11_compress(data: &[u8], format: u8, outer: u32) -> Vec<u8> {
+    let n = data.len();
+    // the longest match (len, disp) at each position, from 3-byte hash chains
+    let mut best = vec![(0usize, 0usize); n];
+    let mut head = vec![usize::MAX; 1 << 16];
+    let mut prev = vec![usize::MAX; n];
+    let hash = |i: usize| ((data[i] as usize) << 8 ^ (data[i + 1] as usize) << 4 ^ data[i + 2] as usize) & 0xFFFF;
+    for i in 0..n {
+        if i + 3 > n {
+            break;
+        }
+        let h = hash(i);
+        let lim = (n - i).min(MAX_LEN);
+        let mut cand = head[h];
+        let mut steps = 0;
+        while cand != usize::MAX && i - cand <= WINDOW && steps < CHAIN {
+            let disp = i - cand;
+            if disp >= MIN_DISP {
+                let mut l = 0;
+                while l < lim && data[cand + l] == data[i + l] {
+                    l += 1;
+                }
+                if l >= 3 && l > best[i].0 {
+                    best[i] = (l, disp);
+                    if l == lim {
+                        break;
+                    }
+                }
+            }
+            cand = prev[cand];
+            steps += 1;
+        }
+        prev[i] = head[h];
+        head[h] = i;
+    }
+    // cheapest parse from each position to the end
+    let mut cost = vec![0u32; n + 1];
+    let mut take = vec![0usize; n]; // 0 = literal, else match length
+    for i in (0..n).rev() {
+        cost[i] = 9 + cost[i + 1];
+        take[i] = 0;
+        let l_max = best[i].0;
+        if l_max >= 3 {
+            let mut try_len = |l: usize| {
+                let c = match_bits(l) + cost[i + l];
+                if c < cost[i] {
+                    cost[i] = c;
+                    take[i] = l;
+                }
+            };
+            for l in 3..=l_max.min(0x110) {
+                try_len(l);
+            }
+            if l_max > 0x110 {
+                try_len(l_max);
+            }
+        }
+    }
+    let mut out = Vec::with_capacity(n / 2 + 16);
+    let header = |out: &mut Vec<u8>, kind: u8, size: usize| {
+        if size < 1 << 24 && size > 0 {
+            out.extend_from_slice(&[kind, size as u8, (size >> 8) as u8, (size >> 16) as u8]);
+        } else {
+            out.extend_from_slice(&[kind, 0, 0, 0]);
+            out.extend_from_slice(&(size as u32).to_le_bytes());
+        }
+    };
+    if format == 0x13 {
+        header(&mut out, 0x13, outer as usize);
+    }
+    header(&mut out, 0x11, n);
+    let mut i = 0;
+    while i < n {
+        let flag_pos = out.len();
+        out.push(0);
+        let mut flags = 0u8;
+        for bit in (0..8).rev() {
+            if i >= n {
+                break;
+            }
+            let l = take[i];
+            if l == 0 {
+                out.push(data[i]);
+                i += 1;
+                continue;
+            }
+            flags |= 1 << bit;
+            let d = best[i].1 - 1;
+            if l <= 16 {
+                out.extend_from_slice(&[((l - 1) << 4 | d >> 8) as u8, d as u8]);
+            } else if l <= 0x110 {
+                let l2 = l - 0x11;
+                out.extend_from_slice(&[(l2 >> 4) as u8, ((l2 & 15) << 4 | d >> 8) as u8, d as u8]);
+            } else {
+                let l2 = l - 0x111;
+                out.extend_from_slice(&[(0x10 | l2 >> 12) as u8, (l2 >> 4) as u8, ((l2 & 15) << 4 | d >> 8) as u8, d as u8]);
+            }
+            i += l;
+        }
+        out[flag_pos] = flags;
+    }
+    out
+}
+
+// --------------------------------------------------------------------------- IS .bin
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct IsBin {
+    pub pad: [u8; 16],
+    pub data: Vec<u8>,
+    pub relocs: Vec<u32>,
+    /// (data offset, name offset in the string pool)
+    pub labels: Vec<(u32, u32)>,
+    pub strtab: Vec<u8>,
+}
+
+fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+    b.get(at..at + 4).map(|w| u32::from_le_bytes([w[0], w[1], w[2], w[3]]))
+}
+
+impl IsBin {
+    pub fn parse(d: &[u8]) -> Result<IsBin, String> {
+        let h = |i: usize| u32_at(d, i * 4).ok_or_else(|| "IS bin: cut header".to_string());
+        let (fs, ds, c1, c2) = (h(0)? as usize, h(1)? as usize, h(2)? as usize, h(3)? as usize);
+        let p1 = 0x20 + ds;
+        let p2 = p1 + 4 * c1;
+        let se = p2 + 8 * c2;
+        if fs != d.len() || se > d.len() {
+            return Err("IS bin: sizes do not match the file".into());
+        }
+        let mut pad = [0u8; 16];
+        pad.copy_from_slice(&d[0x10..0x20]);
+        let relocs: Vec<u32> = (0..c1).map(|i| u32_at(d, p1 + 4 * i).unwrap()).collect();
+        if relocs.iter().any(|&r| r as usize + 4 > ds || r & 3 != 0) {
+            return Err("IS bin: a relocation points outside the data".into());
+        }
+        let labels = (0..c2).map(|i| (u32_at(d, p2 + 8 * i).unwrap(), u32_at(d, p2 + 8 * i + 4).unwrap())).collect();
+        Ok(IsBin { pad, data: d[0x20..p1].to_vec(), relocs, labels, strtab: d[se..].to_vec() })
+    }
+
+    /// where the string pool starts, counted from the data start (as the pointers count).
+    pub fn se(&self) -> u32 {
+        (self.data.len() + 4 * self.relocs.len() + 8 * self.labels.len()) as u32
+    }
+
+    pub fn build(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(0x20 + self.se() as usize + self.strtab.len());
+        for v in [0u32, self.data.len() as u32, self.relocs.len() as u32, self.labels.len() as u32] {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend_from_slice(&self.pad);
+        out.extend_from_slice(&self.data);
+        for r in &self.relocs {
+            out.extend_from_slice(&r.to_le_bytes());
+        }
+        for (a, b) in &self.labels {
+            out.extend_from_slice(&a.to_le_bytes());
+            out.extend_from_slice(&b.to_le_bytes());
+        }
+        out.extend_from_slice(&self.strtab);
+        let len = out.len() as u32;
+        out[..4].copy_from_slice(&len.to_le_bytes());
+        out
+    }
+
+    pub fn word(&self, off: u32) -> Option<u32> {
+        u32_at(&self.data, off as usize)
+    }
+
+    /// the text a pointer's file value shows (it must point into the string pool).
+    pub fn string_at(&self, value: u32) -> Option<&[u8]> {
+        let o = value.checked_sub(self.se())? as usize;
+        let rest = self.strtab.get(o..)?;
+        let end = rest.iter().position(|&b| b == 0)?;
+        Some(&rest[..end])
+    }
+}
+
+/// the guard on the original file (the same checks `fates_rando::apply_file` makes on
+/// memory, in file form): the cells that do not hold their original value.
+pub fn guard(bin: &IsBin, f: &FilePatch) -> Vec<String> {
+    let mut bad = Vec::new();
+    for v in &f.values {
+        let at = v.off as usize;
+        if bin.data.get(at..at + v.old.len()) != Some(&v.old[..]) {
+            bad.push(format!("{}: v {:#x} does not hold its original bytes", f.rel, v.off));
+        }
+    }
+    let se = bin.se();
+    for p in &f.ptrs {
+        let is_reloc = bin.relocs.contains(&p.off);
+        let cur = bin.word(p.off);
+        let ok = match (&p.old, cur) {
+            (_, None) => false,
+            (None, Some(w)) => !is_reloc && w == 0,
+            (Some(label), Some(w)) => {
+                is_reloc && w >= se && p.old_value == Some(w) && bin.string_at(w) == Some(&label[..])
+            }
+        };
+        if !ok {
+            bad.push(format!("{}: p {:#x} does not show its original label", f.rel, p.off));
+        }
+        if let (Some(label), Some((Where::Own, o))) = (&p.new, p.target) {
+            if bin.string_at(o) != Some(&label[..]) {
+                bad.push(format!("{}: p {:#x}: the new label is not at {o:#x} of the file's own pool", f.rel, p.off));
+            }
+        }
+    }
+    bad
+}
+
+/// writes the patch's cells into the file form (after `guard` found nothing).
+pub fn apply(bin: &mut IsBin, f: &FilePatch) {
+    for v in &f.values {
+        let at = v.off as usize;
+        bin.data[at..at + v.new.len()].copy_from_slice(&v.new);
+    }
+    let se_old = bin.se();
+    // new labels appended to the pool, one copy each (pool offset)
+    let mut appended: Vec<(Vec<u8>, u32)> = Vec::new();
+    // per pointer cell: Some(pool offset) or None (null)
+    let mut targets: Vec<(u32, Option<u32>)> = Vec::new();
+    for p in &f.ptrs {
+        let t = match (&p.new, p.target) {
+            (None, _) | (_, None) => None,
+            (Some(_), Some((Where::Own, o))) => Some(o - se_old),
+            (Some(label), Some((Where::GameData, _))) => {
+                // the file's own copy of the label when it has one, else appended
+                let own = find_label(&bin.strtab, label);
+                Some(match own.or_else(|| appended.iter().find(|(l, _)| l == label).map(|(_, o)| *o)) {
+                    Some(o) => o,
+                    None => {
+                        let o = bin.strtab.len() as u32;
+                        bin.strtab.extend_from_slice(label);
+                        bin.strtab.push(0);
+                        appended.push((label.clone(), o));
+                        o
+                    }
+                })
+            }
+        };
+        targets.push((p.off, t));
+    }
+    // the relocation list: entries dropped for slots that become null, added for slots
+    // that become pointers (the original order otherwise kept)
+    let drop: Vec<u32> = targets.iter().filter(|(_, t)| t.is_none()).map(|(o, _)| *o).collect();
+    bin.relocs.retain(|r| !drop.contains(r));
+    for (off, t) in &targets {
+        if t.is_some() && !bin.relocs.contains(off) {
+            bin.relocs.push(*off);
+        }
+    }
+    let se_new = bin.se();
+    // every other pointer into the pool moves with it
+    let cells: Vec<u32> = targets.iter().map(|(o, _)| *o).collect();
+    for i in 0..bin.relocs.len() {
+        let r = bin.relocs[i];
+        if cells.contains(&r) {
+            continue;
+        }
+        let w = bin.word(r).unwrap();
+        if w >= se_old {
+            let moved = w - se_old + se_new;
+            bin.data[r as usize..r as usize + 4].copy_from_slice(&moved.to_le_bytes());
+        }
+    }
+    for (off, t) in targets {
+        let value = t.map_or(0, |o| se_new + o);
+        bin.data[off as usize..off as usize + 4].copy_from_slice(&value.to_le_bytes());
+    }
+}
+
+/// a whole NUL-terminated string of the pool equal to `label`.
+fn find_label(strtab: &[u8], label: &[u8]) -> Option<u32> {
+    let mut i = 0;
+    while i < strtab.len() {
+        let end = strtab[i..].iter().position(|&b| b == 0).map_or(strtab.len(), |e| i + e);
+        if &strtab[i..end] == label {
+            return Some(i as u32);
+        }
+        i = end + 1;
+    }
+    None
+}
+
+/// the original stored file -> the patched stored file of exactly the same size, or the
+/// reasons nothing is patched.
+pub fn patch_stored(stored: &[u8], f: &FilePatch) -> Result<Vec<u8>, Vec<String>> {
+    let one = |e: String| vec![format!("{}: {e}", f.rel)];
+    let lz = lz_decompress(stored).map_err(one)?;
+    let mut bin = IsBin::parse(&lz.data).map_err(one)?;
+    // pointers into the area between the data and the pool would move wrongly
+    for &r in &bin.relocs {
+        let w = bin.word(r).unwrap();
+        if w as usize >= bin.data.len() && w < bin.se() {
+            return Err(one(format!("pointer at {r:#x} points into the relocation or label lists")));
+        }
+    }
+    let bad = guard(&bin, f);
+    if !bad.is_empty() {
+        return Err(bad);
+    }
+    apply(&mut bin, f);
+    let raw = bin.build();
+    let outer = if lz.format == 0x13 {
+        (lz.outer as i64 + raw.len() as i64 - lz.data.len() as i64).max(raw.len() as i64) as u32
+    } else {
+        0
+    };
+    let mut out = lz11_compress(&raw, if lz.format == 0x13 { 0x13 } else { 0x11 }, outer);
+    if lz.format == 0x10 {
+        return Err(one("LZ10 files are not rebuilt".into()));
+    }
+    if out.len() > stored.len() {
+        return Err(one(format!("the patched file ({} bytes) does not fit in the original's {} bytes",
+                               out.len(), stored.len())));
+    }
+    out.resize(stored.len(), 0);
+    Ok(out)
+}
+
+/// the file as the game holds it after its relocation, from its data start: every
+/// relocated pointer = base + its file value (what `ArchiveFile` leaves in memory).
+pub fn relocated(bin: &IsBin, base: u32) -> Vec<u8> {
+    let mut img = bin.build()[0x20..].to_vec();
+    for &r in &bin.relocs {
+        let w = bin.word(r).unwrap().wrapping_add(base);
+        img[r as usize..r as usize + 4].copy_from_slice(&w.to_le_bytes());
+    }
+    img
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::fates_rando::{Patch, Ptr, Value, Kind};
+
+    /// a small placement file: data 0x40 bytes (pointer at 0x8 to "JID_A", a value at
+    /// 0xC, a null slot at 0x10, a data pointer at 0x14 to 0x20, a pointer at 0x18 to
+    /// "IID_X"), one label, pool "PERSON\0JID_A\0IID_X\0".
+    fn sample() -> IsBin {
+        let mut b = IsBin { pad: [0; 16], data: vec![0; 0x40], relocs: vec![0x8, 0x14, 0x18], labels: vec![(0, 0)],
+                            strtab: b"PERSON\0JID_A\0IID_X\0".to_vec() };
+        let se = b.se();
+        b.data[0x8..0xC].copy_from_slice(&(se + 7).to_le_bytes());
+        b.data[0xC] = 3;
+        b.data[0x14..0x18].copy_from_slice(&0x20u32.to_le_bytes());
+        b.data[0x18..0x1C].copy_from_slice(&(se + 13).to_le_bytes());
+        b.data[0x20..0x24].copy_from_slice(b"DATA");
+        b
+    }
+
+    fn patch_for(b: &IsBin) -> FilePatch {
+        let se = b.se();
+        FilePatch {
+            kind: Kind::Dispos,
+            rel: "GameData/Dispos/A/A005.bin.lz".into(),
+            values: vec![Value { off: 0xC, old: vec![3], new: vec![5] }],
+            ptrs: vec![
+                // JID_A -> JID_B (from GameData's pool: not in the file)
+                Ptr { off: 0x8, old: Some(b"JID_A".to_vec()), new: Some(b"JID_B".to_vec()),
+                      target: Some((Where::GameData, 0x110)), old_value: Some(se + 7) },
+                // null -> IID_X (the file's own)
+                Ptr { off: 0x10, old: None, new: Some(b"IID_X".to_vec()), target: Some((Where::Own, se + 13)),
+                      old_value: None },
+                // IID_X -> null
+                Ptr { off: 0x18, old: Some(b"IID_X".to_vec()), new: None, target: None, old_value: Some(se + 13) },
+            ],
+        }
+    }
+
+    fn cstr_in(img: &[u8], base: u32, addr: u32) -> Option<Vec<u8>> {
+        let o = addr.checked_sub(base)? as usize;
+        let rest = img.get(o..)?;
+        Some(rest[..rest.iter().position(|&b| b == 0)?].to_vec())
+    }
+
+    #[test]
+    fn lz_round_trips() {
+        let mut data = Vec::new();
+        for i in 0..5000u32 {
+            data.extend_from_slice(&(i % 37).to_le_bytes());
+            if i % 100 == 0 {
+                data.extend_from_slice(&[0u8; 300]);
+            }
+        }
+        for format in [0x11u8, 0x13] {
+            let z = lz11_compress(&data, format, data.len() as u32 + 8);
+            assert!(z.len() < data.len() / 2);
+            let back = lz_decompress(&z).unwrap();
+            assert_eq!(back.data, data);
+            assert_eq!(back.format, format);
+            if format == 0x13 {
+                assert_eq!(back.outer, data.len() as u32 + 8);
+            }
+        }
+        assert_eq!(lz_decompress(&lz11_compress(&[], 0x11, 0)).unwrap().data, Vec::<u8>::new());
+        assert!(lz_decompress(&[0x11, 9, 0, 0, 0x00, 1]).is_err(), "cut stream");
+        assert!(lz_decompress(b"PK").is_err());
+    }
+
+    #[test]
+    fn is_bin_round_trips() {
+        let b = sample();
+        assert_eq!(IsBin::parse(&b.build()).unwrap(), b);
+        let mut bad = b.build();
+        bad[0] ^= 1;
+        assert!(IsBin::parse(&bad).is_err());
+    }
+
+    /// the placement patch on a buffer: after the game's relocation the patched file shows
+    /// the same plain bytes and the same label text as the in-memory apply would.
+    #[test]
+    fn placement_patch_on_a_buffer_matches_the_in_memory_apply() {
+        let b = sample();
+        let f = patch_for(&b);
+        let stored = lz11_compress(&b.build(), 0x13, b.build().len() as u32);
+        let mut padded = stored.clone();
+        padded.extend_from_slice(&[0u8; 64]); // room for the appended label
+        let out = patch_stored(&padded, &f).unwrap();
+        assert_eq!(out.len(), padded.len(), "the same size as the original");
+        let nb = IsBin::parse(&lz_decompress(&out).unwrap().data).unwrap();
+        let base = 0x3800_0020;
+        let img = relocated(&nb, base);
+        assert_eq!(img[0xC], 5);
+        assert_eq!(cstr_in(&img, base, u32::from_le_bytes(img[0x8..0xC].try_into().unwrap())).unwrap(), b"JID_B");
+        assert_eq!(cstr_in(&img, base, u32::from_le_bytes(img[0x10..0x14].try_into().unwrap())).unwrap(), b"IID_X");
+        assert_eq!(u32::from_le_bytes(img[0x18..0x1C].try_into().unwrap()), 0, "a null stays null after relocation");
+        assert_eq!(u32::from_le_bytes(img[0x14..0x18].try_into().unwrap()), base + 0x20, "data pointers unchanged");
+        assert_eq!(&img[0x20..0x24], b"DATA");
+        assert_eq!(nb.labels, b.labels);
+        assert_eq!(nb.string_at(nb.se() + nb.labels[0].1), Some(&b"PERSON"[..]), "labels keep their names");
+        // every other byte of the data region is the original's
+        let ob = relocated(&b, base);
+        for i in (0..0x40).filter(|i| !(0x8..0x1C).contains(i)) {
+            assert_eq!(img[i], ob[i], "byte {i:#x}");
+        }
+    }
+
+    #[test]
+    fn placement_guard_refuses_and_serves_nothing() {
+        let b = sample();
+        let mut f = patch_for(&b);
+        let stored = {
+            let mut s = lz11_compress(&b.build(), 0x13, b.build().len() as u32);
+            s.extend_from_slice(&[0u8; 64]);
+            s
+        };
+        // another mod changed the value
+        f.values[0].old = vec![4];
+        assert!(patch_stored(&stored, &f).is_err());
+        // a label that is not the original
+        let mut f = patch_for(&b);
+        f.ptrs[0].old = Some(b"JID_Z".to_vec());
+        assert!(patch_stored(&stored, &f).is_err());
+        // a slot said to be null that is a pointer
+        let mut f = patch_for(&b);
+        f.ptrs[1].off = 0x14;
+        assert!(patch_stored(&stored, &f).is_err());
+        // an own-pool label that is not where the patch says
+        let mut f = patch_for(&b);
+        f.ptrs[1].target = Some((Where::Own, b.se()));
+        assert!(patch_stored(&stored, &f).is_err());
+        // too big for the original's place
+        let tight = lz11_compress(&b.build(), 0x13, b.build().len() as u32);
+        let err = patch_stored(&tight, &patch_for(&b)).unwrap_err();
+        assert!(err[0].contains("does not fit"), "{err:?}");
+        // not LZ at all
+        assert!(patch_stored(b"plain", &patch_for(&b)).is_err());
+    }
+
+    /// every placement file of a made patch against the dump's own files, when FEF_RANDO_PATCH
+    /// and FEF_ROMFS (an extracted RomFS) are given; skipped otherwise (game data is never kept
+    /// in the repo).
+    #[test]
+    fn made_patch_fits_the_real_files() {
+        let (Ok(patch), Ok(romfs)) = (std::env::var("FEF_RANDO_PATCH"), std::env::var("FEF_ROMFS")) else { return };
+        let p = Patch::parse(&std::fs::read_to_string(patch).unwrap()).unwrap();
+        let (mut ok, mut refused) = (0, Vec::new());
+        for f in p.files.iter().filter(|f| f.kind == Kind::Dispos) {
+            let stored = std::fs::read(std::path::Path::new(&romfs).join(&f.rel)).unwrap();
+            match patch_stored(&stored, f) {
+                Ok(out) => {
+                    assert_eq!(out.len(), stored.len());
+                    // the relocated result shows every cell's new value
+                    let nb = IsBin::parse(&lz_decompress(&out).unwrap().data).unwrap();
+                    let base = 0x3000_0020;
+                    let img = relocated(&nb, base);
+                    for v in &f.values {
+                        assert_eq!(&img[v.off as usize..v.off as usize + v.new.len()], &v.new[..], "{}", f.rel);
+                    }
+                    for c in &f.ptrs {
+                        let w = u32::from_le_bytes(img[c.off as usize..c.off as usize + 4].try_into().unwrap());
+                        match &c.new {
+                            None => assert_eq!(w, 0, "{}", f.rel),
+                            Some(l) => assert_eq!(cstr_in(&img, base, w).as_ref(), Some(l), "{}", f.rel),
+                        }
+                    }
+                    ok += 1;
+                }
+                Err(e) => refused.push(e.join("; ")),
+            }
+        }
+        eprintln!("placement files patched in the read: {ok} fit, {} refused", refused.len());
+        for r in &refused {
+            eprintln!("  refused: {r}");
+        }
+        // only size may refuse a file of a made patch (those are laid at the next system
+        // call instead); a guard failure on the clean dump would be a real error
+        assert!(refused.iter().all(|r| r.contains("does not fit") && !r.contains(';')), "{refused:?}");
+    }
+}
