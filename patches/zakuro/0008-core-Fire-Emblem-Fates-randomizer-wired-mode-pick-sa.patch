+// --------------------------------------------------------------------------- Python
+
+/// how to start Python: the program and the arguments before the script's.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Python {
+    pub program: PathBuf,
+    pub args: Vec<String>,
+}
+
+/// makes `cmd` start without a window (Windows: CREATE_NO_WINDOW); returns the creation
+/// flags it set (0 elsewhere).
+pub fn hide_window(cmd: &mut Command) -> u32 {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(CREATE_NO_WINDOW);
+        CREATE_NO_WINDOW
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = cmd;
+        0
+    }
+}
+
+/// a hidden Python command: no window, no input, output piped (to the log). Returns the
+/// creation flags too, for the test.
+pub fn python_command(py: &Python, args: &[&std::ffi::OsStr]) -> (Command, u32) {
+    let mut cmd = Command::new(&py.program);
+    cmd.args(&py.args).args(args).stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped());
+    cmd.env("PYTHONIOENCODING", "utf-8").env("PYTHONDONTWRITEBYTECODE", "1");
+    let flags = hide_window(&mut cmd);
+    (cmd, flags)
+}
+
+/// runs a hidden command to its end (killed past `timeout`); every output line goes to
+/// the log (zakuro.log). Returns (exit code, the output's lines).
+pub fn run_hidden(mut cmd: Command, timeout: Duration) -> Result<(i32, Vec<String>), String> {
+    let mut child = cmd.spawn().map_err(|e| format!("could not start {:?}: {e}", cmd.get_program()))?;
+    let pump = |r: Option<Box<dyn Read + Send>>| {
+        std::thread::spawn(move || {
+            let mut lines = Vec::new();
+            if let Some(r) = r {
+                for line in BufReader::new(r).lines().map_while(Result::ok) {
+                    log::info!("rando.py: {line}");
+                    lines.push(line);
+                }
+            }
+            lines
+        })
+    };
+    let out = pump(child.stdout.take().map(|s| Box::new(s) as Box<dyn Read + Send>));
+    let err = pump(child.stderr.take().map(|s| Box::new(s) as Box<dyn Read + Send>));
+    let started = Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) if started.elapsed() > timeout => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(format!("it took longer than {} s and was stopped", timeout.as_secs()));
+            }
+            Ok(None) => std::thread::sleep(Duration::from_millis(50)),
+            Err(e) => return Err(e.to_string()),
+        }
+    };
+    let mut lines = out.join().unwrap_or_default();
+    lines.extend(err.join().unwrap_or_default());
+    Ok((status.code().unwrap_or(-1), lines))
+}
+
+/// FEF_PYTHON, then `py -3`, then `python`: the first that answers `--version` with
+/// Python 3 within 5 s.
+pub fn find_python() -> Result<Python, String> {
+    let mut tries = Vec::new();
+    if let Some(p) = std::env::var_os("FEF_PYTHON") {
+        tries.push(Python { program: p.into(), args: vec![] });
+    }
+    tries.push(Python { program: "py".into(), args: vec!["-3".into()] });
+    tries.push(Python { program: "python".into(), args: vec![] });
+    for py in tries {
+        let (cmd, _) = python_command(&py, &["--version".as_ref()]);
+        if let Ok((0, lines)) = run_hidden(cmd, PROBE_TIMEOUT) {
+            if lines.iter().any(|l| l.starts_with("Python 3")) {
+                return Ok(py);
+            }
+        }
+    }
+    Err("Python 3 was not found; the randomizer needs it".into())
+}
+
+/// the randomizer's folder: FEF_RANDO_TOOL, else `tools/randomizer` in this program's
+/// folder or one above it (the port's `play/game/../../tools/randomizer`).
+pub fn find_tool() -> Result<PathBuf, String> {
+    if let Some(p) = std::env::var_os("FEF_RANDO_TOOL") {
+        let p = PathBuf::from(p);
+        return if p.join("rando.py").is_file() { Ok(p) } else { Err(format!("{}: no rando.py there", p.display())) };
+    }
+    let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+    for dir in exe.ancestors().skip(1).take(7) {
+        let t = dir.join("tools").join("randomizer");
+        if t.join("rando.py").is_file() && t.join("ingame.py").is_file() {
+            return Ok(t);
+        }
+    }
+    Err("the randomizer (tools/randomizer) was not found next to this program".into())
+}
+
+/// what Python runs: `rando.py make` with the page's answer turned into its flags by
+/// `ingame.make_args` (one list, one place), the patch written with `--patch-out`.
+const MAKE_SCRIPT: &str = "import sys, json\n\
+tool, answer, out, patch, seed, options = sys.argv[1:7]\n\
+sys.path.insert(0, tool)\n\
+import rando\n\
+import ingame\n\
+a = json.load(open(answer, encoding='utf-8'))\n\
+a['seed'] = a.get('seed') or seed\n\
+with open(options, 'w', encoding='utf-8') as fh:\n    json.dump(a, fh, sort_keys=True)\n\
+sys.exit(rando.main(['make'] + ingame.make_args(a) + ['--out', out, '--patch-out', patch]))\n";
+
+/// makes run `id` with Python and keeps its files in `<data>/rando/<title>/runs/<id>/`.
+/// Python works in the repo's `build/rando-make/<id>/` (the randomizer refuses to write
+/// inside %APPDATA%, where the owner's data folder is); the files are copied over after.
+pub fn make_run(data: &Path, id: &str, seed: &str, answer: &str) -> Result<PathBuf, String> {
+    let tool = find_tool()?;
+    let py = find_python()?;
+    let root = tool.parent().and_then(Path::parent).ok_or("tools/randomizer has no repo above it")?;
+    let work = root.join("build").join("rando-make").join(id);
+    let _ = std::fs::remove_dir_all(&work);
+    std::fs::create_dir_all(&work).map_err(|e| format!("{}: {e}", work.display()))?;
+    let answer_path = work.join("answer.json");
+    std::fs::write(&answer_path, answer).map_err(|e| e.to_string())?;
+    let (out, patch, options) = (work.join("mod"), work.join("patch.txt"), work.join("options.json"));
+    let args: Vec<&std::ffi::OsStr> = vec!["-c".as_ref(), MAKE_SCRIPT.as_ref(), tool.as_os_str(), answer_path.as_os_str(),
+                                            out.as_os_str(), patch.as_os_str(), seed.as_ref(), options.as_os_str()];
+    let (cmd, _) = python_command(&py, &args);
+    log::info!("fates_rando: making {id} with {:?}", py.program);
+    let (code, lines) = run_hidden(cmd, MAKE_TIMEOUT).map_err(|e| format!("the randomizer: {e}"))?;
+    if code != 0 || !patch.is_file() {
+        let tail: Vec<&str> = lines.iter().rev().take(4).rev().map(String::as_str).collect();
+        return Err(format!("the randomizer stopped (exit {code}): {}", tail.join(" | ")));
+    }
+    let dir = run_dir(data, id);
+    std::fs::create_dir_all(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let mut keep = vec![(options.clone(), "options.json".to_string())];
+    let mut found = HashMap::new();
+    find_files(&out, &mut found, 3);
+    for name in ["spoiler.txt", "plan.json"] {
+        if let Some(p) = found.get(name) {
+            keep.push((p.clone(), name.to_string()));
+        }
+    }
+    for (from, name) in keep {
+        let _ = std::fs::copy(&from, dir.join(&name));
+    }
+    // the patch last, written whole then renamed: its presence means the run is complete
+    let tmp = dir.join("patch.txt.tmp");
+    std::fs::copy(&patch, &tmp).map_err(|e| e.to_string())?;
+    std::fs::rename(&tmp, dir.join("patch.txt")).map_err(|e| e.to_string())?;
+    Ok(dir)
+}
+
+fn find_files(dir: &Path, found: &mut HashMap<String, PathBuf>, depth: u32) {
+    let Ok(entries) = std::fs::read_dir(dir) else { return };
+    for e in entries.flatten() {
+        let p = e.path();
+        if p.is_dir() && depth > 0 {
+            find_files(&p, found, depth - 1);
+        } else if let Some(name) = p.file_name().and_then(|n| n.to_str()) {
+            found.entry(name.to_string()).or_insert(p);
+        }
+    }
+}
