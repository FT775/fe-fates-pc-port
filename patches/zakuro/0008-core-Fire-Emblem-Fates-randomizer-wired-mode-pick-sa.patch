+        let (cmd, flags) = python_command(&py, &["--version".as_ref()]);
+        if cfg!(windows) {
+            assert_eq!(flags, 0x0800_0000, "CREATE_NO_WINDOW");
+        } else {
+            assert_eq!(flags, 0);
+        }
+        assert_eq!(cmd.get_program(), "python");
+        assert_eq!(CREATE_NO_WINDOW, 0x0800_0000);
+    }
