+    #[test]
+    fn a_switch_drives_its_hidden_row() {
+        let mut form = form_for(SCHEMA_62B, None);
+        let row = form.rows.iter().find(|row| row.key == "stronger_weapons").unwrap().clone();
+        assert_eq!(form.value(&row), json!(false));
+        assert!(form.set("stronger_weapons", json!(true)));
+        assert_eq!(form.get("enemy_upgrade"), &json!(25));
+        assert_eq!(form.value(&row), json!(true));
+        assert!(form.set("stronger_weapons", json!(false)));
+        assert_eq!(form.get("enemy_upgrade"), &json!(0));
+        // an old answer's own amount is kept while the switch stays on
+        form.restore(r#"{"enemy_upgrade": 50, "stronger_weapons": false}"#);
+        assert_eq!(form.get("enemy_upgrade"), &json!(50));
+        assert!(form.set("stronger_weapons", json!(true)));
+        assert_eq!(form.get("enemy_upgrade"), &json!(50));
+        assert!(!form.set("stronger_weapons", json!("yes")));
+        // This run shows the switch, not the hidden row
+        form.set("randomizer", json!(true));
+        let a = form.answers_preview("p");
+        assert_eq!(RandoForm::changed(&a, &form.rows), vec!["Stronger enemy weapons: On"]);
+    }
