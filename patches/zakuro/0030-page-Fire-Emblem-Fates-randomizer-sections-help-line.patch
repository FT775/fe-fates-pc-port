+    #[test]
+    fn the_new_row_fields_are_read() {
+        let rows = parse_schema(SCHEMA_62B).unwrap();
+        let by = |key: &str| rows.iter().find(|row| row.key == key).unwrap().clone();
+        assert_eq!(by("classes").section.as_deref(), Some("Classes"));
+        assert!(by("classes").help.starts_with("On: people"));
+        assert!(by("growth_min").hidden && !by("growth_min").fixed);
+        assert!(by("spoiler_log").page_only && by("spoiler_log").drives.is_none());
+        assert_eq!(by("stronger_weapons").drives, Some(Drive { key: "enemy_upgrade".into(), off: json!(0), on: json!(25) }));
+        assert!(by("promotions").switch);
+        assert_eq!(by("children").hide_for.get("seal").map(String::as_str), Some("no child in Seal of Flames"));
+        assert_eq!(by("growth_mode").shown(&json!("slice1")), "Shuffle (same total)");
+        assert_eq!(by("growth_mode").shown(&json!("delta")), "Nudge each");
+        // an old schema (no new fields) still reads, with nothing hidden
+        assert!(parse_schema(SCHEMA_62).unwrap().iter().all(|row| !row.hidden && !row.page_only && row.help.is_empty()));
+    }
