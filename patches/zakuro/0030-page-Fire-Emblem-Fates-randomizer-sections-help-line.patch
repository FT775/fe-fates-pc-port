+    #[test]
+    fn old_answers_give_the_same_text_on_the_new_page() {
+        // round 62b, seeds unchanged: what the round-62 page answered for a saved choice is
+        // exactly what the new page answers (same text, so the same run id)
+        let saved = [
+            r#"{"randomizer": true, "seed": "s1"}"#,
+            r#"{"randomizer": true, "seed": "s2", "promotions": "on", "growth_mode": "full", "growth_min": 10, "enemy_upgrade": 50, "children": true}"#,
+            r#"{"randomizer": true, "seed": "s3", "classes": false, "nuzlocke": true, "enemy_upgrade": 25}"#,
+            r#"{"randomizer": false, "classes": false}"#,
+        ];
+        for game in [None, Some("seal")] {
+            for text in saved {
+                let mut old = form_for(SCHEMA_62, game);
+                old.restore(text);
+                let mut new = form_for(SCHEMA_62B, game);
+                new.restore(text);
+                assert_eq!(new.answers_preview("p").to_string(), old.answers_preview("p").to_string(), "{game:?} {text}");
+                // the spoiler switch never changes the answer
+                new.set("spoiler_log", json!(false));
+                assert_eq!(new.answers_preview("p").to_string(), old.answers_preview("p").to_string(), "{game:?} {text}");
+                let id = |form: &RandoForm| zakuro_core::fates_rando_session::run_id_for(&form.answers_preview("p").to_string(), game);
+                if old.on() {
+                    assert_eq!(id(&new).unwrap(), id(&old).unwrap());
+                }
+            }
+        }
+    }
