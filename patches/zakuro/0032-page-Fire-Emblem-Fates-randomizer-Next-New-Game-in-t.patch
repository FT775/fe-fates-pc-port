+    /// round 71: the script opens the Esc Randomizer window, sets a row in Next New Game,
+    /// presses Keep, checks last.json and closes the window, with the New Game page closed
+    /// (Randomizer stays off, so no background make starts in a test).
+    #[test]
+    fn the_robot_keeps_a_next_new_game_value_from_the_esc_window() {
+        let dir = std::env::temp_dir().join(format!("zakuro-r71-pagebot-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let log = dir.join("pagebot.jsonl");
+        let mut bot = bot(json!([
+            {"esc": "randomizer"},
+            {"wait": "next_open"},
+            {"click": "next:opt:classes=off"},
+            {"click": "next:btn:keep"},
+            {"expect_last": {"randomizer": false, "classes": false}},
+            {"expect": {"randomizer": false}},
+            {"esc": "close"}
+        ]), &log);
+        let mut page = RandoPage::with_rows(parse_schema(SCHEMA).unwrap());
+        for frame in 0..400 {
+            bot.frame(&mut page, Some(&dir), frame);
+            if bot.finished() {
+                break;
+            }
+        }
+        assert!(bot.finished());
+        assert!(!page.this_run_open && !page.new_game, "the window closed, the page never opened");
+        let kept: Value = serde_json::from_str(&std::fs::read_to_string(last_path(&dir)).unwrap()).unwrap();
+        assert_eq!(kept["randomizer"], json!(false));
+        assert_eq!(kept["classes"], json!(false));
+        assert!(page.prebuild.is_none(), "Randomizer off: no background make");
+        drop(bot);
+        let events: Vec<Value> = std::fs::read_to_string(&log).unwrap().lines().map(|l| serde_json::from_str(l).unwrap()).collect();
+        let named = |name: &str| events.iter().filter(|e| e["event"] == name).cloned().collect::<Vec<_>>();
+        assert_eq!(named("esc").len(), 2);
+        assert_eq!(named("click").len(), 2);
+        assert!(named("expect_last")[0]["ok"].as_bool().unwrap(), "{events:?}");
+        assert_eq!(named("expect_last")[0]["note"], json!("Kept for the next New Game."));
+        assert!(named("expect")[0]["ok"].as_bool().unwrap(), "{events:?}");
+        assert!(named("unknown_step").is_empty());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
