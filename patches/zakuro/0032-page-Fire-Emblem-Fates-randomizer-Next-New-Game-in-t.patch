+pub fn everything_note(turned: &[String]) -> String {
+    match turned.len() {
+        0 => "Randomize everything: nothing more to turn on.".to_owned(),
+        1 => "Randomize everything turned on 1 setting. This run lists it after Start.".to_owned(),
+        n => format!("Randomize everything turned on {n} settings. This run lists them after Start."),
