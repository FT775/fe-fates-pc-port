+
+/// the help line's text: the note, else the pointed row's one sentence, else the resting line.
+fn help_text(form: &RandoForm, key: Option<&String>, note: Option<&String>) -> String {
+    note.cloned()
+        .or_else(|| key
+            .and_then(|key| form.rows.iter().find(|row| &row.key == key))
+            .filter(|row| !row.help.is_empty())
+            .map(|row| format!("{}: {}", row.label, row.help)))
+        .unwrap_or_else(|| HELP_REST.to_owned())
+}
+
+/// round 71: the help line, always exactly two text rows high: wrapped at word breaks, cut
+/// with an ellipsis after the second row, the full text when the pointer rests on it. The
+/// buttons under it never move, whatever it says (docs/rando/FULL_SWAP_PLAN.md 6.5).
+pub fn help_line(ui: &mut egui::Ui, text: &str) -> egui::Response {
+    let font = egui::TextStyle::Body.resolve(ui.style());
+    let colour = Color32::from_rgb(230, 220, 170);
+    let width = ui.available_width().max(40.0);
+    let mut job = egui::text::LayoutJob::simple(text.to_owned(), font.clone(), colour, width);
+    job.wrap.max_rows = 2;
+    job.wrap.break_anywhere = false;
+    job.wrap.overflow_character = Some('\u{2026}');
+    let galley = ui.fonts_mut(|fonts| fonts.layout_job(job));
+    let height = 2.0 * ui.fonts_mut(|fonts| fonts.row_height(&font));
+    let (rect, response) = ui.allocate_exact_size(Vec2::new(width, height), egui::Sense::hover());
+    let elided = galley.elided;
+    ui.painter_at(rect).galley(rect.min, galley, colour);
+    if elided {
+        response.on_hover_text(text)
+    } else {
+        response
+    }
+}
