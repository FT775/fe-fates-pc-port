+/// round 71: writes the form's values to `<data>/rando/last.json`, the one writer of that
+/// file (Start game of a randomized game, and the Esc window's Keep for next New Game).
+pub fn write_last(data: &Path, form: &RandoForm) -> Result<(), String> {
+    let path = last_path(data);
+    let text = serde_json::to_string_pretty(&Value::Object(form.values.clone())).unwrap_or_default();
+    path.parent()
+        .map_or(Ok(()), std::fs::create_dir_all)
+        .and_then(|()| std::fs::write(&path, text))
+        .map_err(|error| format!("{} could not be written: {error}", path.display()))
+}
