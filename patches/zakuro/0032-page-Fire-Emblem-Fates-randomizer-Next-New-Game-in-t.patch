+    #[test]
+    fn a_long_help_line_is_cut_to_two_rows() {
+        let ctx = egui::Context::default();
+        let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, Vec2::new(400.0, 300.0));
+        let long = "word ".repeat(200);
+        let mut heights = Vec::new();
+        for text in ["Short.", long.as_str()] {
+            let input = egui::RawInput { screen_rect: Some(screen), ..Default::default() };
+            ctx.run_ui(input, |ui| {
+                let height = help_line(ui, text).rect.height();
+                let font = egui::TextStyle::Body.resolve(ui.style());
+                let row = ui.fonts_mut(|f| f.row_height(&font));
+                assert_eq!(height, 2.0 * row);
+                heights.push(height);
+                let mut job = egui::text::LayoutJob::simple(text.to_owned(), font, Color32::WHITE, 380.0);
+                job.wrap.max_rows = 2;
+                job.wrap.overflow_character = Some('\u{2026}');
+                let galley = ui.fonts_mut(|f| f.layout_job(job));
+                assert!(galley.rows.len() <= 2);
+                assert_eq!(galley.elided, text.len() > 100);
+            })
+            .drop_without_applying_deltas();
+        }
+        assert_eq!(heights[0], heights[1]);
+    }
