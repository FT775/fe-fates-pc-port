+//! The Fates port's page robot hook (round 61; tools/harness/pagebot.py, docs/tests/PAGEBOT.md).
+//!
+//! With FEF_PAGEBOT=<script.json> and FEF_PAGEBOT_LOG=<file> in a `--headless` run of Fire
+//! Emblem Fates, the mode pick waits for the Randomizer page as it does with a window, the
+//! real page (rando_page.rs, its own rows, background make, throw-away, Start game and
+//! clean-up) is drawn each frame into an egui context that has no window, and the script's
+//! clicks are real pointer events at the rectangles the page's controls reported. While the
+//! page is open the game waits, as with a window. One JSON line per event goes to the log.
+//! When the script's last step is done the run ends by itself.
+//!
+//! Nothing here runs without FEF_PAGEBOT: the program does exactly what it did before.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use serde_json::{json, Value};
+
+use crate::rando_page::{PageAction, RandoPage};
+
+/// page frames (at 60 a second) the page may stay open before the run gives up: 10 minutes.
+pub const PAGE_FRAMES_MAX: u64 = 60 * 600;
+
+/// page frames the page is drawn before the script's first step after it opened (egui sizes
+/// a new window in its first frames; the rectangles are final after that).
+const SETTLE_FRAMES: u32 = 5;
+
+pub struct PageBot {
+    steps: Vec<Value>,
+    next: usize,
+    ctx: egui::Context,
+    log: std::fs::File,
+    started: Instant,
+    pending: Vec<egui::Event>,
+    release: Option<egui::Pos2>,
+    time: f64,
+    last_prebuild: Option<(String, bool)>,
+    open_frames: u32,
+    /// the click target looked for and its rectangle last frame: a click goes out only at a
+    /// rectangle that stayed the same for two frames (a choice list's first frame is a sizing
+    /// pass, drawn elsewhere and not clickable)
+    seen: Option<(String, egui::Rect)>,
+    /// page frames drawn while the page was open (the game waited)
+    pub page_frames: u64,
+    /// game frames from the lay to the avatar creator (pagebot.py's calibration)
+    avatar_after: Option<u64>,
+    /// the game frame the core laid the randomized game (or went on with the original)
+    pub laid_at: Option<u64>,
+    /// the core's reply to the page's answer this frame (set by the program's rando())
+    pub answered: Option<Result<Option<String>, String>>,
+}
+
+impl PageBot {
+    /// the hook, when FEF_PAGEBOT names a readable script and FEF_PAGEBOT_LOG a writable file.
+    pub fn from_env() -> Option<PageBot> {
+        let script = std::env::var_os("FEF_PAGEBOT")?;
+        let log_path = PathBuf::from(std::env::var_os("FEF_PAGEBOT_LOG")?);
+        let script: Value = match std::fs::read_to_string(&script).map_err(|e| e.to_string()).and_then(|t| serde_json::from_str(&t).map_err(|e| e.to_string())) {
+            Ok(script) => script,
+            Err(error) => {
+                log::warn!(target: "zakuro::pagebot", "FEF_PAGEBOT {script:?}: {error}");
+                return None;
+            }
+        };
+        let log = std::fs::File::create(&log_path).map_err(|e| log::warn!(target: "zakuro::pagebot", "{}: {e}", log_path.display())).ok()?;
+        let mut bot = PageBot {
+            steps: script["steps"].as_array().cloned().unwrap_or_default(),
+            next: 0,
+            ctx: egui::Context::default(),
+            log,
+            started: Instant::now(),
+            pending: Vec::new(),
+            release: None,
+            time: 0.0,
+            last_prebuild: None,
+            open_frames: 0,
+            seen: None,
+            page_frames: 0,
+            avatar_after: script["avatar_after"].as_u64(),
+            laid_at: None,
+            answered: None,
+        };
+        let n = bot.steps.len();
+        bot.event("hook", json!({"steps": n, "avatar_after": bot.avatar_after}));
+        Some(bot)
+    }
+
+    /// one line of the log: {"event": name, "ms": since the hook started, ...extra}.
+    pub fn event(&mut self, name: &str, extra: Value) {
+        let mut line = json!({"event": name, "ms": self.started.elapsed().as_millis() as u64});
+        if let (Some(o), Value::Object(e)) = (line.as_object_mut(), extra) {
+            o.extend(e);
+        }
+        let _ = writeln!(self.log, "{line}");
+        let _ = self.log.flush();
+    }
+
+    /// every step of the script is done.
+    pub fn finished(&self) -> bool {
+        self.next >= self.steps.len()
+    }
+
+    /// one page frame: the next script step, then the real page drawn with its events. Called
+    /// every frame, the page open or not (closed, the page only makes its early guess).
+    pub fn frame(&mut self, page: &mut RandoPage, data: Option<&Path>, game_frame: u64) -> Vec<PageAction> {
+        if page.new_game {
+            self.open_frames = self.open_frames.saturating_add(1);
+            self.page_frames += 1;
+        } else {
+            self.open_frames = 0;
+        }
+        let pb = page.prebuild.as_mut().map(|p| {
+            p.poll();
+            (p.id.clone(), p.result.is_some())
+        });
+        if pb != self.last_prebuild {
+            match &pb {
+                Some((id, true)) => {
+                    let ok = page.prebuild.as_ref().is_some_and(|p| matches!(p.result, Some(Ok(_))));
+                    let text = page.prebuild.as_ref().map(|p| p.text.clone()).unwrap_or_default();
+                    self.event("prebuild_done", json!({"id": id, "ok": ok, "text": text, "frame": game_frame}))
+                }
+                Some((id, false)) => {
+                    let text = page.prebuild.as_ref().map(|p| p.text.clone()).unwrap_or_default();
+                    self.event("prebuild_start", json!({"id": id, "text": text, "frame": game_frame}))
+                }
+                None => {}
+            }
+            self.last_prebuild = pb;
+        }
+        for id in std::mem::take(&mut page.thrown) {
+            self.event("discarded", json!({"id": id}));
+        }
+        if page.new_game {
+            self.step(page);
+        }
+        self.time += 1.0 / 60.0;
+        let mut events = std::mem::take(&mut self.pending);
+        if events.is_empty() {
+            if let Some(pos) = self.release.take() {
+                events.push(egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });
+            }
+        }
+        let input = egui::RawInput {
+            screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(800.0, 480.0))),
+            time: Some(self.time),
+            focused: true,
+            events,
+            ..Default::default()
+        };
+        let mut actions = Vec::new();
+        self.ctx
+            .run_ui(input, |ui| actions = page.draw_new_game(ui.ctx(), data))
+            .drop_without_applying_deltas();
+        actions
+    }
+
+    /// the waits that need no page frame (laid, avatar): called after every game frame.
+    pub fn tick(&mut self, game_frame: u64) {
+        let Some(step) = self.steps.get(self.next).cloned() else { return };
+        let done = match step["wait"].as_str() {
+            Some("laid") => self.laid_at.is_some(),
+            Some("avatar") => self.laid_at.zip(self.avatar_after).is_some_and(|(at, n)| game_frame >= at + n),
+            _ => false,
+        };
+        if done {
+            if step["wait"] == "avatar" {
+                self.event("avatar", json!({"frame": game_frame}));
+            } else {
+                self.event("wait_done", json!({"wait": step["wait"], "frame": game_frame}));
+            }
+            self.next += 1;
+        }
+    }
+
+    fn step(&mut self, page: &mut RandoPage) {
+        if self.release.is_some() || self.open_frames < SETTLE_FRAMES {
+            return; // a click's release goes out first; a new window settles first
+        }
+        let Some(step) = self.steps.get(self.next).cloned() else { return };
+        if let Some(w) = step["wait"].as_str() {
+            if w == "page_open" && page.rows_settled() && !page.has_rows() {
+                // no rows (no Python or no tool): the page offers only the original game; the
+                // script cannot go on, the run ends
+                self.event("rows_missing", json!({}));
+                self.next = self.steps.len();
+                return;
+            }
+            let done = match w {
+                "page_open" => page.has_rows() && page.targets.iter().any(|(k, _)| k == "btn:start"),
+                "prebuild_done" => page.prebuild.as_ref().is_some_and(|p| p.result.is_some()),
+                _ => false, // laid / avatar: tick()
+            };
+            if done {
+                self.event("wait_done", json!({"wait": w}));
+                self.next += 1;
+            }
+            return;
+        }
+        if let (Some(mark), None) = (step["mark"].as_str(), step.get("click")) {
+            self.event("mark", json!({"name": mark}));
+            self.next += 1;
+            return;
+        }
+        if let Some(target) = step["click"].as_str() {
+            // not drawn yet (a choice list opens the frame after its box is clicked): wait for it
+            let Some(rect) = page.targets.iter().rev().find(|(k, _)| k == target).map(|(_, r)| *r) else {
+                self.seen = None;
+                return;
+            };
+            let stable = self.seen.as_ref().is_some_and(|(k, r)| k == target && *r == rect);
+            self.seen = Some((target.to_owned(), rect));
+            if !stable {
+                return;
+            }
+            self.seen = None;
+            let pos = rect.center();
+            self.pending.push(egui::Event::PointerMoved(pos));
+            self.pending.push(egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });
+            self.release = Some(pos);
+            let values = page.values_text();
+            let mut extra = json!({"target": target, "x": pos.x, "y": pos.y, "values": values});
+            if let Some(mark) = step["mark"].as_str() {
+                extra["mark"] = Value::String(mark.to_owned());
+            }
+            if target == "btn:start" {
+                // the click acts in the next page frame: the values then are these unless the
+                // script changed something in between (it does not: the click is this step)
+                extra["page_values"] = Value::String(values);
+            }
+            self.event("click", extra);
+            self.next += 1;
+            return;
+        }
+        if step.get("expect").is_some() {
+            let values = page.values_text();
+            let parsed: Value = serde_json::from_str(&values).unwrap_or(Value::Null);
+            let ok = step["expect"].as_object().is_some_and(|want| want.iter().all(|(k, v)| parsed.get(k) == Some(v)));
+            self.event("expect", json!({"expect": step["expect"], "ok": ok, "values": values}));
+            self.next += 1;
+            return;
+        }
+        // a step this hook does not know: logged and skipped
+        self.event("unknown_step", json!({"step": step}));
+        self.next += 1;
+    }
+}
