+    /// round 61, the page robot hook: before a game frame, the page's frames while it is open
+    /// (the game waits, as with a window), each kept to the pace. False = the run ends (the
+    /// page stayed open too long).
+    fn pagebot_page(&mut self, pace: Option<f64>, ran: u64, paused: &mut Duration) -> bool {
+        let data = self.data_dir.clone();
+        let fps = pace.filter(|f| *f > 0.0).unwrap_or(60.0);
+        let opened = Instant::now();
+        let mut frames = 0u64;
+        loop {
+            let Some(mut bot) = self.pagebot.take() else { return true };
+            let actions = bot.frame(&mut self.menus.rando, data.as_deref(), ran);
+            self.pagebot = Some(bot);
+            self.rando(actions);
+            if !self.menus.rando.new_game {
+                break;
+            }
+            frames += 1;
+            if frames > pagebot::PAGE_FRAMES_MAX {
+                if let Some(bot) = &mut self.pagebot {
+                    bot.event("timeout", serde_json::json!({"page_frames": frames}));
+                }
+                return false;
+            }
+            let due = opened + Duration::from_secs_f64(frames as f64 / fps);
+            let now = Instant::now();
+            if due > now {
+                std::thread::sleep(due - now);
+            }
+        }
+        *paused += opened.elapsed();
+        true
+    }
