+    // ------------------------------------------------- round 82b: Seal of Flames hears the step
+
+    /// Seal of Flames as the port's frontend runs it: the Fates title id, the hooks on (F-047)
+    fn seal_hooks() -> bool {
+        crate::fates_rando_session::listens(Some(crate::fates_rando::TITLE), true, Some("seal"))
+    }
+
+    /// the trap laid at the defaults (no row set) for these hooks, as `after_frame` does
+    fn laid_for(hooks: bool) -> (Writer, Fake) {
+        let mut w = Writer::default();
+        let mut m = title();
+        assert!(!Helpers::default().any_new_game_row());
+        assert!(!w.jumped(1));
+        let s = w.word_step(&mut m, trap_wanted(false, hooks), false);
+        assert_eq!(s, WordStep { now: Some(ORIGINAL_WORD), write: Some(TRAP_WORD), stranger: false },
+                   "the trap is laid at the defaults");
+        m.set_word(START_FROM_BEGINNING, TRAP_WORD);
+        (w, m)
+    }
+
+    /// one svc at the trap, passed on as `on_svc` does (to the randomizer only while it listens)
+    /// and taken at the frame's end (frame number `frame`)
+    fn svc_to(s: &mut crate::fates_rando_session::Session, m: &mut Fake, hooks: bool, frame: u64) -> (bool, bool) {
+        let o = svc_outcome(m, false, hooks, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK);
+        assert_eq!(o.pending, None, "no row set: nothing pending");
+        if hooks {
+            s.hear(frame, o.seen, o.refused.is_some());
+        }
+        s.take_heard(frame)
+    }
+
+    #[test]
+    fn a_seal_classic_new_game_is_heard_at_the_trap_and_picks_once() {
+        use crate::fates_rando_session::{Pick, Session};
+        let hooks = seal_hooks();
+        assert!(hooks, "Seal listens (round 82b S1)");
+        let (_w, mut m) = laid_for(hooks);
+        for interactive in [false, true] {
+            let mut s = Session::default();
+            s.interactive = interactive;
+            assert_eq!(s.frame(&mut m), Pick::None);
+            // Normal + Classic: word +0x4 stays at its reset value; the watch alone misses it
+            let before = block_bytes(&m);
+            let (seen, refused) = svc_to(&mut s, &mut m, hooks, 2);
+            assert_eq!((seen, refused), (true, false), "the step heard on Seal");
+            let p = s.frame_heard(&mut m, seen, refused);
+            if interactive {
+                assert_eq!(p, Pick::Page, "the page opens once");
+            } else {
+                assert!(matches!(p, Pick::Answer(_)), "one pick: {p:?}");
+            }
+            for _ in 0..10 {
+                assert_eq!(s.frame(&mut m), Pick::None, "never a second pick");
+            }
+            assert!(s.notices.is_empty(), "no warning on a good pick");
+            assert_eq!(block_bytes(&m), before, "the pick reads only");
+        }
+        assert!(m.writes.is_empty(), "no guest byte written at the svc");
+    }
+
+    #[test]
+    fn a_seal_casual_new_game_heard_and_watched_in_one_frame_is_one_pick() {
+        use crate::fates_rando_session::{Pick, Session};
+        let hooks = seal_hooks();
+        let (_w, mut m) = laid_for(hooks);
+        let mut s = Session::default();
+        s.interactive = true;
+        assert_eq!(s.frame(&mut m), Pick::None);
+        // Normal + Casual: the svc hears the step and the mode word changes in the same frame
+        let (seen, refused) = svc_to(&mut s, &mut m, hooks, 2);
+        m.set_word(BLOCK + 4, 0x4001_5EDE);
+        assert_eq!(s.frame_heard(&mut m, seen, refused), Pick::Page);
+        let later: Vec<Pick> = (0..10).map(|_| s.frame(&mut m)).collect();
+        assert!(later.iter().all(|p| *p == Pick::None), "one pick, not two: {later:?}");
+        // the word's change one frame after the heard pick: the same New Game
+        let (_w, mut m) = laid_for(hooks);
+        let mut s = Session::default();
+        s.interactive = true;
+        s.frame(&mut m);
+        let (seen, refused) = svc_to(&mut s, &mut m, hooks, 2);
+        assert_eq!(s.frame_heard(&mut m, seen, refused), Pick::Page);
+        m.set_word(BLOCK + 4, 0x4001_5EDE);
+        assert_eq!(s.frame(&mut m), Pick::None, "the same New Game");
+        assert!(s.notices.is_empty());
+    }
+
+    #[test]
+    fn seal_with_the_randomizer_hooks_off_lays_no_trap_at_the_defaults() {
+        use crate::fates_rando_session::{Pick, Session};
+        let hooks = crate::fates_rando_session::listens(Some(crate::fates_rando::TITLE), false, Some("seal"));
+        assert!(!hooks, "Config::fates_rando false: Seal does not listen");
+        let mut w = Writer::default();
+        let mut m = title();
+        m.untouchable = true;
+        for f in 1..200 {
+            let j = w.jumped(f);
+            assert_eq!(w.word_step(&mut m, trap_wanted(false, hooks), j), WordStep::default(), "frame {f}");
+        }
+        // a svc there anyway (a state brought the word back): no check, no read, nothing heard
+        assert_eq!(svc_outcome(&mut m, false, hooks, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK),
+                   SvcOutcome::default());
+        m.untouchable = false;
+        assert_eq!(m.reads, 0);
+        assert!(m.writes.is_empty());
+        assert_eq!(m.word(START_FROM_BEGINNING), ORIGINAL_WORD);
+        // and the randomizer sees no pick and says nothing on Classic, as in round 81
+        let mut s = Session::default();
+        s.frame(&mut m);
+        let (seen, refused) = svc_to(&mut s, &mut m, hooks, 2);
+        assert_eq!(s.frame_heard(&mut m, seen, refused), Pick::None);
+        assert!(s.notices.is_empty());
+        assert_eq!(w.cannot_lay(false, hooks), CannotLay::default(), "no warning either");
+    }
+
+    #[test]
+    fn a_seal_refusal_or_a_trap_that_cannot_be_laid_is_said_once() {
+        use crate::fates_rando_session::{Pick, Session, CLASSIC_CANNOT, NOT_YOUR_SEED};
+        let hooks = seal_hooks();
+        // refused at the trap (a player army: not a New Game): no pick, the warning once
+        let (_w, mut m) = laid_for(hooks);
+        army(&mut m);
+        m.writes.clear();
+        let mut s = Session::default();
+        s.frame(&mut m);
+        let (seen, refused) = svc_to(&mut s, &mut m, hooks, 2);
+        assert_eq!((seen, refused), (false, true));
+        assert_eq!(s.frame_heard(&mut m, seen, refused), Pick::None, "refused: no pick");
+        assert_eq!(s.notices, vec![NOT_YOUR_SEED.to_string()]);
+        for f in 3..8 {
+            let (seen, refused) = svc_to(&mut s, &mut m, hooks, f);
+            assert_eq!(s.frame_heard(&mut m, seen, refused), Pick::None);
+        }
+        assert_eq!(s.notices.len(), 1, "said once");
+        assert!(m.writes.is_empty());
+        // a stranger word on Seal at the defaults: the randomizer's line once, never the rows'
+        let mut w = Writer::default();
+        let mut m = title();
+        m.set_word(START_FROM_BEGINNING, 0xE1A0_0000);
+        let st = w.word_step(&mut m, trap_wanted(false, hooks), false);
+        assert!(st.stranger);
+        assert_eq!(st.write, None, "a stranger word is left alone");
+        assert_eq!(w.cannot_lay(false, hooks), CannotLay { rows: false, rando: true });
+        assert_eq!(w.cannot_lay(false, hooks), CannotLay::default(), "once");
+        assert!(m.writes.is_empty());
+        assert!(CLASSIC_CANNOT.starts_with("Classic New Games cannot start the randomizer"));
+    }
+
