+//! Fire Emblem Fates: the growth view on the unit panel (round 62, owner pick F-049).
+//!
+//! On the bottom screen's unit panel (`ViewerUnitStatus`), Select (Tab on the keyboard, Back on
+//! a pad; the frontend calls `toggle`) or a touch on the panel's Growths button swaps the eight
+//! stat numbers for the unit's total growth percents (personal + class) and back. Move does not
+//! grow and keeps its number. It works for Fire Emblem Fates and for a mod on its title id (Seal
+//! of Flames), with the randomizer on or off: the percents are read from the tables in memory,
+//! so a randomized game shows its laid values.
+//!
+//! Nothing here writes guest memory. While the panel is not shown, Select and touches reach the
+//! game unchanged. Select and a touch on the Growths button are kept from the game only while the
+//! panel is shown (the game's own code never reads Select there: no recorded route presses it).
+//! The numbers are painted into the host's copy of the bottom picture (`System::read_screen_scaled`),
+//! only when the picture shows the panel (its book and grid buttons, checked pixel by pixel). On the
+//! full page the stat numbers are replaced in place; on the short ("Rating") page, which draws no
+//! stat numbers, a small table of the eight percents goes over the portrait's lower part.
+//!
+//! Game facts (ARM code of the game, read only, round 62 core track):
+//! - `ProcGameInfo` lives at `*0x006D526C` (`ProcGameInfo::Create` 0x001BBD90). Its byte +0x30 is the
+//!   viewer shown (`ProcGameInfo::ChangeViewer` 0x001BB7FC; `GetCurrentUnit` 0x001BBA4C): 1 = the
+//!   unit panel at +0x34, 2 = a second unit panel at +0x7E8, 3 = the situation view, 0 = none.
+//!   `ProcGameInfo::Tick` 0x001BBC68 skips every viewer while its words +0x1058 or +0x105C are above 0.
+//! - `ViewerUnitStatus::SetUnit` 0x001F5BC0 keeps the unit at +0x8 of the panel.
+//! - `Unit::GetGrow` 0x005330B4: Person (+0x9C) growth +0x40[s]; avatar (+0xB0 Edit): + boon
+//!   growth (Personality(+0x1A) +0x14[s]) + bane growth (Personality(+0x1B) +0x2C[s]); child
+//!   (+0xB4 Family, both records set, Person.family_index +0x2A set): (rate + parent's rate) / 2
+//!   toward zero (`unit::Family::GetGrow` 0x0053B6CC, `ParentSingle::GetGrow` 0x0053B740); then
+//!   + Job (+0xA0) growth +0x24[s] when Person.unit_kind (+0x34) is 1, else enemy growth +0x2C[s];
+//!   + 10 with the Aptitude skill (not shown here: the owner's view is personal + class).
+//! - `Personality::Get` 0x001A0B1C: `*0x006D3B98 + 0x40 * i`. `Person::Get(u16)` 0x0044A6F8: the
+//!   block list at `*0x006D3B28`. `Person::IsFemale` 0x0053ED90: Person's first 8 bytes and the
+//!   mask cached at 0x006D3B70 (made once, guard bit 0 of 0x006D3B2C).
+
+use crate::fates_rando::Guest;
+use crate::services::hid::{InputState, PadState};
+
+pub const PROC_GAME_INFO: u32 = 0x006D_526C;
+const PERSONALITY: u32 = 0x006D_3B98;
+const PERSON_LIST: u32 = 0x006D_3B28;
+const FEMALE_GUARD: u32 = 0x006D_3B2C;
+const FEMALE_MASK: u32 = 0x006D_3B70;
+
+/// the stat order of the game: hp, str, mag, skl, spd, lck, def, res.
+pub const STATS: usize = 8;
+
+/// where each stat's number is on the bottom screen (native 320x240): (left, top, right, bottom),
+/// right-aligned digits. HP is the big current-HP number.
+const HP_BOX: (u32, u32, u32, u32) = (149, 25, 227, 52);
+const SMALL: [(u32, u32); 7] = [
+    // (column right edge, row top) for str, mag, skl, spd, lck, def, res
+    (52, 163), (52, 180), (52, 197), (102, 163), (102, 180), (102, 197), (102, 214),
+];
+/// the Growths button (native): left, top, right, bottom.
+pub const BUTTON: (u16, u16, u16, u16) = (2, 146, 50, 159);
+
+const CREAM: [u8; 3] = [255, 233, 167];
+
+#[derive(Debug, Default)]
+pub struct GrowthView {
+    /// the view is on: the panel shows growths
+    pub on: bool,
+    select_held: bool,
+    touch_held: bool,
+    /// times the view was switched (for tests and the robot's log)
+    pub toggles: u32,
+}
+
+/// the unit on the panel while the game shows the unit panel, or None.
+pub fn panel_unit(g: &mut dyn Guest) -> Option<u32> {
+    let info = g.r32(PROC_GAME_INFO).filter(|&p| p != 0)?;
+    if !g.readable(info.wrapping_add(0x30), 1) {
+        return None;
+    }
+    let mut kind = [0u8; 1];
+    g.read(info.wrapping_add(0x30), &mut kind);
+    let viewer = match kind[0] {
+        1 => info.wrapping_add(0x34),
+        2 => info.wrapping_add(0x7E8),
+        _ => return None,
+    };
+    let busy = |g: &mut dyn Guest, off: u32| g.r32(info.wrapping_add(off)).map(|v| v as i32 > 0).unwrap_or(true);
+    if busy(g, 0x1058) || busy(g, 0x105C) {
+        return None;
+    }
+    let unit = g.r32(viewer.wrapping_add(8)).filter(|&u| u != 0)?;
+    // a unit has its person and its class
+    g.r32(unit.wrapping_add(0x9C)).filter(|&p| p != 0)?;
+    g.r32(unit.wrapping_add(0xA0)).filter(|&j| j != 0)?;
+    Some(unit)
+}
+
+fn s8(g: &mut dyn Guest, addr: u32) -> Option<i32> {
+    if !g.readable(addr, 1) {
+        return None;
+    }
+    let mut b = [0u8; 1];
+    g.read(addr, &mut b);
+    Some(b[0] as i8 as i32)
+}
+
+fn u8_(g: &mut dyn Guest, addr: u32) -> Option<u32> {
+    s8(g, addr).map(|v| v as u8 as u32)
+}
+
+fn u16_(g: &mut dyn Guest, addr: u32) -> Option<u32> {
+    if !g.readable(addr, 2) {
+        return None;
+    }
+    let mut b = [0u8; 2];
+    g.read(addr, &mut b);
+    Some(u16::from_le_bytes(b) as u32)
+}
+
+fn personality(g: &mut dyn Guest, i: u32) -> Option<u32> {
+    g.r32(PERSONALITY).filter(|&t| t != 0).map(|t| t.wrapping_add(i << 6))
+}
+
+/// `Person::Get(u16)`: the record of index i in the block list (the first block's first record
+/// when no block holds it, as the game).
+pub fn person_get(g: &mut dyn Guest, i: u32) -> Option<u32> {
+    let head = g.r32(PERSON_LIST).filter(|&h| h != 0)?;
+    let mut node = head;
+    for _ in 0..64 {
+        let block = g.r32(node)?;
+        let first = u16_(g, block.wrapping_add(0x34))?;
+        let count = u16_(g, block.wrapping_add(4))?;
+        if i >= first && i < first + count {
+            return Some(block.wrapping_add(0x10 + 0x98 * (i - first)));
+        }
+        match g.r32(node.wrapping_add(8)) {
+            Some(next) if next != 0 => node = next,
+            _ => break,
+        }
+    }
+    g.r32(head).map(|b| b.wrapping_add(0x10))
+}
+
+/// `Person::IsFemale`: None when the game has not made its mask yet.
+fn is_female(g: &mut dyn Guest, person: u32) -> Option<bool> {
+    let guard = g.r32(FEMALE_GUARD)?;
+    if guard & 1 == 0 {
+        return None;
+    }
+    let lo = g.r32(FEMALE_MASK)?;
+    let hi = g.r32(FEMALE_MASK + 4)?;
+    let a = g.r32(person)?;
+    let b = g.r32(person.wrapping_add(4))?;
+    Some(a & lo != 0 || b & hi != 0)
+}
+
+/// `unit::Family::ParentSingle::GetGrow`: one parent record's rate for stat s (never below 0).
+fn parent_single(g: &mut dyn Guest, rec: u32, s: u32) -> Option<i32> {
+    let p = g.r32(rec)?;
+    if p == 0 {
+        return Some(0);
+    }
+    let (bi, ni) = (u8_(g, rec.wrapping_add(5))?, u8_(g, rec.wrapping_add(4))?);
+    let bane = personality(g, bi)?;
+    let boon = personality(g, ni)?;
+    let mut v = s8(g, boon + 0x14 + s)? + s8(g, p + 0x40 + s)? + s8(g, bane + 0x2C + s)?;
+    let (g1, g2) = (g.r32(rec.wrapping_add(8))?, g.r32(rec.wrapping_add(12))?);
+    let fidx = u16_(g, p + 0x2A)?;
+    if g1 != 0 && g2 != 0 && fidx != 0 {
+        if let Some(fixed) = person_get(g, fidx) {
+            let gp = if is_female(g, fixed)? { g1 } else { g2 };
+            let x = s8(g, gp + 0x40 + s)? + v;
+            v = x / 2; // toward zero, as the game's (x + (x >>> 31)) >> 1
+        }
+    }
+    Some(v.max(0))
+}
+
+/// the unit's total growth for stat s: personal (with the avatar's boon and bane, and a child's
+/// parent average) + class, as `Unit::GetGrow` without the Aptitude skill.
+pub fn total_growth(g: &mut dyn Guest, unit: u32, s: u32) -> Option<i32> {
+    let person = g.r32(unit.wrapping_add(0x9C)).filter(|&p| p != 0)?;
+    let job = g.r32(unit.wrapping_add(0xA0)).filter(|&j| j != 0)?;
+    let mut rate = s8(g, person + 0x40 + s)?;
+    let edit = g.r32(unit.wrapping_add(0xB0))?;
+    if edit != 0 {
+        let (ni, bi) = (u8_(g, edit + 0x1A)?, u8_(g, edit + 0x1B)?);
+        let boon = personality(g, ni)?;
+        let bane = personality(g, bi)?;
+        rate += s8(g, boon + 0x14 + s)? + s8(g, bane + 0x2C + s)?;
+    }
+    let fam = g.r32(unit.wrapping_add(0xB4))?;
+    if fam != 0 {
+        let (r0, r1) = (g.r32(fam)?, g.r32(fam + 0x14)?);
+        let fidx = u16_(g, person + 0x2A)?;
+        if r0 != 0 && r1 != 0 && fidx != 0 {
+            if let Some(fixed) = person_get(g, fidx) {
+                let rec = if is_female(g, fixed)? { fam } else { fam + 0x14 };
+                let x = parent_single(g, rec, s)? + rate;
+                rate = x / 2;
+            }
+        }
+    }
+    let kind = u8_(g, person + 0x34)?;
+    rate += s8(g, job + if kind == 1 { 0x24 } else { 0x2C } + s)?;
+    Some(rate)
+}
+
+/// all eight totals of the unit.
+pub fn totals(g: &mut dyn Guest, unit: u32) -> Option<[i32; STATS]> {
+    let mut out = [0; STATS];
+    for (s, v) in out.iter_mut().enumerate() {
+        *v = total_growth(g, unit, s as u32)?;
+    }
+    Some(out)
+}
+
+fn in_button((x, y): (u16, u16)) -> bool {
+    x >= BUTTON.0 && x <= BUTTON.2 && y >= BUTTON.1 && y <= BUTTON.3
+}
+
+impl GrowthView {
+    /// switches the view (the frontend's Tab); true when the panel is shown and it switched.
+    pub fn toggle(&mut self, g: &mut dyn Guest) -> bool {
+        if panel_unit(g).is_none() {
+            return false;
+        }
+        self.on = !self.on;
+        self.toggles += 1;
+        log::info!("growth view {}", if self.on { "on" } else { "off" });
+        true
+    }
+
+    /// the input the game gets: while the panel is shown, a Select press or a touch on the
+    /// Growths button switches the view and is kept from the game (held until let go).
+    pub fn filter_input(&mut self, g: &mut dyn Guest, input: &mut InputState) {
+        let select = input.buttons.contains(PadState::SELECT);
+        let touch_in = input.touch.is_some_and(in_button);
+        let fresh_select = select && !self.select_held;
+        let fresh_touch = touch_in && !self.touch_held && input.touch.is_some();
+        let wanted = (select && self.select_held) || (input.touch.is_some() && self.touch_held) || fresh_select || fresh_touch;
+        if !wanted {
+            self.select_held = false;
+            self.touch_held = false;
+            return;
+        }
+        if fresh_select || fresh_touch {
+            if self.toggle(g) {
+                self.select_held |= fresh_select;
+                self.touch_held |= fresh_touch;
+            }
+        }
+        if !select {
+            self.select_held = false;
+        }
+        if input.touch.is_none() {
+            self.touch_held = false;
+        }
+        if self.select_held {
+            input.buttons.remove(PadState::SELECT);
+        }
+        if self.touch_held {
+            input.touch = None;
+        }
+    }
+
+    /// paints the Growths button, and the percents while the view is on, into the bottom
+    /// picture (RGBA, `width` x `height`, a whole multiple of 320 x 240), only when the picture
+    /// shows the panel's stat block. True when it painted.
+    pub fn paint(&self, g: &mut dyn Guest, pixels: &mut [u8], width: u32, height: u32) -> bool {
+        let scale = width / 320;
+        if scale == 0 || height / 240 != scale || pixels.len() < (width * height * 4) as usize {
+            return false;
+        }
+        let Some(unit) = panel_unit(g) else { return false };
+        let mut pic = Pic { px: pixels, width, scale };
+        if !pic.shows_frame() {
+            return false;
+        }
+        let full = pic.shows_panel();
+        if self.on && !full {
+            // the short page (the game's "Rating" page draws no stat numbers): a small table of
+            // the eight percents over the portrait's lower part
+            let Some(t) = totals(g, unit) else { return false };
+            pic.table(&t);
+        } else if self.on {
+            let Some(t) = totals(g, unit) else { return false };
+            // HP: the big number, as "NN%"
+            pic.clear(HP_BOX, 148);
+            let text = format!("{}%", t[0]);
+            pic.text(&text, HP_BOX.2 - 2, HP_BOX.1 + 3, 3, CREAM, true);
+            for (i, &(right, top)) in SMALL.iter().enumerate() {
+                let left = right - 18;
+                pic.clear((left, top, right, top + 11), left);
+                pic.text(&t[i + 1].to_string(), right - 1, top + 2, 1, CREAM, true);
+            }
+        }
+        pic.button(self.on);
+        true
+    }
+}
+
+struct Pic<'a> {
+    px: &'a mut [u8],
+    width: u32,
+    scale: u32,
+}
+
+impl Pic<'_> {
+    fn at(&self, x: u32, y: u32) -> [u8; 3] {
+        let (x, y) = (x * self.scale + self.scale / 2, y * self.scale + self.scale / 2);
+        let i = ((y * self.width + x) * 4) as usize;
+        [self.px[i], self.px[i + 1], self.px[i + 2]]
+    }
+
+    fn set(&mut self, x: u32, y: u32, c: [u8; 3]) {
+        if x >= 320 || y >= 240 {
+            return;
+        }
+        for dy in 0..self.scale {
+            for dx in 0..self.scale {
+                let i = (((y * self.scale + dy) * self.width + x * self.scale + dx) * 4) as usize;
+                self.px[i..i + 3].copy_from_slice(&c);
+                self.px[i + 3] = 255;
+            }
+        }
+    }
+
+    /// the unit panel's frame: its book button and its grid button (both pages, every unit;
+    /// measured on robot pictures of round 62, Fates and Seal of Flames).
+    fn shows_frame(&self) -> bool {
+        let near = |c: [u8; 3], w: [u8; 3]| c.iter().zip(w).all(|(&a, b)| a.abs_diff(b) <= 14);
+        [((296, 222), [141, 75, 17]), ((316, 236), [145, 62, 13]), ((300, 218), [255, 223, 157]),
+         ((312, 224), [255, 233, 165]), ((306, 228), [249, 200, 142]), ((20, 222), [245, 179, 129]),
+         ((30, 228), [230, 172, 123]), ((14, 218), [161, 79, 21])]
+            .iter()
+            .all(|&((x, y), w)| near(self.at(x, y), w))
+    }
+
+    /// the eight percents as a table (the short page): HP Str Mag Skl | Spd Lck Def Res.
+    fn table(&mut self, t: &[i32; STATS]) {
+        let (l, top, r, b) = (2u32, 161u32, 108u32, 209u32);
+        for y in top..=b {
+            for x in l..=r {
+                let edge = y == top || y == b || x == l || x == r;
+                self.set(x, y, if edge { CREAM } else { [92, 52, 24] });
+            }
+        }
+        let names = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Res"];
+        for (i, name) in names.iter().enumerate() {
+            let (col, row) = ((i / 4) as u32, (i % 4) as u32);
+            let y = top + 4 + 11 * row;
+            self.text(name, l + 4 + 53 * col, y, 1, CREAM, false);
+            self.text(&t[i].to_string(), l + 50 + 53 * col, y, 1, CREAM, true);
+        }
+    }
+
+    /// the panel's stat block: its labels' cream strokes and its boxes' orange (both stay the
+    /// same for every unit; measured on robot pictures of rounds 60-61).
+    fn shows_panel(&self) -> bool {
+        let cream = |c: [u8; 3]| c[0] >= 235 && c[1] >= 200 && c[2] >= 130 && c[2] <= 200;
+        let orange = |c: [u8; 3]| c[0] >= 170 && c[0] <= 225 && c[1] >= 95 && c[1] <= 140 && c[2] <= 75;
+        let labels = [(10, 164), (58, 215), (59, 215), (7, 185), (12, 185), (58, 198), (59, 198)];
+        let boxes = [(30, 168), (80, 168), (30, 202), (80, 219), (30, 185), (80, 185)];
+        labels.iter().all(|&(x, y)| cream(self.at(x, y))) && boxes.iter().all(|&(x, y)| orange(self.at(x, y)))
+    }
+
+    /// fills each line of the box with the colour at its column `from` (the box's own shading).
+    fn clear(&mut self, (l, t, r, b): (u32, u32, u32, u32), from: u32) {
+        for y in t..=b {
+            let c = self.at(from, y);
+            for x in l..=r {
+                self.set(x, y, c);
+            }
+        }
+    }
+
+    /// text at the given right edge (or left when !right) and top, in 5x7 glyphs grown by `big`.
+    fn text(&mut self, s: &str, x: u32, top: u32, big: u32, c: [u8; 3], right: bool) {
+        let w = (s.chars().count() as u32 * 6).saturating_sub(1) * big;
+        let mut cx = if right { x + 1 - w } else { x };
+        for ch in s.chars() {
+            let rows = glyph(ch);
+            for (ry, row) in rows.iter().enumerate() {
+                for rx in 0..5 {
+                    if row & (0x10 >> rx) != 0 {
+                        for by in 0..big {
+                            for bx in 0..big {
+                                self.set(cx + rx * big + bx, top + ry as u32 * big + by, c);
+                            }
+                        }
+                    }
+                }
+            }
+            cx += 6 * big;
+        }
+    }
+
+    fn button(&mut self, on: bool) {
+        let (l, t, r, b) = (BUTTON.0 as u32, BUTTON.1 as u32, BUTTON.2 as u32, BUTTON.3 as u32);
+        let fill = if on { [196, 113, 39] } else { [92, 52, 24] };
+        for y in t..=b {
+            for x in l..=r {
+                let edge = y == t || y == b || x == l || x == r;
+                self.set(x, y, if edge { CREAM } else { fill });
+            }
+        }
+        self.text("Growths", l + 4, t + 3, 1, CREAM, false);
+    }
+}
+
+/// 5x7 glyphs, one byte per row, bit 4 = left column.
+fn glyph(c: char) -> [u8; 7] {
+    match c {
+        '0' => [0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E],
+        '1' => [0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E],
+        '2' => [0x0E, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1F],
+        '3' => [0x1F, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0E],
+        '4' => [0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02],
+        '5' => [0x1F, 0x10, 0x1E, 0x01, 0x01, 0x11, 0x0E],
+        '6' => [0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E],
+        '7' => [0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08],
+        '8' => [0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E],
