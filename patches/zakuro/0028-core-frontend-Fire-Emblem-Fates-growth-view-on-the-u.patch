+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    #[derive(Default)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+    }
+
+    impl Fake {
+        fn put(&mut self, at: u32, data: &[u8]) {
+            self.blocks.insert(at, data.to_vec());
+        }
+        fn w32(&mut self, at: u32, v: u32) {
+            self.write(at, &v.to_le_bytes());
+        }
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, addr: u32, data: &[u8]) {
+            let (b, o) = self.find(addr, data.len() as u32).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + data.len()].copy_from_slice(data);
+        }
+    }
+
+    const INFO: u32 = 0x3000_0000;
+    const UNIT: u32 = 0x3100_0000;
+    const PERSON: u32 = 0x3200_0000;
+    const JOB: u32 = 0x3300_0000;
+    const PERS: u32 = 0x3400_0000;
+    const EDIT: u32 = 0x3500_0000;
+
+    /// a game with the unit panel up (kind 1), a playable unit (unit_kind 1)
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        m.put(0x006D_3000, &vec![0; 0x3000]); // globals 0x006D3000..0x006D6000
+        m.put(INFO, &vec![0; 0x1100]);
+        m.put(UNIT, &vec![0; 0x140]);
+        m.put(PERSON, &vec![0; 0x98]);
+        m.put(JOB, &vec![0; 0x100]);
+        m.put(PERS, &vec![0; 0x40 * 9]);
+        m.put(EDIT, &vec![0; 0x40]);
+        m.w32(PROC_GAME_INFO, INFO);
+        m.write(INFO + 0x30, &[1]);
+        m.w32(INFO + 0x34 + 8, UNIT);
+        m.w32(UNIT + 0x9C, PERSON);
+        m.w32(UNIT + 0xA0, JOB);
+        m.write(PERSON + 0x34, &[1]);
+        m.write(PERSON + 0x40, &[45, 50, 0, 40, 45, 45, 35, 25]);
+        m.write(JOB + 0x24, &[10, 15, 0, 10, 10, 5, 10, 5]);
+        m.write(JOB + 0x2C, &[60, 60, 60, 60, 60, 60, 60, 60]);
+        m.w32(PERSONALITY, PERS);
+        m
+    }
+
+    #[test]
+    fn the_total_is_personal_plus_class() {
+        let mut m = game();
+        assert_eq!(panel_unit(&mut m), Some(UNIT));
+        assert_eq!(totals(&mut m, UNIT), Some([55, 65, 0, 50, 55, 50, 45, 30]));
+        // an enemy (unit_kind 0) takes the class's enemy growths
+        m.write(PERSON + 0x34, &[0]);
+        assert_eq!(totals(&mut m, UNIT).unwrap()[2], 60);
+    }
+
+    #[test]
+    fn the_avatar_adds_boon_and_bane() {
+        let mut m = game();
+        m.w32(UNIT + 0xB0, EDIT);
+        m.write(EDIT + 0x1A, &[2]); // boon 2
+        m.write(EDIT + 0x1B, &[3]); // bane 3
+        m.write(PERS + 2 * 0x40 + 0x14 + 1, &[15]); // boon +15 str
+        m.write(PERS + 3 * 0x40 + 0x2C + 1, &[-5i8 as u8]); // bane -5 str
+        assert_eq!(total_growth(&mut m, UNIT, 1), Some(75));
+    }
+
+    #[test]
+    fn no_panel_no_view() {
+        let mut m = game();
+        m.write(INFO + 0x30, &[3]);
+        assert_eq!(panel_unit(&mut m), None);
+        m.write(INFO + 0x30, &[2]);
+        assert_eq!(panel_unit(&mut m), None); // the second panel holds no unit here
+        m.w32(INFO + 0x7E8 + 8, UNIT);
+        assert_eq!(panel_unit(&mut m), Some(UNIT));
+        m.w32(INFO + 0x1058, 1);
+        assert_eq!(panel_unit(&mut m), None);
+        let mut v = GrowthView::default();
+        assert!(!v.toggle(&mut m));
+        assert!(!v.on);
+    }
+
+    #[test]
+    fn select_switches_once_per_press_and_is_kept_from_the_game_only_on_the_panel() {
+        let mut m = game();
+        let mut v = GrowthView::default();
+        let press = |b: PadState| InputState { buttons: b, ..Default::default() };
+        let mut i = press(PadState::SELECT | PadState::A);
+        v.filter_input(&mut m, &mut i);
+        assert!(v.on);
+        assert_eq!(i.buttons, PadState::A);
+        let mut i = press(PadState::SELECT);
+        v.filter_input(&mut m, &mut i); // still held: no second switch
+        assert!(v.on);
+        assert!(i.buttons.is_empty());
+        let mut i = press(PadState::empty());
+        v.filter_input(&mut m, &mut i);
+        let mut i = press(PadState::SELECT);
+        v.filter_input(&mut m, &mut i);
+        assert!(!v.on);
+        assert_eq!(v.toggles, 2);
+        // no panel: Select reaches the game, nothing switches
+        let mut i = press(PadState::empty());
+        v.filter_input(&mut m, &mut i);
+        m.write(INFO + 0x30, &[0]);
+        let mut i = press(PadState::SELECT);
+        v.filter_input(&mut m, &mut i);
+        assert_eq!(i.buttons, PadState::SELECT);
+        assert!(!v.on);
+    }
+
+    #[test]
+    fn the_button_switches_and_its_touch_is_kept_from_the_game() {
+        let mut m = game();
+        let mut v = GrowthView::default();
+        let mut i = InputState { touch: Some((20, 150)), ..Default::default() };
+        v.filter_input(&mut m, &mut i);
+        assert!(v.on);
+        assert_eq!(i.touch, None);
+        // a touch elsewhere reaches the game
+        let mut i = InputState::default();
+        v.filter_input(&mut m, &mut i);
+        let mut i = InputState { touch: Some((200, 150)), ..Default::default() };
+        v.filter_input(&mut m, &mut i);
+        assert_eq!(i.touch, Some((200, 150)));
+        assert!(v.on);
+    }
+
+    #[test]
+    fn paints_only_over_the_panel() {
+        let mut m = game();
+        let v = GrowthView { on: true, ..Default::default() };
+        let mut px = vec![0u8; 320 * 240 * 4];
+        assert!(!v.paint(&mut m, &mut px, 320, 240)); // a black picture is not the panel
+        assert!(px.iter().all(|&b| b == 0));
+    }
+}
