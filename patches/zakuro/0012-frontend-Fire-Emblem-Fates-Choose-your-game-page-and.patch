+    /// the Esc menu's Switch game: stops the game playing and starts the other one in
+    /// this window (the same stop and start Reset makes, with the other game's data
+    /// folder and settings in between).
+    fn switch_game(&mut self, to: game_pick::Game) -> Result<(), String> {
+        if std::env::var_os("ZAKURO_RECORD").is_some() {
+            return Err("The game can't be switched while its inputs are being recorded.".into());
+        }
+        if self.room.is_some() || self.dlp_guest.is_some() {
+            return Err("Leave the room first: the game can't be switched while in one.".into());
+        }
+        let Some(rom) = self.game.as_ref().map(|game| game.path.clone()) else {
+            return Err("No game is playing.".into());
+        };
+        if to == game_pick::Game::Seal {
+            if let Some(why) = game_pick::seal_status(self.seal_profile.as_deref(), false).reason() {
+                return Err(format!("{}: {why}", game_pick::SEAL_NAME));
+            }
+        }
+        log::info!("switching to {}", to.name());
+        // the stop: the game and all that goes with it
+        self.game = None;
+        self.overlay_corner = None;
+        if let Some(audio) = &self.audio {
+            audio.clear();
+        }
+        self.dlp_guest = None;
+        self.wireless_reboot = None;
+        self.menus.rando.reset();
+        self.extras = Extras::default();
+        self.camera = None;
+        self.menus.menu_open = false;
+        self.pick.confirm = None;
+        self.keyboard.release();
+        self.apply_choice(to)?;
+        if self.options.headless.is_none() {
+            if let Some(file) = game_pick::choice_file() {
+                if let Err(error) = game_pick::write_choice(&file, to) {
+                    log::warn!("could not remember the game chosen in {}, {error}", file.display());
+                }
+            }
+        }
+        let started = self.play(&rom);
+        if let Err(error) = &started {
+            log::warn!("{error}");
+            if self.options.headless.is_none() {
+                // back to the page, nothing half switched
+                self.pick = game_pick::GamePick::new(self.seal_profile.clone(), false, to);
+                self.pick.error = Some(error.clone());
+                self.pick.open = true;
+            }
+        }
+        started
+    }
+
+    /// runs headless for this many frames, then reports. FEF_GAME_SWITCH_AT switches
+    /// to the other game at those frames (the Fates port's test hook, through
+    /// switch_game), and FEF_HEADLESS_REPORT writes what each boot was, with hashes of
+    /// FEF_HEADLESS_RANGES at FEF_HEADLESS_HASH_AT and at each switch and the end.
+    fn run_headless(&mut self, frames: u64, switches: &[u64]) {
+        let report = std::env::var_os("FEF_HEADLESS_REPORT").map(PathBuf::from);
+        let ranges = headless_ranges();
+        let hash_at = frame_list("FEF_HEADLESS_HASH_AT");
+        let mut records = Vec::new();
+        if report.is_some() {
+            records.push(self.headless_record("boot", 0, 0, &ranges));
+        }
+        let start = Instant::now();
+        let mut outcome = FrameOutcome::Completed;
+        let mut ran = 0;
+        let mut since = 0;
+        for frame in 0..frames {
+            if switches.contains(&frame) && frame > 0 {
+                if report.is_some() {
+                    records.push(self.headless_record("switch", frame, frame - since, &ranges));
+                }
+                if let Err(error) = self.switch_game(self.choice.other()) {
+                    println!("switch at frame {frame} failed: {error}");
+                    break;
+                }
+                since = frame;
+                if report.is_some() {
+                    records.push(self.headless_record("boot", frame, 0, &ranges));
+                }
+            }
+            let Some(game) = &mut self.game else { break };
+            // ZAKURO_REPLAY plays its inputs back headless too (a test run that gets past
+            // the title by itself, Fire Emblem Fates' randomizer test hook for one); a
+            // game switched to plays it from its start, as a fresh boot would
+            if let Some(replay) = game.replay.as_mut() {
+                game.system.set_input(replay.input(frame - since));
+            }
+            outcome = game.system.run_frame();
+            ran += 1;
+            if report.is_some() && hash_at.contains(&(frame + 1)) {
+                records.push(self.headless_record("at", frame + 1, frame + 1 - since, &ranges));
+            }
+            if outcome != FrameOutcome::Completed {
+                break;
+            }
+        }
+        if let Some(file) = &report {
+            records.push(self.headless_record("end", ran, ran - since.min(ran), &ranges));
+            let text = serde_json::to_string_pretty(&records).unwrap_or_default();
+            if let Err(error) = std::fs::write(file, text) {
+                println!("could not write {}: {error}", file.display());
+            }
+        }
+        let elapsed = start.elapsed();
+        let Some(game) = &mut self.game else { return };
+        let system = &mut game.system;
+        println!("{outcome:?} after {ran} frames in {elapsed:.2?}");
+        println!(
+            "{:.1} MIPS, {}",
+            system.cpu.cycles as f64 / elapsed.as_secs_f64() / 1e6,
+            system.status_line()
+        );
+        if !system.fatal_errors.is_empty() {
+            println!("fatal errors: {}", system.fatal_errors.join("; "));
+        }
+        for (thread, pc, hits) in system.hot_spots(10) {
+            println!("  hot {thread:<8} 0x{pc:08X} {hits}");
+        }
+    }
+
+    /// one record of FEF_HEADLESS_REPORT: the game, its data folder, the frame, whether
+    /// the randomizer may run, and the sha256 of each range of memory asked for.
+    fn headless_record(&mut self, event: &str, frame: u64, game_frame: u64, ranges: &[(u32, usize)]) -> serde_json::Value {
+        use sha2::{Digest, Sha256};
+        let choice = self.choice.word();
+        let data = self.data_dir.as_deref().map(|dir| dir.display().to_string());
+        let Some(game) = &mut self.game else {
+            return serde_json::json!({"event": event, "frame": frame, "choice": choice, "data_dir": data, "game": null});
+        };
+        let hashes: Vec<serde_json::Value> = ranges
+            .iter()
+            .map(|&(addr, len)| {
+                // page by page, unmapped pages as zeros, read without the fault
+                // note an unmapped read leaves, so the report changes nothing
+                let mut bytes = vec![0u8; len];
+                let mut done = 0usize;
+                while done < len {
+                    let at = addr.wrapping_add(done as u32);
+                    let chunk = (0x1000 - (at as usize & 0xFFF)).min(len - done);
+                    if game.system.memory.is_readable(at, chunk as u32) {
+                        game.system.memory.read_bytes(at, &mut bytes[done..done + chunk]);
+                    }
+                    done += chunk;
+                }
+                let digest = Sha256::digest(&bytes);
+                let hex: String = digest.iter().map(|byte| format!("{byte:02x}")).collect();
+                serde_json::json!({"addr": format!("0x{addr:08X}"), "len": len, "sha256": hex})
+            })
+            .collect();
+        serde_json::json!({
+            "event": event,
+            "frame": frame,
+            "game_frame": game_frame,
+            "choice": choice,
+            "data_dir": data,
+            "fates_rando": game.system.config.fates_rando,
+            "fatal_errors": game.system.fatal_errors.len(),
+            "hashes": hashes,
+        })
     }
 
