+                game_pick::put_bits(&mut self.settings, game_pick::load_seal_bits(profile));
+            }
+        }
+        if data != self.data_dir {
+            if let Some(dir) = &data {
+                report::to_file(dir);
+            }
+            self.library.set_data_dir(data.clone());
+            self.data_dir = data;
+        }
+        self.choice = game;
+        self.active = self.settings.clone();
+        self.menus.rando_blocked = game != game_pick::Game::Fates;
+        self.menus.seal_playing = game == game_pick::Game::Seal;
+        let to = game.other();
+        let why = (to == game_pick::Game::Seal).then(|| game_pick::seal_status(self.seal_profile.as_deref(), false).reason()).flatten();
+        self.menus.switch_game = Some((to, why));
+        if game == game_pick::Game::Seal {
