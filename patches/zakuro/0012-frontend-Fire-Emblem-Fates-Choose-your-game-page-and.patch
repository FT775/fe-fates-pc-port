+/// the ranges of memory FEF_HEADLESS_REPORT hashes, FEF_HEADLESS_RANGES=`0x08000000:0x100000,...`.
+fn headless_ranges() -> Vec<(u32, usize)> {
+    parse_ranges(&std::env::var("FEF_HEADLESS_RANGES").unwrap_or_default())
+}
+
+fn parse_ranges(text: &str) -> Vec<(u32, usize)> {
+    let number = |text: &str| {
+        let text = text.trim();
+        match text.strip_prefix("0x").or_else(|| text.strip_prefix("0X")) {
+            Some(hex) => u64::from_str_radix(hex, 16).ok(),
+            None => text.parse().ok(),
+        }
+    };
+    text.split(',')
+        .filter_map(|range| {
+            let (addr, len) = range.split_once(':')?;
+            Some((u32::try_from(number(addr)?).ok()?, usize::try_from(number(len)?).ok()?))
+        })
+        .collect()
 }
 
