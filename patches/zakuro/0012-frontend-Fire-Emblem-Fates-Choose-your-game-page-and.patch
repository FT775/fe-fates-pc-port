+    /// saves the settings: as always, or while Seal of Flames plays, the shared ones to
+    /// the owner's file with his own game settings in it unchanged, and Seal of Flames'
+    /// game settings to its own file.
+    fn save_settings(&self) {
+        match (&self.owner_bits, &self.seal_profile) {
+            (Some(owner), Some(profile)) => {
+                let (shared, seal) = game_pick::split_for_save(&self.settings, owner);
+                shared.save();
+                game_pick::save_seal_bits(profile, &seal);
+            }
+            _ => self.settings.save(),
+        }
+    }
+
+    /// Continue on the Choose your game page: remembered, then started.
+    fn pick_continue(&mut self, game: game_pick::Game) {
+        if let Err(error) = self.apply_choice(game) {
+            self.pick.error = Some(error);
+            return;
+        }
+        if let Some(file) = game_pick::choice_file() {
+            if let Err(error) = game_pick::write_choice(&file, game) {
+                log::warn!("could not remember the game chosen in {}, {error}", file.display());
+            }
+        }
+        self.pick.open = false;
+        self.pick.error = None;
+        if let Some(rom) = self.options.rom.clone() {
+            if let Err(error) = self.play(Path::new(&rom)) {
+                log::warn!("{error}");
+                self.pick.error = Some(error);
+                self.pick.open = true;
+            }
+        }
+        if self.options.profile {
+            if let Some(game) = &mut self.game {
+                game.system.enable_profiler();
+            }
+        }
+    }
