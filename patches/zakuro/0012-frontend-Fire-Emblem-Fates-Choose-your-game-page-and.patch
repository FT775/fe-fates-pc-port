@@ -0,0 +1,655 @@
+//! "Choose your game": the Fire Emblem Fates port's page before the game boots, Fire
+//! Emblem Fates or the optional fan mod Seal of Flames by Laz14
+//! (gamebanana.com/mods/656034, CC BY-NC-ND 4.0), and what each choice means for the
+//! program: its data folder, its own game settings and whether the randomizer runs.
+//!
+//! The port's docs/GAME_PICKER.md (round 53) is the design. In short:
+//!
+//! - the page shows only in a program made of one game (linked recompiled code) with a
+//!   window, when the game it starts is Fire Emblem Fates SE USA; everything else is as
+//!   Zakuro always was;
+//! - Fire Emblem Fates keeps exactly today's paths (`--data`, else the system's place);
+//!   Seal of Flames plays from its own profile folder (`<profile>\data`: saves, states,
+//!   cheats, its mods folder with the unchanged mod, its log);
+//! - the general settings (window, keys, controllers, sound, graphics) are shared, the
+//!   owner's settings.toml; the game's own settings (`per_game` and `enhancements` for
+//!   the shared title id) are kept apart for Seal of Flames in
+//!   `<profile>\game-settings.toml`, so a Seal session never changes the owner's;
+//! - the choice is remembered in `game-choice.txt` beside the program's folder (never in
+//!   settings.toml), written only by the window;
+//! - the randomizer runs only for Fire Emblem Fates (`Config::fates_rando`).
+//!
+//! No byte of the mod is read here: "installed" is decided from folder names and the
+//! profile's own JSON. The Install button runs the port's `tools/play/sof.py install`
+//! hidden; that tool reads the owner's download, read-only.
+
+use std::path::{Path, PathBuf};
+use std::sync::mpsc::{channel, Receiver};
+use std::time::Duration;
+
+use egui::{Color32, RichText, Vec2};
+use serde::{Deserialize, Serialize};
+
+use crate::settings::{game_key, GameSettings, Settings, FATES_SE_USA};
+
+/// the credit shown wherever the choice is.
+pub const CREDIT: &str = "Seal of Flames by Laz14 (gamebanana.com/mods/656034), CC BY-NC-ND 4.0";
+/// the Seal of Flames line on the page and in the menu.
+pub const SEAL_NAME: &str = "Seal of Flames (by Laz14)";
+pub const FATES_NAME: &str = "Fire Emblem Fates";
+/// the mods folder name the mod lives in (the title id it shares with Fates).
+const TITLE_DIR: &str = "0004000000179800";
+/// how long the Install button's tool may take.
+const INSTALL_LIMIT: Duration = Duration::from_secs(600);
+
+/// the game the program plays.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Game {
+    #[default]
+    Fates,
+    Seal,
+}
+
+impl Game {
+    pub fn word(self) -> &'static str {
+        match self {
+            Game::Fates => "fates",
+            Game::Seal => "seal",
+        }
+    }
+
+    pub fn parse(text: &str) -> Option<Game> {
+        match text.trim().trim_start_matches('\u{feff}').to_ascii_lowercase().as_str() {
+            "fates" | "fire emblem fates" => Some(Game::Fates),
+            "seal" | "sof" | "seal-of-flames" | "seal of flames" => Some(Game::Seal),
+            _ => None,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Game::Fates => FATES_NAME,
+            Game::Seal => SEAL_NAME,
+        }
+    }
+
+    pub fn other(self) -> Game {
+        match self {
+            Game::Fates => Game::Seal,
+            Game::Seal => Game::Fates,
+        }
+    }
+}
+
+/// what the game to start is, before any page: the command line's `--game`, else
+/// FEF_GAME_CHOICE, else (with a window only) the remembered choice, else Fire Emblem
+/// Fates. Headless runs never read the remembered file, so every existing test run
+/// plays Fire Emblem Fates as before.
+pub fn initial(cli: Option<Game>, env: Option<Game>, remembered: Option<Game>, headless: bool) -> Game {
+    cli.or(env).or(if headless { None } else { remembered }).unwrap_or_default()
+}
+
+/// FEF_GAME_CHOICE, when it names a game.
+pub fn env_choice() -> Option<Game> {
+    std::env::var("FEF_GAME_CHOICE").ok().and_then(|text| Game::parse(&text))
+}
+
+/// the program's folder.
+fn exe_dir() -> Option<PathBuf> {
+    Some(std::env::current_exe().ok()?.parent()?.to_owned())
+}
+
+/// where the remembered choice is: `game-choice.txt` one folder above the program's
+/// (`play\game\..\game-choice.txt`, beside the port's play\config.json).
+pub fn choice_file() -> Option<PathBuf> {
+    Some(exe_dir()?.parent()?.join("game-choice.txt"))
+}
+
+/// the remembered choice; a missing or unreadable file is none.
+pub fn read_choice(file: &Path) -> Option<Game> {
+    Game::parse(std::fs::read_to_string(file).ok()?.lines().next()?)
+}
+
+/// remembers the choice: a temporary file, then renamed over the old one.
+pub fn write_choice(file: &Path, game: Game) -> std::io::Result<()> {
+    if let Some(dir) = file.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let partial = file.with_extension("txt.new");
+    std::fs::write(&partial, format!("{}\n", game.word()))?;
+    std::fs::rename(&partial, file)
+}
+
+/// the Seal of Flames profile folder: `--seal-profile`, else FEF_SEAL_PROFILE, else
+/// `seal-of-flames` beside the program's folder (`play\game\..\seal-of-flames`).
+pub fn profile(cli: Option<&str>) -> Option<PathBuf> {
+    if let Some(dir) = cli.filter(|dir| !dir.is_empty()) {
+        return Some(PathBuf::from(dir));
+    }
+    if let Some(dir) = std::env::var_os("FEF_SEAL_PROFILE").filter(|dir| !dir.is_empty()) {
+        return Some(PathBuf::from(dir));
+    }
+    Some(exe_dir()?.parent()?.join("seal-of-flames"))
+}
+
+/// the data folder Seal of Flames plays from.
+pub fn profile_data(profile: &Path) -> PathBuf {
+    profile.join("data")
+}
+
+/// whether Seal of Flames can be chosen.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SealStatus {
+    Installed,
+    /// no profile, or no mod in it.
+    Missing,
+    /// there, but something is wrong with it (the launcher's full check failed, or
+    /// something else is in its mods folder): Install again repairs it.
+    Broken(String),
+}
+
+impl SealStatus {
+    pub fn installed(&self) -> bool {
+        *self == SealStatus::Installed
+    }
+
+    /// why it can't be chosen, in a line.
+    pub fn reason(&self) -> Option<String> {
+        match self {
+            SealStatus::Installed => None,
+            SealStatus::Missing => Some("Not installed. Put the Seal of Flames v6 download in the port folder, then press Install.".into()),
+            SealStatus::Broken(why) => Some(format!("Needs repair ({why}): press Install again (your saves are kept).")),
+        }
+    }
+}
+
+/// what the profile folder holds, by names only (the same fail-closed rule the port's
+/// sof.py has): `profile.json` reads as JSON, the mod's `romfs` folder is there, and the
+/// profile's mods folder holds nothing else. `broken` is the launcher's word that its
+/// full names-and-sizes check failed.
+pub fn seal_status(profile: Option<&Path>, broken: bool) -> SealStatus {
+    let Some(profile) = profile else { return SealStatus::Missing };
+    let json = std::fs::read_to_string(profile.join("profile.json")).ok();
+    let mods = profile_data(profile).join("mods");
+    let romfs = mods.join(TITLE_DIR).join("romfs");
+    if json.is_none() && !romfs.is_dir() {
+        return SealStatus::Missing;
+    }
+    if json.as_deref().and_then(|text| serde_json::from_str::<serde_json::Value>(text).ok()).is_none() {
+        return SealStatus::Broken("profile.json is missing or unreadable".into());
+    }
+    if !romfs.is_dir() {
+        return SealStatus::Broken("the mod's romfs folder is missing".into());
+    }
+    let others: Vec<String> = std::fs::read_dir(&mods)
+        .map(|entries| entries.flatten().map(|entry| entry.file_name().to_string_lossy().into_owned()).filter(|name| name != TITLE_DIR).collect())
+        .unwrap_or_default();
+    if !others.is_empty() {
+        return SealStatus::Broken(format!("other entries in its mods folder: {}", others.join(", ")));
+    }
+    if broken {
+        return SealStatus::Broken("the launcher's check of the installed files failed".into());
+    }
+    SealStatus::Installed
+}
+
+// ------------------------------------------------------------------ the game's own settings
+
+/// what Fire Emblem Fates' title id has of its own in the settings: its "Settings for
+/// this game" and its enhancements (60 fps battles, 16:9, ...).
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct GameBits {
+    pub per_game: Option<GameSettings>,
+    pub enhancements: Option<Vec<String>>,
+}
+
+/// Seal of Flames' own game settings file, `<profile>\game-settings.toml`.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+struct SealFile {
+    format: u32,
+    #[serde(flatten)]
+    bits: GameBits,
+}
+
+/// the title's game bits in these settings.
+pub fn take_bits(settings: &Settings) -> GameBits {
+    let key = game_key(FATES_SE_USA);
+    GameBits { per_game: settings.per_game.get(&key).cloned(), enhancements: settings.enhancements.get(&key).cloned() }
+}
+
+/// puts game bits in, in place of the title's (none = the entry left out).
+pub fn put_bits(settings: &mut Settings, bits: GameBits) {
+    let key = game_key(FATES_SE_USA);
+    match bits.per_game {
+        Some(own) => settings.per_game.insert(key.clone(), own),
+        None => settings.per_game.remove(&key),
+    };
+    match bits.enhancements {
+        Some(names) => settings.enhancements.insert(key, names),
+        None => settings.enhancements.remove(&key),
+    };
+}
+
+pub fn seal_settings_file(profile: &Path) -> PathBuf {
+    profile.join("game-settings.toml")
+}
+
+/// Seal of Flames' game bits: its own file, else (the first time) those the round-52
+/// profile's own settings had (`<profile>\appdata\zakuro\settings.toml`, read only),
+/// else the port's first-run picks.
+pub fn load_seal_bits(profile: &Path) -> GameBits {
+    if let Ok(text) = std::fs::read_to_string(seal_settings_file(profile)) {
+        match toml::from_str::<SealFile>(&text) {
+            Ok(file) => return file.bits,
+            Err(error) => log::warn!("could not read {}, {error}; Seal of Flames starts with the first-run picks", seal_settings_file(profile).display()),
+        }
+    }
+    let old = profile.join("appdata").join("zakuro").join("settings.toml");
+    if let Some(settings) = std::fs::read_to_string(&old).ok().and_then(|text| toml::from_str::<Settings>(&text).ok()) {
+        log::info!("Seal of Flames' own game settings start from {}", old.display());
+        return take_bits(&settings);
+    }
+    take_bits(&Settings::first_run())
+}
+
+/// writes Seal of Flames' game bits to its own file.
+pub fn save_seal_bits(profile: &Path, bits: &GameBits) {
+    let file = seal_settings_file(profile);
+    let written = toml::to_string_pretty(&SealFile { format: 1, bits: bits.clone() })
+        .map_err(|error| error.to_string())
+        .and_then(|text| std::fs::write(&file, text).map_err(|error| error.to_string()));
+    if let Err(error) = written {
+        log::warn!("could not save Seal of Flames' game settings to {}, {error}", file.display());
+    }
+}
+
+/// what is written to the owner's settings.toml while Seal of Flames plays: the
+/// settings as they are now (a shared change lands there), with the owner's own game
+/// bits put back; and the Seal bits, which go to the profile's file.
+pub fn split_for_save(settings: &Settings, owner: &GameBits) -> (Settings, GameBits) {
+    let seal = take_bits(settings);
+    let mut shared = settings.clone();
+    put_bits(&mut shared, owner.clone());
+    (shared, seal)
+}
+
+// ------------------------------------------------------------------ the Install button
+
+/// the port's folder: FEF_REPO, else the first folder above the program holding
+/// tools\play\sof.py.
+pub fn repo() -> Option<PathBuf> {
+    if let Some(dir) = std::env::var_os("FEF_REPO").filter(|dir| !dir.is_empty()) {
+        return Some(PathBuf::from(dir));
+    }
+    let exe = std::env::current_exe().ok()?;
+    exe.ancestors().skip(1).take(6).find(|dir| dir.join("tools").join("play").join("sof.py").is_file()).map(Path::to_owned)
+}
+
+/// the hidden install command: `python -I <repo>\tools\play\sof.py install`, no window
+/// (CREATE_NO_WINDOW), no input, its output piped to the log. Returns the creation flags
+/// too, for the test.
+pub fn install_command(python: &zakuro_core::fates_rando_session::Python, repo: &Path) -> (std::process::Command, u32) {
+    let script = repo.join("tools").join("play").join("sof.py");
+    let args: [&std::ffi::OsStr; 3] = ["-I".as_ref(), script.as_os_str(), "install".as_ref()];
+    let (mut cmd, flags) = zakuro_core::fates_rando_session::python_command(python, &args);
+    cmd.current_dir(repo);
+    (cmd, flags)
+}
+
+/// runs the install in a thread; the answer is its last line, or why it failed.
+fn start_install() -> Receiver<Result<String, String>> {
+    let (send, receive) = channel();
+    std::thread::spawn(move || {
+        let result = (|| {
+            let repo = repo().ok_or("the port's tools\\play\\sof.py was not found above the program")?;
+            let python = zakuro_core::fates_rando_session::find_python().map_err(|_| "Python 3 was not found".to_owned())?;
+            let (cmd, _) = install_command(&python, &repo);
+            let (code, lines) = zakuro_core::fates_rando_session::run_hidden(cmd, INSTALL_LIMIT)?;
+            for line in &lines {
+                log::info!(target: "zakuro::game_pick", "sof.py: {line}");
+            }
+            let last = lines.iter().rev().find(|line| !line.trim().is_empty()).cloned().unwrap_or_default();
+            if code == 0 {
+                Ok(last)
+            } else {
+                Err(if last.is_empty() { format!("sof.py stopped with {code}") } else { last })
+            }
+        })();
+        let _ = send.send(result);
+    });
+    receive
+}
+
+// ------------------------------------------------------------------ the page
+
+/// what the page asks the program for.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PickAction {
+    /// start this game.
+    Continue(Game),
+}
+
+/// the page's state, kept apart from egui so it can be tested without a window.
+#[derive(Default)]
+pub struct GamePick {
+    /// the page shows, in place of the game.
+    pub open: bool,
+    pub selected: Game,
+    pub seal: SealStatus,
+    /// the Seal profile's folder, to check again after an install.
+    pub profile: Option<PathBuf>,
+    /// the launcher said its check of the installed files failed.
+    pub broken: bool,
+    installing: Option<Receiver<Result<String, String>>>,
+    /// what the last install said, and whether it failed.
+    pub install_note: Option<(String, bool)>,
+    /// the Esc menu's Switch game confirm window, for this game.
+    pub confirm: Option<Game>,
+    /// why the last start or switch failed, shown on the page.
+    pub error: Option<String>,
+}
+
+impl Default for SealStatus {
+    fn default() -> Self {
+        SealStatus::Missing
+    }
+}
+
+impl GamePick {
+    /// the page for a start, with this game pre-selected (Fire Emblem Fates in its
+    /// place when Seal of Flames can't be chosen).
+    pub fn new(profile: Option<PathBuf>, broken: bool, preselect: Game) -> GamePick {
+        let seal = seal_status(profile.as_deref(), broken);
+        let selected = if preselect == Game::Seal && !seal.installed() { Game::Fates } else { preselect };
+        GamePick { open: false, selected, seal, profile, broken, ..GamePick::default() }
+    }
+
+    /// checks the profile again (after an install).
+    pub fn refresh(&mut self) {
+        self.seal = seal_status(self.profile.as_deref(), false);
+        self.broken = false;
+    }
+
+    pub fn can_choose(&self, game: Game) -> bool {
+        game == Game::Fates || self.seal.installed()
+    }
+
+    /// Up or Down on the page.
+    pub fn move_selection(&mut self) {
+        let other = self.selected.other();
+        if self.can_choose(other) {
+            self.selected = other;
+        }
+    }
+
+    /// Enter, Start or A, or the Continue button: the game to start.
+    pub fn continue_choice(&self) -> Option<Game> {
+        self.can_choose(self.selected).then_some(self.selected)
+    }
+
+    fn poll_install(&mut self) {
+        let Some(receive) = &self.installing else { return };
+        match receive.try_recv() {
+            Ok(result) => {
+                self.installing = None;
+                self.refresh();
+                self.install_note = Some(match result {
+                    Ok(last) if self.seal.installed() => (if last.is_empty() { "Installed.".into() } else { last }, false),
+                    Ok(last) => (format!("The install ended, but the mod is still not there: {last}"), true),
+                    Err(why) => (format!("Install failed: {why}"), true),
+                });
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => {}
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => self.installing = None,
+        }
+    }
+
+    /// the page, while open. keys: Up/Down choose, Enter continues; controller buttons
+    /// come through `pad`.
+    pub fn draw(&mut self, ctx: &egui::Context) -> Vec<PickAction> {
+        let mut actions = Vec::new();
+        self.poll_install();
+        if !self.open {
+            return actions;
+        }
+        if self.installing.is_some() {
+            ctx.request_repaint();
+        }
+        let (up_down, enter) = ctx.input(|input| {
+            (
+                input.key_pressed(egui::Key::ArrowUp) || input.key_pressed(egui::Key::ArrowDown),
+                input.key_pressed(egui::Key::Enter),
+            )
+        });
+        if up_down {
+            self.move_selection();
+        }
+        if enter {
+            actions.extend(self.continue_choice().map(PickAction::Continue));
+        }
+        egui::Window::new("Choose your game")
+            .id(egui::Id::new("game pick"))
+            .collapsible(false)
+            .resizable(false)
+            .anchor(egui::Align2::CENTER_CENTER, Vec2::ZERO)
+            .show(ctx, |ui| {
+                ui.set_min_width(360.0);
+                ui.radio_value(&mut self.selected, Game::Fates, RichText::new(FATES_NAME).strong());
+                ui.add_space(4.0);
+                let seal_ok = self.seal.installed();
+                ui.add_enabled_ui(seal_ok, |ui| {
+                    ui.horizontal(|ui| {
+                        ui.radio_value(&mut self.selected, Game::Seal, RichText::new(SEAL_NAME).strong());
+                        ui.label(RichText::new("fan mod, not part of this port").weak());
+                    });
+                });
+                ui.label(RichText::new(CREDIT).weak().small());
+                if let Some(reason) = self.seal.reason() {
+                    ui.label(RichText::new(reason).color(Color32::GRAY));
+                    ui.horizontal(|ui| {
+                        if self.installing.is_some() {
+                            ui.spinner();
+                            ui.label("Installing... (about a minute)");
+                        } else if ui.button("Install").clicked() {
+                            self.install_note = None;
+                            self.installing = Some(start_install());
+                        }
+                    });
+                }
+                if let Some((note, failed)) = &self.install_note {
+                    ui.label(RichText::new(note).color(if *failed { Color32::LIGHT_RED } else { Color32::LIGHT_GREEN }));
+                }
+                if let Some(error) = &self.error {
+                    ui.label(RichText::new(error).color(Color32::LIGHT_RED));
+                }
+                ui.add_space(8.0);
+                ui.horizontal(|ui| {
+                    let ready = self.continue_choice().is_some() && self.installing.is_none();
+                    if ui.add_enabled(ready, egui::Button::new("Continue").min_size(Vec2::new(120.0, 28.0))).clicked() {
+                        actions.extend(self.continue_choice().map(PickAction::Continue));
+                    }
+                    ui.label(RichText::new("Up/Down choose, Enter or Start continues").weak());
+                });
+            });
+        if self.installing.is_some() {
+            actions.clear();
+        }
+        actions
+    }
+
+    /// a controller button while the page is open: the D-pad chooses, A or Start
+    /// continues.
+    pub fn pad(&mut self, button: gilrs::Button) -> Option<PickAction> {
+        match button {
+            gilrs::Button::DPadUp | gilrs::Button::DPadDown => {
+                self.move_selection();
+                None
+            }
+            gilrs::Button::South | gilrs::Button::Start if self.installing.is_none() => self.continue_choice().map(PickAction::Continue),
+            _ => None,
+        }
+    }
+
+    /// the Esc menu's Switch game confirm window, while asked for: the game to switch
+    /// to once the player says so.
+    pub fn draw_confirm(&mut self, ctx: &egui::Context) -> Option<Game> {
+        let to = self.confirm?;
+        let mut chosen = None;
+        egui::Window::new("Switch game")
+            .id(egui::Id::new("game pick switch"))
+            .collapsible(false)
+            .resizable(false)
+            .anchor(egui::Align2::CENTER_CENTER, Vec2::ZERO)
+            .show(ctx, |ui| {
+                ui.label(format!("Unsaved progress will be lost. Switch to {}?", to.name()));
+                if to == Game::Seal {
+                    ui.label(RichText::new(CREDIT).weak().small());
+                }
+                ui.add_space(6.0);
+                ui.horizontal(|ui| {
+                    if ui.add_sized([98.0, 28.0], egui::Button::new("Switch")).clicked() {
+                        chosen = Some(to);
+                    }
+                    if ui.add_sized([98.0, 28.0], egui::Button::new("Cancel")).clicked() {
+                        self.confirm = None;
+                    }
+                });
+            });
+        if chosen.is_some() {
+            self.confirm = None;
+        }
+        chosen
+    }
+}
