+    const PATCH: &str = "fates-rando-patch 1\nseed r50test\noptions {}\ngamedata-sha256 00\n\
+file gamedata GameData/GameData.bin.lz\nv 10 07 09\n\
+file dispos GameData/Dispos/A/A005.bin.lz\nv c 03 05\np 8 4a49445f41 4a49445f42 g 110 40\n\
+p 10 - 4a49445f41 g 100 -\nend 4\n";
