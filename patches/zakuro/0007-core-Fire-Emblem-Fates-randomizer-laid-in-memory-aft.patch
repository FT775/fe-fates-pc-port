+//! Fire Emblem Fates: the randomizer laid in memory right after the New Game mode pick
+//! (Casual / Classic / Phoenix), so the randomizer's settings are chosen inside the game
+//! instead of in a separate PLAY RANDOMIZED profile.
+//!
+//! The randomizer itself stays the port's Python tool (`tools/randomizer/rando.py make
+//! --patch-out FILE`); this module only reads its patch file and writes the cells it
+//! names into the game's own copies of its files:
+//!
+//! - `GameData/GameData.bin.lz`, loaded whole once at boot (`GameData::Initialize`
+//!   0x004E6954: `*0x006D3868` is its ArchiveFile; `[[+4] + 112] + 32` is the data start
+//!   every table pointer counts from);
+//! - the chapter placement files `GameData/Dispos/**`, loaded one at a time into the
+//!   object at `*0x006D6DC8` (`map::Dispos::Load` 0x0039ED9C: name at +0, ArchiveFile at
+//!   +16).
+//!
+//! Every cell carries its original value. Before anything is written, every cell of the
+//! file is checked against it (all or nothing), so another mod, a PLAY RANDOMIZED
+//! profile or another game version means nothing is written. With no active run this
+//! module reads nothing and writes nothing: Randomizer off is the original game.
+//!
+//! Patch format (text, written by tools/randomizer/ingame.py; offsets from the file's
+//! data start, hex):
+//!
+//! ```text
+//! fates-rando-patch 1
+//! seed <seed>
+//! options <json, not read here>
+//! gamedata-sha256 <hex>
+//! file gamedata|dispos <romfs path>
+//! v <offset> <original bytes> <new bytes>
+//! p <offset> <original label|-> <new label|-> <g|s|-> <new label offset|-> <original value|->
+//! end <number of v and p lines>
+//! ```
+//!
+//! `p` cells are pointers to label text (a placement's class or item, for example). In
+//! memory a pointer is "data start + offset", so the new value is GameData's data start
+//! (`g`) or this file's data start (`s`) plus the label's offset, and the guard compares
+//! the label TEXT the pointer currently shows. The original value lets a revert write
+//! the file's own pointer back.
+//!
+//! Side files: a randomized game's save files get a small file beside them in the data
+//! folder (`rando/<title>/slots/<save file>.json`) naming the run they belong to, so a
+//! later load lays the same run again; `slot_*` below. Wiring into the file service, the
+//! New Game page and the frame hook are separate steps (docs/RANDOMIZER_INGAME.md).
+
+use std::collections::HashSet;
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+use crate::memory::Memory;
+
+/// Fire Emblem Fates (USA).
+pub const TITLE: u64 = 0x0004_0000_0017_9800;
+/// GameData's ArchiveFile pointer (`GameData::Initialize`).
+pub const GAMEDATA_ARCHIVE: u32 = 0x006D_3868;
+/// The placement object pointer (`map::Dispos::Load`).
+pub const DISPOS_OBJECT: u32 = 0x006D_6DC8;
+pub const FORMAT: u32 = 1;
+
+/// The few memory calls this module needs (real memory, or a fake one in the tests).
+pub trait Guest {
+    fn readable(&self, addr: u32, len: u32) -> bool;
+    fn read(&mut self, addr: u32, out: &mut [u8]);
+    fn write(&mut self, addr: u32, data: &[u8]);
+
+    fn r32(&mut self, addr: u32) -> Option<u32> {
+        if !self.readable(addr, 4) {
+            return None;
+        }
+        let mut b = [0u8; 4];
+        self.read(addr, &mut b);
+        Some(u32::from_le_bytes(b))
+    }
+
+    /// the NUL-terminated bytes at addr (at most max), None when unreadable or too long.
+    fn cstr(&mut self, addr: u32, max: u32) -> Option<Vec<u8>> {
+        let mut out = Vec::new();
+        for i in 0..max {
+            let a = addr.wrapping_add(i);
+            if !self.readable(a, 1) {
+                return None;
+            }
+            let mut b = [0u8; 1];
+            self.read(a, &mut b);
+            if b[0] == 0 {
+                return Some(out);
+            }
+            out.push(b[0]);
+        }
+        None
+    }
+}
+
+impl Guest for Memory {
+    fn readable(&self, addr: u32, len: u32) -> bool {
+        self.is_readable(addr, len)
+    }
+    fn read(&mut self, addr: u32, out: &mut [u8]) {
+        self.read_bytes(addr, out)
+    }
+    fn write(&mut self, addr: u32, data: &[u8]) {
+        self.write_bytes(addr, data)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    GameData,
+    Dispos,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Where {
+    GameData,
+    Own,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Value {
+    pub off: u32,
+    pub old: Vec<u8>,
+    pub new: Vec<u8>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Ptr {
+    pub off: u32,
+    pub old: Option<Vec<u8>>,
+    pub new: Option<Vec<u8>>,
+    /// where the new label lives and its offset from that file's data start
+    pub target: Option<(Where, u32)>,
+    /// the original pointer's file value (from this file's data start)
+    pub old_value: Option<u32>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FilePatch {
+    pub kind: Kind,
+    pub rel: String,
+    pub values: Vec<Value>,
+    pub ptrs: Vec<Ptr>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Patch {
+    pub seed: String,
+    pub gamedata_sha256: String,
+    pub files: Vec<FilePatch>,
+}
+
+fn hex_bytes(s: &str) -> Result<Vec<u8>, String> {
+    if s.len() % 2 != 0 {
+        return Err(format!("odd hex length: {s}"));
+    }
+    (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).map_err(|e| format!("{s}: {e}")))
+        .collect()
+}
+
+fn hex_u32(s: &str) -> Result<u32, String> {
+    u32::from_str_radix(s, 16).map_err(|e| format!("{s}: {e}"))
+}
+
+fn opt<T>(s: &str, f: impl Fn(&str) -> Result<T, String>) -> Result<Option<T>, String> {
+    if s == "-" { Ok(None) } else { f(s).map(Some) }
+}
+
+impl Patch {
+    pub fn parse(text: &str) -> Result<Patch, String> {
+        let mut lines = text.lines();
+        if lines.next() != Some(&format!("fates-rando-patch {FORMAT}")) {
+            return Err("not a fates-rando-patch file of this format".into());
+        }
+        let mut p = Patch::default();
+        let mut count = 0usize;
+        let mut ended = false;
+        for (n, line) in lines.enumerate() {
+            let at = |e: String| format!("line {}: {e}", n + 2);
+            let w: Vec<&str> = line.split(' ').collect();
+            if ended {
+                return Err(at("text after the end line".into()));
+            }
+            match w[0] {
+                "seed" => p.seed = w.get(1).copied().unwrap_or("").to_string(),
+                "options" => {}
+                "gamedata-sha256" => p.gamedata_sha256 = w.get(1).copied().unwrap_or("").to_string(),
+                "file" if w.len() == 3 => {
+                    let kind = match w[1] {
+                        "gamedata" => Kind::GameData,
+                        "dispos" => Kind::Dispos,
+                        k => return Err(at(format!("unknown file kind {k}"))),
+                    };
+                    p.files.push(FilePatch { kind, rel: w[2].to_string(), values: vec![], ptrs: vec![] });
+                }
+                "v" if w.len() == 4 => {
+                    let f = p.files.last_mut().ok_or_else(|| at("cell before any file line".into()))?;
+                    let v = Value { off: hex_u32(w[1]).map_err(at)?, old: hex_bytes(w[2]).map_err(at)?,
+                                    new: hex_bytes(w[3]).map_err(at)? };
+                    if v.old.len() != v.new.len() || v.old.is_empty() {
+                        return Err(at("original and new bytes differ in size".into()));
+                    }
+                    f.values.push(v);
+                    count += 1;
+                }
+                "p" if w.len() == 7 => {
+                    let f = p.files.last_mut().ok_or_else(|| at("cell before any file line".into()))?;
+                    let target = match (w[4], opt(w[5], hex_u32).map_err(at)?) {
+                        ("g", Some(o)) => Some((Where::GameData, o)),
+                        ("s", Some(o)) => Some((Where::Own, o)),
+                        ("-", None) => None,
+                        _ => return Err(at("bad label place".into())),
+                    };
+                    let ptr = Ptr { off: hex_u32(w[1]).map_err(at)?, old: opt(w[2], hex_bytes).map_err(at)?,
+                                    new: opt(w[3], hex_bytes).map_err(at)?, target,
+                                    old_value: opt(w[6], hex_u32).map_err(at)? };
+                    if ptr.off % 4 != 0 || ptr.new.is_some() != ptr.target.is_some()
+                        || ptr.old.is_some() != ptr.old_value.is_some()
+                    {
+                        return Err(at("inconsistent pointer cell".into()));
+                    }
+                    f.ptrs.push(ptr);
+                    count += 1;
+                }
+                "end" if w.len() == 2 => {
+                    if w[1].parse::<usize>().ok() != Some(count) {
+                        return Err(at("the cell count does not match the end line".into()));
+                    }
+                    ended = true;
+                }
+                "" => {}
+                _ => return Err(at(format!("unknown line {line:?}"))),
+            }
+        }
+        if !ended {
+            return Err("the patch has no end line (cut short?)".into());
+        }
+        Ok(p)
+    }
+
+    pub fn gamedata(&self) -> Option<&FilePatch> {
+        self.files.iter().find(|f| f.kind == Kind::GameData)
+    }
+
+    /// the placement file whose name (as the game keeps it, e.g. "A005" or "A/A005.bin")
+    /// is `name`.
+    pub fn dispos(&self, name: &str) -> Option<&FilePatch> {
+        let want = stem(name);
+        if want.is_empty() {
+            return None;
+        }
+        self.files.iter().find(|f| f.kind == Kind::Dispos && stem(&f.rel).eq_ignore_ascii_case(want))
+    }
+}
+
+/// "GameData/Dispos/A/A005.bin.lz" -> "A005"
+pub fn stem(path: &str) -> &str {
+    let last = path.rsplit(['/', '\\']).next().unwrap_or(path);
+    last.split('.').next().unwrap_or(last)
+}
+
+/// an ArchiveFile's data start (`[[archive + 4] + 112] + 32`, as GameData::Initialize walks it).
+pub fn archive_data_start(g: &mut dyn Guest, archive: u32) -> Option<u32> {
+    if archive == 0 {
+        return None;
+    }
+    let a = g.r32(archive.wrapping_add(4))?;
+    if a == 0 {
+        return None;
+    }
+    let b = g.r32(a.wrapping_add(112))?;
+    if b == 0 {
+        return None;
+    }
+    Some(b.wrapping_add(32))
+}
+
+pub fn gamedata_start(g: &mut dyn Guest) -> Option<u32> {
+    let arch = g.r32(GAMEDATA_ARCHIVE)?;
+    archive_data_start(g, arch)
+}
+
+/// the placement file in memory now: (its name, its data start).
+pub fn dispos_now(g: &mut dyn Guest) -> Option<(String, u32)> {
+    let obj = g.r32(DISPOS_OBJECT)?;
+    if obj == 0 {
+        return None;
+    }
+    let mut name = [0u8; 16];
+    if !g.readable(obj, 16) {
+        return None;
+    }
+    g.read(obj, &mut name);
+    let end = name.iter().position(|&b| b == 0).unwrap_or(16);
+    let name = String::from_utf8_lossy(&name[..end]).into_owned();
+    let arch = g.r32(obj.wrapping_add(16))?;
+    Some((name, archive_data_start(g, arch)?))
+}
+
+/// `GameConfigData` (`*0x006DA0F8`), whose word at +4 `StartFromBeginning` changes.
+pub const GAME_CONFIG: u32 = 0x006D_A0F8;
+
+/// Watches for the New Game mode pick: the frame in which `GameConfigData`'s word at +4
+/// changes while its byte at +0xB stays 1. Robot runs of round 50 (docs/RANDOMIZER_INGAME.md,
+/// T1): a new game (Casual) changes the word at frame 4019 of the recorded route with +0xB
+/// still 1; loading a save changes the same word in the same frame as +0xB goes to 0.
+#[derive(Debug, Default)]
+pub struct NewGameWatch {
+    last: Option<(u32, u8)>,
+}
+
+impl NewGameWatch {
+    /// call once after every frame; true in the frame the mode was picked.
+    pub fn after_frame(&mut self, g: &mut dyn Guest) -> bool {
+        let now = g.r32(GAME_CONFIG).filter(|&c| c != 0).and_then(|c| {
+            let w = g.r32(c.wrapping_add(4))?;
+            let mut b = [0u8; 1];
+            if !g.readable(c.wrapping_add(0xB), 1) {
+                return None;
+            }
+            g.read(c.wrapping_add(0xB), &mut b);
+            Some((w, b[0]))
+        });
+        let fired = matches!((self.last, now), (Some((w0, _)), Some((w1, 1))) if w0 != w1);
+        self.last = now;
+        fired
+    }
+}
+
+/// Checks every cell of one file (all or nothing) and writes them. `revert` writes the
+/// original values back (the guard then expects the new ones). Returns the cells written,
+/// or the cells that did not match (nothing written).
+pub fn apply_file(g: &mut dyn Guest, f: &FilePatch, base: u32, gd_base: u32, revert: bool)
+    -> Result<usize, Vec<String>>
+{
+    let mut bad = Vec::new();
+    for v in &f.values {
+        let want = if revert { &v.new } else { &v.old };
+        let addr = base.wrapping_add(v.off);
+        let mut cur = vec![0u8; want.len()];
+        if !g.readable(addr, want.len() as u32) {
+            bad.push(format!("{}: v {:#x} unreadable", f.rel, v.off));
+            continue;
+        }
+        g.read(addr, &mut cur);
+        if &cur != want {
+            bad.push(format!("{}: v {:#x} holds {:02x?}, expected {:02x?}", f.rel, v.off, cur, want));
+        }
+    }
+    for p in &f.ptrs {
+        let want = if revert { &p.new } else { &p.old };
+        let Some(cur) = g.r32(base.wrapping_add(p.off)) else {
+            bad.push(format!("{}: p {:#x} unreadable", f.rel, p.off));
+            continue;
+        };
+        let ok = match want {
+            None => cur == 0,
+            Some(label) => cur != 0 && g.cstr(cur, 256).as_ref() == Some(label),
+        };
+        if !ok {
+            bad.push(format!("{}: p {:#x} does not show the expected label", f.rel, p.off));
+        }
+    }
+    // the new labels must be where the patch says, before any pointer is aimed at them
+    for p in &f.ptrs {
+        let (label, value) = if revert {
+            (&p.old, p.old_value.map(|o| base.wrapping_add(o)))
+        } else {
+            (&p.new, p.target.map(|(w, o)| match w { Where::GameData => gd_base, Where::Own => base }.wrapping_add(o)))
+        };
+        if let (Some(label), Some(addr)) = (label, value) {
+            if g.cstr(addr, 256).as_ref() != Some(label) {
+                bad.push(format!("{}: p {:#x}: the label is not at {addr:#010x}", f.rel, p.off));
+            }
+        }
+    }
+    if !bad.is_empty() {
+        return Err(bad);
+    }
+    for v in &f.values {
+        g.write(base.wrapping_add(v.off), if revert { &v.old } else { &v.new });
+    }
+    for p in &f.ptrs {
+        let value = if revert {
+            p.old_value.map_or(0, |o| base.wrapping_add(o))
+        } else {
+            p.target.map_or(0, |(w, o)| match w { Where::GameData => gd_base, Where::Own => base }.wrapping_add(o))
+        };
+        g.write(base.wrapping_add(p.off), &value.to_le_bytes());
+    }
+    Ok(f.values.len() + f.ptrs.len())
+}
+
+/// One randomized game in this session: its patch, and what of it is in memory now.
+#[derive(Debug)]
+pub struct Run {
+    pub patch: Patch,
+    pub id: String,
+    gamedata_at: Option<u32>,
+    /// (placement name, data start) already laid, so a file is laid once per load
+    dispos_done: HashSet<(String, u32)>,
+    pub notices: Vec<String>,
+}
+
+impl Run {
+    pub fn new(patch: Patch, id: impl Into<String>) -> Run {
+        Run { patch, id: id.into(), gamedata_at: None, dispos_done: HashSet::new(), notices: vec![] }
+    }
+
+    pub fn gamedata_applied(&self) -> bool {
+        self.gamedata_at.is_some()
+    }
+
+    /// lays the GameData cells (Start game with Randomizer on, or a randomized save loaded).
+    pub fn apply_gamedata(&mut self, g: &mut dyn Guest) -> Result<usize, Vec<String>> {
+        if self.gamedata_at.is_some() {
+            return Ok(0);
+        }
+        let base = gamedata_start(g).ok_or_else(|| vec!["GameData is not loaded".to_string()])?;
+        let n = match self.patch.gamedata() {
+            Some(f) => apply_file(g, f, base, base, false)?,
+            None => 0,
+        };
+        self.gamedata_at = Some(base);
+        Ok(n)
+    }
+
+    /// puts GameData back as the original (title screen, a save of the original game loaded).
+    pub fn revert_gamedata(&mut self, g: &mut dyn Guest) -> Result<usize, Vec<String>> {
+        let Some(base) = self.gamedata_at else { return Ok(0) };
+        let n = match self.patch.gamedata() {
+            Some(f) => apply_file(g, f, base, base, true)?,
+            None => 0,
+        };
+        self.gamedata_at = None;
+        self.dispos_done.clear();
+        Ok(n)
+    }
+
+    /// called after each frame while the run is active: lays the chapter placements the
+    /// game has just loaded. A file whose guard fails keeps the original placements (a
+    /// notice says so).
+    pub fn after_frame(&mut self, g: &mut dyn Guest) -> Option<usize> {
+        let gd = self.gamedata_at?;
+        let (name, base) = dispos_now(g)?;
+        if self.dispos_done.contains(&(name.clone(), base)) {
+            return None;
+        }
+        self.dispos_done.insert((name.clone(), base));
+        let f = self.patch.dispos(&name)?;
+        match apply_file(g, f, base, gd, false) {
+            Ok(n) => Some(n),
+            Err(bad) => {
+                self.notices.push(format!("{name}: placements kept original ({} cells differ, first: {})",
+                                          bad.len(), bad[0]));
+                None
+            }
+        }
+    }
+}
+
+// --------------------------------------------------------------------------- side files
+
+/// `<data>/rando/<TITLE>/slots/` (the run each randomized save belongs to).
+pub fn slots_dir(data: &Path) -> PathBuf {
+    data.join("rando").join(format!("{TITLE:016X}")).join("slots")
+}
+
+/// a save file's name as the game opens it ("data:/Chapter0", "ext:/Map0.bak") ->
+/// the side file's name ("Chapter0.json"); None for files that are not per-slot saves.
+pub fn slot_name(save: &str) -> Option<String> {
+    let last = save.rsplit(['/', '\\', ':']).next()?;
+    let ok = matches!(last, "Chapter0" | "Chapter1" | "Chapter2" | "Map0.bak" | "Map1.bak");
+    ok.then(|| format!("{last}.json"))
+}
+
+/// the game wrote a save: with an active run its side file names the run, without one it
+/// is removed (that slot is the original game now).
+pub fn slot_written(data: &Path, save: &str, run: Option<&str>) -> io::Result<()> {
+    let Some(name) = slot_name(save) else { return Ok(()) };
+    let dir = slots_dir(data);
+    let path = dir.join(&name);
+    match run {
+        Some(id) => {
+            fs::create_dir_all(&dir)?;
+            let tmp = dir.join(format!("{name}.tmp"));
+            let id = id.replace('\\', "\\\\").replace('"', "\\\"");
+            fs::write(&tmp, format!("{{\"format\": {FORMAT}, \"run\": \"{id}\", \"save\": \"{name}\"}}\n"))?;
+            fs::rename(&tmp, &path)
+        }
+        None => match fs::remove_file(&path) {
+            Err(e) if e.kind() != io::ErrorKind::NotFound => Err(e),
+            _ => Ok(()),
+        },
+    }
+}
+
+/// the run a save belongs to (None = the original game).
+pub fn slot_run(data: &Path, save: &str) -> Option<String> {
+    let text = fs::read_to_string(slots_dir(data).join(slot_name(save)?)).ok()?;
+    let at = text.find("\"run\"")?;
+    let rest = &text[at + 5..];
+    let start = rest.find('"')? + 1;
+    let mut out = String::new();
+    let mut esc = false;
+    for c in rest[start..].chars() {
+        match (esc, c) {
+            (true, c) => { out.push(c); esc = false; }
+            (false, '\\') => esc = true,
+            (false, '"') => return Some(out),
+            (false, c) => out.push(c),
+        }
+    }
+    None
+}
