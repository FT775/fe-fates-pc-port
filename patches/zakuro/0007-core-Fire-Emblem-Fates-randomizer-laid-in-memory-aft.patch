+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    /// guest memory made of a few blocks
+    #[derive(Default)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+        writes: usize,
+    }
+
+    impl Fake {
+        fn put(&mut self, at: u32, data: &[u8]) {
+            self.blocks.insert(at, data.to_vec());
+        }
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+        fn u32_at(&mut self, addr: u32) -> u32 {
+            self.r32(addr).unwrap()
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, addr: u32, data: &[u8]) {
+            let (b, o) = self.find(addr, data.len() as u32).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + data.len()].copy_from_slice(data);
+            self.writes += 1;
+        }
+    }
+
+    const GD_FILE: u32 = 0x3000_0000; // GameData's file buffer (data start = +32)
+    const GD: u32 = GD_FILE + 32;
+    const DP_FILE: u32 = 0x3800_0000;
+    const DP: u32 = DP_FILE + 32;
+
+    /// a game with GameData loaded (a value at +0x10, labels "JID_A" at +0x100 and
+    /// "JID_B" at +0x110) and placement file "A005" (pointer at +0x8 to its own "JID_A"
+    /// at +0x40, an item byte at +0xC, a null pointer at +0x10)
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        let mut gd = vec![0u8; 0x200];
+        gd[32 + 0x10] = 7;
+        gd[32 + 0x100..32 + 0x106].copy_from_slice(b"JID_A\0");
+        gd[32 + 0x110..32 + 0x116].copy_from_slice(b"JID_B\0");
+        m.put(GD_FILE, &gd);
+        // ArchiveFile objects: [+4] -> X, [X+112] -> file buffer
+        let mut arch = vec![0u8; 8];
+        arch[4..8].copy_from_slice(&0x2000_0100u32.to_le_bytes());
+        m.put(0x2000_0000, &arch);
+        let mut x = vec![0u8; 120];
+        x[112..116].copy_from_slice(&GD_FILE.to_le_bytes());
+        m.put(0x2000_0100, &x);
+        m.put(GAMEDATA_ARCHIVE, &0x2000_0000u32.to_le_bytes());
+        let mut dp = vec![0u8; 0x80];
+        dp[32 + 0x8..32 + 0xC].copy_from_slice(&(DP + 0x40).to_le_bytes());
+        dp[32 + 0xC] = 3;
+        dp[32 + 0x40..32 + 0x46].copy_from_slice(b"JID_A\0");
+        m.put(DP_FILE, &dp);
+        let mut darch = vec![0u8; 8];
+        darch[4..8].copy_from_slice(&0x2100_0100u32.to_le_bytes());
+        m.put(0x2100_0000, &darch);
+        let mut dx = vec![0u8; 120];
+        dx[112..116].copy_from_slice(&DP_FILE.to_le_bytes());
+        m.put(0x2100_0100, &dx);
+        let mut obj = vec![0u8; 24];
+        obj[..4].copy_from_slice(b"A005");
+        obj[16..20].copy_from_slice(&0x2100_0000u32.to_le_bytes());
+        m.put(0x2200_0000, &obj);
+        m.put(DISPOS_OBJECT, &0x2200_0000u32.to_le_bytes());
+        m
+    }
