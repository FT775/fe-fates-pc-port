+        // real pointer and paste events on the reported rectangles, as the page robot sends them
+        // (no data folder: no background make starts in a test)
+        let ctx = egui::Context::default();
+        let size = Vec2::new(800.0, 480.0);
+        let mut time = 0.0;
+        let mut page = page_74();
+        page.open_new_game();
+        for _ in 0..4 {
+            frame_with(&ctx, &mut page, size, &mut time, vec![]);
+        }
+        let k = keys(&page);
+        for key in ["btn:preset:light", "btn:preset:wild", "row:share", "btn:share:copy", "btn:share:paste"] {
+            assert!(k.iter().any(|k| k == key), "{key} missing from {k:?}");
+            assert!(egui::Rect::from_min_size(egui::Pos2::ZERO, size).contains_rect(target(&page, key)), "{key} off the screen");
+        }
+        assert!(!k.iter().any(|k| k.contains("Bad Name") || k.contains("novalues")));
+        // the field shows the form's code, with the proposed seed
+        assert_eq!(page.share_shown(false), page.form.as_ref().unwrap().share_code(&page.proposed_seed, None).unwrap());
+        click_at(&ctx, &mut page, size, &mut time, "btn:preset:wild");
+        assert!(page.form.as_ref().unwrap().on());
+        assert_eq!(page.form.as_ref().unwrap().get("promotions"), &json!("on"));
+        assert_eq!(page.note_shown(false).as_deref(), Some("Wild: Wild help."));
+        let wild_values = page.values_text();
+        let wild_code = page.share_shown(false);
+        assert!(wild_code.ends_with(&format!("-{}", page.proposed_seed)));
+        // Copy puts the field's code out through egui
+        let out = click_at(&ctx, &mut page, size, &mut time, "btn:share:copy");
+        assert_eq!(out, [wild_code.clone()]);
+        assert_eq!(page.note_shown(false).as_deref(), Some(SHARE_COPIED));
+        // other values and another seed, then the copied code pasted into the field
+        click_at(&ctx, &mut page, size, &mut time, "btn:preset:light");
+        click_at(&ctx, &mut page, size, &mut time, "btn:random");
+        assert_ne!(page.values_text(), wild_values);
+        click_at(&ctx, &mut page, size, &mut time, "row:share");
+        frame_with(&ctx, &mut page, size, &mut time, vec![egui::Event::Paste(wild_code.clone())]);
+        frame_with(&ctx, &mut page, size, &mut time, vec![]);
+        assert_eq!(page.values_text(), wild_values, "every value and the seed from the code");
+        assert_eq!(page.note_shown(false).as_deref(), Some(SHARE_USED));
+        assert_eq!(page.share_shown(false), wild_code);
+        assert!(!page.share.edited);
+        // a code with a typo: one plain sentence, nothing changes
+        let typo = format!("{}X", &wild_code[..wild_code.len() - 1]);
+        click_at(&ctx, &mut page, size, &mut time, "row:share");
+        frame_with(&ctx, &mut page, size, &mut time, vec![egui::Event::Paste(typo.clone())]);
+        frame_with(&ctx, &mut page, size, &mut time, vec![]);
+        assert_eq!(page.values_text(), wild_values);
+        assert_eq!(page.note_shown(false).as_deref(), Some(SHARE_TYPO));
+        assert!(page.share.edited && page.share.text == typo, "the bad text stays to be fixed");
+        // Paste with the bad text in the field tries it again; Defaults shows the form's code again
+        click_at(&ctx, &mut page, size, &mut time, "btn:share:paste");
+        assert_eq!(page.note_shown(false).as_deref(), Some(SHARE_TYPO));
+        click_at(&ctx, &mut page, size, &mut time, "btn:defaults");
+        assert!(!page.share.edited);
+        assert_eq!(page.share_shown(false), page.form.as_ref().unwrap().share_code(&page.proposed_seed, None).unwrap());
+        // Paste with nothing typed: the line says to press Ctrl+V
+        click_at(&ctx, &mut page, size, &mut time, "btn:share:paste");
+        assert_eq!(page.note_shown(false).as_deref(), Some(SHARE_PASTE_HOW));
+        // the help line names the share row and the preset buttons
+        let form = page.form.as_ref().unwrap();
+        let presets = parse_presets(&schema_74());
+        assert_eq!(help_for(form, &presets, Some(&"share".to_owned()), None, HELP_REST), format!("Share code: {SHARE_HELP}"));
+        assert_eq!(help_for(form, &presets, Some(&"preset:light".to_owned()), None, HELP_REST), "Light: Light help.");
+        assert_eq!(SHARE_HELP, "Copy or paste this. The same code makes the same game.");
+    }
