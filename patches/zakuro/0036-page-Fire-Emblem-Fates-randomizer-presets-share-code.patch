+/// round 74: one preset button of the page (`rando.py schema`'s `presets`, docs/rando/FULL_BLOCK.md
+/// section 6): a press puts every row at its default, then these values, and keeps the seed.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Preset {
+    /// the id (lowercase letters): the page robot's target `btn:preset:<name>`
+    pub name: String,
+    /// the button's text
+    pub label: String,
+    /// the one help line a press writes
+    pub help: String,
+    /// row key -> value
+    pub values: Map<String, Value>,
+}
+
+/// round 74: `rando.py schema`'s `presets` (none in an older schema or in text that is not
+/// JSON; an entry without a lowercase name or without values is left out).
+pub fn parse_presets(text: &str) -> Vec<Preset> {
+    let Ok(root) = serde_json::from_str::<Value>(text.trim()) else { return Vec::new() };
+    let Some(list) = root.get("presets").and_then(Value::as_array) else { return Vec::new() };
+    list.iter()
+        .filter_map(|p| {
+            let name = p.get("name")?.as_str()?.to_owned();
+            if name.is_empty() || !name.bytes().all(|b| b.is_ascii_lowercase()) {
+                return None;
+            }
+            let values = p.get("values")?.as_object()?.clone();
+            let label = p.get("label").and_then(Value::as_str).unwrap_or(name.as_str()).to_owned();
+            let help = p.get("help").and_then(Value::as_str).unwrap_or("").to_owned();
+            Some(Preset { name, label, help, values })
+        })
+        .collect()
+}
+
+// ---------------------------------------------------------------------------- the share code
+//
+// Round 74 (A6, docs/rando/FULL_BLOCK.md section 7; tools/randomizer/sharecode.py is the twin,
+// both tested against tests/rando_sharecode_vectors.json): one short text with every setting
+// and the seed, `<head>-<body>-<check>-<seed>`, e.g. `R1FXX-B1-DC-demo-7`.
+// head  = "R1" + the game ("F" Fates, "S" Seal of Flames) + the layout (2 characters);
+// body  = every share row's value index, bit-packed, 5 bits a character;
+// check = fnv1a32(head-body-seed) & 0x3FF in 2 characters.
+
+/// Crockford base 32: the share code's characters.
+pub const SHARE_ALPHABET: &[u8; 32] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+pub const SHARE_NOT_A_CODE: &str = "This is not a share code.";
+pub const SHARE_TYPO: &str = "This code has a typo.";
+pub const SHARE_OTHER_VERSION: &str = "This code was made by another version of the randomizer.";
+pub const SHARE_DAMAGED: &str = "This code is damaged.";
+/// call 3: the Share code row's help line
+pub const SHARE_HELP: &str = "Copy or paste this. The same code makes the same game.";
+pub const SHARE_COPIED: &str = "Share code copied. The same code makes the same game.";
+pub const SHARE_USED: &str = "Share code used: every setting and the seed come from it.";
+pub const SHARE_PASTE_HOW: &str = "Press Ctrl+V to paste a share code into the box; it is used at once.";
+
+/// why a share code is refused: `kind` is format, check, layout, game or damaged; `message`
+/// its one plain sentence.
+#[derive(Debug, Clone, PartialEq)]
+pub struct ShareError {
+    pub kind: &'static str,
+    pub message: String,
+}
+
+/// FNV-1a 32 over the text's UTF-8 bytes (the constants run ids use).
+pub fn fnv1a32(text: &str) -> u32 {
+    text.bytes().fold(0x811C_9DC5u32, |h, b| (h ^ u32::from(b)).wrapping_mul(0x0100_0193))
+}
+
+/// value & 0x3FF as 2 characters, the high 5 bits first.
+fn ten_bits(value: u32) -> String {
+    let v = (value & 0x3FF) as usize;
+    [SHARE_ALPHABET[v >> 5] as char, SHARE_ALPHABET[v & 31] as char].iter().collect()
+}
+
+/// the rows a code carries: not page-only, not the seed, sorted by key (byte order). Hidden,
+/// fixed and game-hidden rows are in it, so the same code gives the same answer.
+pub fn share_rows(rows: &[Row]) -> Vec<&Row> {
+    let mut out: Vec<&Row> = rows.iter().filter(|row| !row.page_only && row.kind != Kind::Seed && row.key != "seed").collect();
+    out.sort_by(|a, b| a.key.as_bytes().cmp(b.key.as_bytes()));
+    out
+}
+
+fn share_radix(row: &Row) -> u64 {
+    match &row.kind {
+        Kind::OnOff => 2,
+        Kind::Choice(choices) => (choices.len() as u64).max(1),
+        Kind::Number(min, max) => ((max - min + 1).max(1)) as u64,
+        Kind::Seed => 1,
+    }
+}
+
+/// bits a row takes: the bit length of (radix - 1).
+fn share_width(row: &Row) -> u32 {
+    64 - (share_radix(row) - 1).leading_zeros()
+}
+
+/// a value's index in its row; a value that does not fit counts as the row's default (the
+/// form never holds one), and a default that does not fit either as 0 (as sharecode.py).
+fn share_index(row: &Row, value: &Value) -> u64 {
+    let of = |value: &Value| -> Option<u64> {
+        match (&row.kind, value) {
+            (Kind::OnOff, Value::Bool(on)) => Some(u64::from(*on)),
+            (Kind::Choice(choices), Value::String(choice)) => choices.iter().position(|c| c == choice).map(|i| i as u64),
+            (Kind::Number(min, max), Value::Number(n)) => n.as_i64().filter(|n| (*min..=*max).contains(n)).map(|n| (n - min) as u64),
+            _ => None,
+        }
+    };
+    of(value).or_else(|| of(&row.default)).unwrap_or(0)
+}
+
+/// the value at an index below the row's radix.
+fn share_value(row: &Row, index: u64) -> Value {
+    match &row.kind {
+        Kind::OnOff => Value::Bool(index != 0),
+        Kind::Choice(choices) => choices.get(index as usize).map_or(Value::Null, |c| Value::String(c.clone())),
+        Kind::Number(min, _) => json!(min + index as i64),
+        Kind::Seed => Value::Null,
+    }
+}
+
+/// the text the layout is the hash of: one item per share row, joined with ";".
+pub fn share_layout_text(rows: &[Row]) -> String {
+    share_rows(rows)
+        .iter()
+        .map(|row| match &row.kind {
+            Kind::OnOff => format!("{}:onoff:2", row.key),
+            Kind::Choice(choices) => format!("{}:choice:{}", row.key, choices.join(",")),
+            Kind::Number(min, max) => format!("{}:number:{min},{max}", row.key),
+            Kind::Seed => format!("{}:seed", row.key),
+        })
+        .collect::<Vec<_>>()
+        .join(";")
+}
+
+/// the layout's 2 characters: a code made for other rows is refused.
+pub fn share_layout(rows: &[Row]) -> String {
+    ten_bits(fnv1a32(&share_layout_text(rows)))
+}
+
+/// the body's length in characters for these rows.
+pub fn share_body_length(rows: &[Row]) -> usize {
+    let bits: u32 = share_rows(rows).iter().map(|row| share_width(row)).sum();
+    (bits as usize + 4) / 5
+}
+
+fn share_game_letter(game: Option<&str>) -> char {
+    if game == Some("seal") { 'S' } else { 'F' }
+}
+
+/// the share code of these values (a row missing from `values` counts as its default) and
+/// `seed` for `game` (None = Fire Emblem Fates); None when the seed is not one the randomizer
+/// takes.
+pub fn share_encode(rows: &[Row], values: &Map<String, Value>, seed: &str, game: Option<&str>) -> Option<String> {
+    if !seed_ok(seed) {
+        return None;
+    }
+    let mut bits: Vec<usize> = Vec::new();
+    for row in share_rows(rows) {
+        let index = share_index(row, values.get(&row.key).unwrap_or(&row.default));
+        for b in 0..share_width(row) {
+            bits.push(((index >> b) & 1) as usize);
+        }
+    }
+    while bits.len() % 5 != 0 {
+        bits.push(0);
+    }
+    let body: String = bits
+        .chunks(5)
+        .map(|group| SHARE_ALPHABET[group.iter().enumerate().map(|(j, bit)| bit << j).sum::<usize>()] as char)
+        .collect();
+    let head = format!("R1{}{}", share_game_letter(game), share_layout(rows));
+    let check = ten_bits(fnv1a32(&format!("{head}-{body}-{seed}")));
+    Some(format!("{head}-{body}-{check}-{seed}"))
+}
+
+/// a share code's values (every share row) and seed, or why it is refused, in this order:
+/// format, check (a typo), layout (another version), game, damaged. Head, body and check are
+/// read case-blind (ASCII letters only); the seed is kept exactly; space around the code is
+/// ignored.
+pub fn share_decode(rows: &[Row], code: &str, game: Option<&str>) -> Result<(Map<String, Value>, String), ShareError> {
+    let refuse = |kind: &'static str, message: &str| ShareError { kind, message: message.to_owned() };
+    let parts: Vec<&str> = code.trim().splitn(4, '-').collect();
+    if parts.len() != 4 {
+        return Err(refuse("format", SHARE_NOT_A_CODE));
+    }
+    let (head, body, check, seed) = (parts[0].to_ascii_uppercase(), parts[1].to_ascii_uppercase(), parts[2].to_ascii_uppercase(), parts[3]);
+    if !head.is_ascii() || head.len() != 5 || !head.starts_with("R1") || !matches!(head.as_bytes()[2], b'F' | b'S') {
+        return Err(refuse("format", SHARE_NOT_A_CODE));
+    }
+    if check.len() != 2 || check != ten_bits(fnv1a32(&format!("{head}-{body}-{seed}"))) {
+        return Err(refuse("check", SHARE_TYPO));
+    }
+    if &head[3..5] != share_layout(rows).as_str() {
+        return Err(refuse("layout", SHARE_OTHER_VERSION));
+    }
+    let letter = head.as_bytes()[2] as char;
+    if letter != share_game_letter(game) {
+        let name = if letter == 'S' { "Seal of Flames" } else { "Fire Emblem Fates" };
+        return Err(refuse("game", &format!("This code is for {name}.")));
+    }
+    let digit = |c: u8| SHARE_ALPHABET.iter().position(|a| *a == c);
+    if body.len() != share_body_length(rows) || !body.bytes().all(|c| digit(c).is_some()) || !seed_ok(seed) {
+        return Err(refuse("damaged", SHARE_DAMAGED));
+    }
+    let bits: Vec<u64> = body.bytes().flat_map(|c| {
+        let d = digit(c).unwrap_or(0) as u64;
+        (0..5).map(move |j| (d >> j) & 1)
+    }).collect();
+    let mut at = 0usize;
+    let mut values = Map::new();
+    for row in share_rows(rows) {
+        let width = share_width(row) as usize;
+        let index = (0..width).map(|b| bits[at + b] << b).sum::<u64>();
+        at += width;
+        if index >= share_radix(row) {
+            return Err(refuse("damaged", SHARE_DAMAGED));
+        }
+        values.insert(row.key.clone(), share_value(row, index));
+    }
+    if bits[at..].iter().any(|bit| *bit != 0) {
+        return Err(refuse("damaged", SHARE_DAMAGED));
+    }
+    Ok((values, seed.to_owned()))
+}
