+    #[test]
+    fn keep_stays_on_a_short_screen_with_this_run_full() {
+        // round 74 (A9): "Randomize everything" lists 22 rows; at 800 x 480 Keep stays reachable
+        assert!(close(this_run_heights(480.0, 24), (72.0, 80.0)), "{:?}", this_run_heights(480.0, 24));
+        assert!(close(this_run_heights(480.0, 0), (0.0, 150.0)));
+        assert!(close(this_run_heights(960.0, 0), (0.0, 336.0)), "round 71's rows height on a tall screen");
+        assert!(close(this_run_heights(960.0, 24), (144.0, 336.0)));
+        let data = temp_data("fit");
+        let size = Vec2::new(800.0, 480.0);
+        let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, size);
+        let mut page = page_74();
+        page.this_run = ThisRun {
+            seed: Some("fit74".into()),
+            changed: (0..22).map(|n| format!("A changed setting number {n}: On")).collect(),
+            spoiler: Some(data.join("spoiler.txt")),
+            notices: vec!["A notice from the core.".into(), "Another notice from the core.".into()],
+        };
+        page.this_run_open = true;
+        let ctx = egui::Context::default();
+        let mut time = 0.0;
+        let mut frame = |page: &mut RandoPage, events: Vec<egui::Event>| {
+            time += 1.0 / 60.0;
+            let input = egui::RawInput { screen_rect: Some(screen), time: Some(time), focused: true, events, ..Default::default() };
+            ctx.run_ui(input, |ui| {
+                page.draw_new_game(ui.ctx(), Some(&data));
+                page.draw_this_run(ui.ctx(), Some(&data));
+            })
+            .drop_without_applying_deltas();
+        };
+        for _ in 0..4 {
+            frame(&mut page, vec![]);
+        }
+        for key in ["next:btn:keep", "next:btn:defaults", "next:btn:everything_on", "next:help:line", "next:btn:preset:wild"] {
+            assert!(screen.contains_rect(target(&page, key)), "{key} {:?} off {screen:?}", target(&page, key));
+        }
+        let window = ctx.memory(|memory| memory.area_rect(egui::Id::new("rando this run"))).unwrap();
+        assert!(window.max.y <= screen.max.y + 0.5, "{window:?}");
+        // a real click on Keep lands (last.json written)
+        let at = target(&page, "next:btn:keep").center();
+        frame(&mut page, vec![egui::Event::PointerMoved(at), egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() }]);
+        frame(&mut page, vec![egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() }]);
+        frame(&mut page, vec![]);
+        assert!(last_path(&data).is_file(), "Keep was reachable and kept");
+        // at rest, the part's help line says Keep keeps the seed (call 6)
+        let draft = page.next_form.as_ref().unwrap();
+        assert_eq!(help_for(draft, &[], None, None, NEXT_HELP_REST), NEXT_HELP_REST);
+        assert!(NEXT_HELP_REST.len() < 90 && !NEXT_HELP_REST.contains('\n'));
+        let _ = std::fs::remove_dir_all(&data);
+    }
