+    /// one page frame with these events, both windows drawn (no data folder); the texts the
+    /// frame's Copy put out through egui.
+    fn frame_with(ctx: &egui::Context, page: &mut RandoPage, size: Vec2, time: &mut f64, events: Vec<egui::Event>) -> Vec<String> {
+        *time += 1.0 / 60.0;
+        let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, size);
+        let input = egui::RawInput { screen_rect: Some(screen), time: Some(*time), focused: true, events, ..Default::default() };
+        let output = ctx.run_ui(input, |ui| {
+            page.draw_new_game(ui.ctx(), None);
+            if page.this_run_open {
+                page.draw_this_run(ui.ctx(), None);
+            }
+        });
+        let copied = output.platform_output.commands.iter().filter_map(|command| match command {
+            egui::OutputCommand::CopyText(text) => Some(text.clone()),
+            _ => None,
+        }).collect();
+        output.drop_without_applying_deltas();
+        copied
+    }
+
+    /// a click at the control's reported rectangle (press, release, one more frame).
+    fn click_at(ctx: &egui::Context, page: &mut RandoPage, size: Vec2, time: &mut f64, key: &str) -> Vec<String> {
+        let at = target(page, key).center();
+        let press = vec![
+            egui::Event::PointerMoved(at),
+            egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() },
+        ];
+        let release = vec![egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() }];
+        let mut copied = frame_with(ctx, page, size, time, press);
+        copied.extend(frame_with(ctx, page, size, time, release));
+        copied.extend(frame_with(ctx, page, size, time, vec![]));
+        copied
+    }
