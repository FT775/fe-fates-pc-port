+        assert_eq!(n.dead[0].chapter, "A007");
+        assert_eq!(n.mode_undone, 1, "Casual was switched back");
+        assert_eq!(m.r32(GUD + 0x28).unwrap() & MODE_NOT_CLASSIC, 0);
+        // written at once: a reload of the file knows it
+        let back = Nuz::load(&data, &n.gid, "s-1", None).unwrap();
+        assert!(back.is_dead("PID_4"));
