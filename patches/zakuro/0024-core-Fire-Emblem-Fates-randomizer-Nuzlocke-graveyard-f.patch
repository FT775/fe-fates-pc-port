+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+
+    #[derive(Default)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+    }
+
+    impl Fake {
+        fn put(&mut self, at: u32, data: &[u8]) {
+            self.blocks.insert(at, data.to_vec());
+        }
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, addr: u32, data: &[u8]) {
+            let (b, o) = self.find(addr, data.len() as u32).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + data.len()].copy_from_slice(data);
+        }
+    }
+
+    const POOL: u32 = 0x3000_0000; // the forces (12 x 10)
+    const UNITS: u32 = 0x3100_0000; // unit i at UNITS + 0x200 * i
+    const PERSONS: u32 = 0x3200_0000; // person i at PERSONS + 0x100 * i, label at +0x80
+    const GUD: u32 = 0x3300_0000;
+    const CFG: u32 = 0x3400_0000;
+
+    fn unit(i: u32) -> u32 {
+        UNITS + 0x200 * i
+    }
+
+    /// a game: GameConfigData +0xB = 0 (playing), GameUserData Casual, chapter "CID_A007",
+    /// persons PID_0..PID_5, units 0..2 in force 0, 3 in force 3, 4 in force 4.
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        m.put(UNIT_POOL, &[0; 8]);
+        m.put(GAME_USER_DATA, &GUD.to_le_bytes());
+        m.put(GAME_CONFIG, &CFG.to_le_bytes());
+        let mut cfg = vec![0u8; 0x20];
+        cfg[0xB] = 0;
+        m.put(CFG, &cfg);
+        let mut gud = vec![0u8; 0x40];
+        gud[0xC..0x10].copy_from_slice(&(GUD + 0x30).to_le_bytes());
+        gud[0x28..0x2C].copy_from_slice(&0x4u32.to_le_bytes());
+        gud[0x30..0x34].copy_from_slice(&(GUD + 0x38).to_le_bytes());
+        m.put(GUD, &gud);
+        m.put(GUD + 0x38, b"CID_A007\0");
+        let mut pool = vec![0u8; 120];
+        for f in 0..10u8 {
+            pool[12 * f as usize + 8] = f;
+        }
+        m.put(POOL, &pool);
+        m.put(UNIT_POOL + 4, &POOL.to_le_bytes());
+        m.put(UNIT_POOL, &[0; 4]);
+        for i in 0..6u32 {
+            let mut p = vec![0u8; 0x100];
+            p[8..12].copy_from_slice(&(PERSONS + 0x100 * i + 0x80).to_le_bytes());
+            let label = format!("PID_{i}\0");
+            p[0x80..0x80 + label.len()].copy_from_slice(label.as_bytes());
+            m.put(PERSONS + 0x100 * i, &p);
+            let mut u = vec![0u8; 0x200];
+            u[0x9C..0xA0].copy_from_slice(&(PERSONS + 0x100 * i).to_le_bytes());
+            u[0x8..0xC].copy_from_slice(&0xFFFF_FFFFu32.wrapping_sub(UNIT_GUEST).to_le_bytes());
+            m.put(unit(i), &u);
+        }
+        let join = |m: &mut Fake, f: u32, u: u32| {
+            let force = POOL + 12 * f;
+            m.write(u + 0xA4, &force.to_le_bytes());
+            let last = m.r32(force + 4).unwrap();
+            if last == 0 {
+                m.write(force, &u.to_le_bytes());
+            } else {
+                m.write(last + 0x14, &u.to_le_bytes());
+                m.write(u + 0x10, &last.to_le_bytes());
+            }
+            m.write(force + 4, &u.to_le_bytes());
+        };
+        for i in 0..3 {
+            join(&mut m, 0, unit(i));
+        }
+        join(&mut m, 3, unit(3));
+        join(&mut m, 4, unit(4));
+        m
+    }
+
+    fn pids(m: &mut Fake, f: u8) -> Vec<String> {
+        force_units(m, POOL, f).into_iter().map(|u| unit_pid(m, u).unwrap()).collect()
+    }
