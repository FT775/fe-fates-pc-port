+    #[test]
+    fn kill_follows_transfer_impl_and_keeps_lists_whole() {
+        let mut m = game();
+        // the middle unit of force 0 (PID_1)
+        m.write(unit(1) + 0xC, &0xFFu32.to_le_bytes());
+        m.write(unit(1) + 0x28, &[0xFF; 0x20]);
+        kill(&mut m, POOL, unit(1)).unwrap();
+        assert_eq!(pids(&mut m, 0), ["PID_0", "PID_2"]);
+        assert_eq!(pids(&mut m, 4), ["PID_4", "PID_1"]);
+        assert_eq!(m.r32(POOL + 4).unwrap(), unit(2), "force 0 last");
+        assert_eq!(m.r32(unit(2) + 0x10).unwrap(), unit(0), "prev link mended");
+        assert_eq!(m.r32(POOL + 48 + 4).unwrap(), unit(1));
+        assert_eq!(m.r32(unit(1) + 0xA4).unwrap(), POOL + 48);
+        assert_eq!(m.r32(unit(1) + 0xC).unwrap(), 0xFF & !0xA8);
+        assert_eq!(m.r32(unit(1) + 0x8).unwrap(), (0xFFFF_FFFFu32 - UNIT_GUEST) & DEAD_STATE_MASK);
+        let mut e = [0u8; 0x20];
+        m.read(unit(1) + 0x28, &mut e);
+        assert_eq!(&e[..5], &[0x01, 0xFF, 0x7F, 0x00, 0xFC]);
+        assert_eq!(&e[16..23], &[0; 7]);
+        // the first and the last unit too
+        kill(&mut m, POOL, unit(0)).unwrap();
+        kill(&mut m, POOL, unit(2)).unwrap();
+        assert!(pids(&mut m, 0).is_empty());
+        assert_eq!(m.r32(POOL).unwrap(), 0);
+        assert_eq!(m.r32(POOL + 4).unwrap(), 0);
+        assert_eq!(pids(&mut m, 4), ["PID_4", "PID_1", "PID_0", "PID_2"]);
+        // force 3: the list move only
+        m.write(unit(3) + 0xC, &0xFFu32.to_le_bytes());
+        kill(&mut m, POOL, unit(3)).unwrap();
+        assert_eq!(m.r32(unit(3) + 0xC).unwrap(), 0xFF, "no dead path from force 3");
+        // refused: on the map, a guest, already fallen
+        let mut m = game();
+        m.write(unit(1) + 0xB8, &1u32.to_le_bytes());
+        assert!(kill(&mut m, POOL, unit(1)).unwrap_err().contains("map"));
+        m.write(unit(2) + 0x8, &UNIT_GUEST.to_le_bytes());
+        assert!(kill(&mut m, POOL, unit(2)).unwrap_err().contains("guest"));
+        assert!(kill(&mut m, POOL, unit(4)).unwrap_err().contains("force 4"));
+        assert_eq!(pids(&mut m, 0), ["PID_0", "PID_1", "PID_2"]);
+    }
