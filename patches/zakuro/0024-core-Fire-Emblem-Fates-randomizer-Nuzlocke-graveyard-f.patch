+//! Fire Emblem Fates randomizer: Nuzlocke (engine round E2, round 60; docs/rando/NUZLOCKE.md,
+//! the rules in tools/randomizer/nuzlocke.py, Grok's picks in docs/collab/NUZLOCKE_E2_GROK.md).
+//!
+//! Nothing here runs unless the active randomized run was made with Nuzlocke on (its run
+//! folder holds `nuzlocke.json`, written by `rando.py make`) and a Nuzlocke game is active
+//! (started at the New Game mode pick, or loaded from a save / save state whose side file
+//! names its game id). With Nuzlocke off this module reads and writes nothing.
+//!
+//! Once per frame, while a game is going on (GameConfigData +0xB is not 1), it reads the
+//! army lists of the unit pool (`UnitPool` 0x006D9F40 +4: 12-byte forces, +0 first, +4
+//! last, +8 index; units linked by +0x10 prev / +0x14 next, +0xA4 their force, +0x9C their
+//! Person, whose +0x8 is the PID_ label):
+//!
+//! 1. **A death is written at once.** Force 4 holds the player's fallen (`Unit::TransferImpl`
+//!    0x003D5308 runs `unit::Enhance::Dead` only for force 4). Every person seen there who is
+//!    not in the graveyard yet is written to `<data>/rando/<title>/nuzlocke/<game id>.json`
+//!    (temp file + rename) in the frame it is seen, before the game can write any save.
+//!    Never written: the people in the rules' `game_over_not_recorded` (Corrin: that death
+//!    ends the game, and the chapter is replayed as usual).
+//! 2. **The fallen stay fallen.** Every person in the graveyard who is found in force 0 (the
+//!    army) or 3 (the army off the map, My Castle) is moved to force 4 exactly as
+//!    `Unit::TransferImpl(unit, 4, last=1)` does it (unit flags, `Enhance::Dead`,
+//!    `Force::Remove`, `Force::JoinLast`), so a reset, a reload, an older save, a battle save
+//!    or a save state never brings them back. Only a unit with no map actor (+0xB8 == 0) is
+//!    moved: a unit already drawn on a map waits (said once in the log) until it has none.
+//! 3. **Classic is locked.** GameUserData +0x28 bits 0x4 (Casual) and 0x8 (Phoenix) are
+//!    cleared whenever they are seen set: the New Game's pick and My Castle's mode switch
+//!    are both undone to Classic, and the log says so (the run is never voided).
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+
+use crate::fates_rando::{Guest, GAME_CONFIG, TITLE};
+
+/// the rules file `rando.py make` writes beside the run's patch.
+pub const RULES_FILE: &str = "nuzlocke.json";
+/// the graveyard format (tools/randomizer/nuzlocke.py `Ledger`, LEDGER_VERSION / TOOL).
+pub const LEDGER_VERSION: u32 = 1;
+pub const LEDGER_TOOL: &str = "rando-nuzlocke-v1";
+
+/// `G_UnitPool`; +4 the forces (12 bytes each).
+pub const UNIT_POOL: u32 = 0x006D_9F40;
+/// `G_GameUserData`; +0x28 the mode flags, +0xC the chapter row.
+pub const GAME_USER_DATA: u32 = 0x006D_A248;
+pub const FORCE_PLAYER: u8 = 0;
+pub const FORCE_RESERVE: u8 = 3;
+pub const FORCE_DEAD: u8 = 4;
+/// GameUserData +0x28: Casual (DifficultyIsCasual 0x003AC324) and Phoenix (0x003AC820).
+pub const MODE_NOT_CLASSIC: u32 = 0x4 | 0x8;
+/// Unit +0x8: a unit the game sends to force 9 instead of 3 or more (never recorded).
+pub const UNIT_GUEST: u32 = 0x4_0000;
+/// Unit::TransferImpl's mask for Unit +0x8 on the way to force 4 (the word at 0x003D5478).
+pub const DEAD_STATE_MASK: u32 = 0xF824_81DE;
+const MAX_UNITS: u32 = 512;
+
+/// one written death.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Dead {
+    pub pid: String,
+    pub chapter: String,
+    pub cause: String,
+    pub at: String,
+}
+
+/// one line of the log.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Event {
+    pub at: String,
+    pub what: String,
+    pub detail: String,
+}
+
+/// one Nuzlocke game: its rules, graveyard and log.
+#[derive(Debug, Clone)]
+pub struct Nuz {
+    pub gid: String,
+    pub run: String,
+    pub path: PathBuf,
+    /// the rules file's text (kept whole in the graveyard file)
+    rules: String,
+    pub recruits: String,
+    pub never_recorded: Vec<String>,
+    pub started: String,
+    pub dead: Vec<Dead>,
+    pub events: Vec<Event>,
+    /// people whose re-kill waits for their map actor to go (said once each)
+    waiting: HashSet<String>,
+    /// counters for the log and tests
+    pub kills: u32,
+    pub mode_undone: u32,
+}
+
+/// `<data>/rando/<title>/nuzlocke/<game id>.json`
+pub fn ledger_path(data: &Path, gid: &str) -> PathBuf {
+    data.join("rando").join(format!("{TITLE:016X}")).join("nuzlocke").join(format!("{gid}.json"))
+}
+
+/// a game id is 1-32 lower-case hex digits.
+pub fn gid_ok(gid: &str) -> bool {
+    (1..=32).contains(&gid.len()) && gid.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+/// a new game's id: 16 hex digits from the OS's per-process random keys and the clock
+/// (never the game's own dice).
+pub fn new_gid() -> String {
+    use std::hash::{BuildHasher, Hasher};
+    let mut h = std::collections::hash_map::RandomState::new().build_hasher();
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+    h.write_u128(now);
+    h.write_u32(std::process::id());
+    format!("{:016x}", h.finish())
+}
+
+fn now() -> String {
+    chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string()
+}
+
+fn esc(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// a string or bare value of a top-level key of a flat JSON object.
+pub fn field(text: &str, key: &str) -> Option<String> {
+    crate::fates_rando_session::json_field(text, key)
+}
+
+/// the text between the `[` after `"key"` and its matching `]` (strings may not hold brackets).
+fn array_text<'a>(text: &'a str, key: &str) -> Option<&'a str> {
+    let at = text.find(&format!("\"{key}\""))?;
+    let rest = &text[at + key.len() + 2..];
+    let open = rest.find('[')?;
+    if !rest[..open].trim().trim_start_matches(':').trim().is_empty() {
+        return None;
+    }
+    let body = &rest[open + 1..];
+    let (mut depth, mut in_str, mut esc_next) = (0i32, false, false);
+    for (i, c) in body.char_indices() {
+        if in_str {
+            match (esc_next, c) {
+                (true, _) => esc_next = false,
+                (false, '\\') => esc_next = true,
+                (false, '"') => in_str = false,
+                _ => {}
+            }
+            continue;
+        }
+        match c {
+            '"' => in_str = true,
+            '[' => depth += 1,
+            ']' if depth == 0 => return Some(&body[..i]),
+            ']' => depth -= 1,
+            _ => {}
+        }
+    }
+    None
+}
+
+/// the strings of a JSON array of strings under `key`.
+pub fn str_list(text: &str, key: &str) -> Vec<String> {
+    let Some(body) = array_text(text, key) else { return Vec::new() };
+    let mut out = Vec::new();
+    let mut rest = body;
+    while let Some(s) = rest.find('"') {
+        let mut cur = String::new();
+        let mut esc_next = false;
+        let mut end = None;
+        for (i, c) in rest[s + 1..].char_indices() {
+            match (esc_next, c) {
+                (true, c) => { cur.push(c); esc_next = false; }
+                (false, '\\') => esc_next = true,
+                (false, '"') => { end = Some(s + 1 + i + 1); break; }
+                (false, c) => cur.push(c),
+            }
+        }
+        let Some(e) = end else { break };
+        out.push(cur);
+        rest = &rest[e..];
+    }
+    out
+}
+
+/// the objects (`{...}`, not nested) of a JSON array under `key`, as texts.
+fn objects(text: &str, key: &str) -> Vec<String> {
+    let Some(body) = array_text(text, key) else { return Vec::new() };
+    let mut out = Vec::new();
+    let (mut start, mut in_str, mut esc_next, mut depth) = (None, false, false, 0);
+    for (i, c) in body.char_indices() {
+        if in_str {
+            match (esc_next, c) {
+                (true, _) => esc_next = false,
+                (false, '\\') => esc_next = true,
+                (false, '"') => in_str = false,
+                _ => {}
+            }
+            continue;
+        }
+        match c {
+            '"' => in_str = true,
+            '{' => {
+                if depth == 0 {
+                    start = Some(i);
+                }
+                depth += 1;
+            }
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    if let Some(s) = start.take() {
+                        out.push(body[s..=i].to_string());
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// the rules of a run made with Nuzlocke on (None: no rules file = Nuzlocke off).
+pub fn read_rules(run_dir: &Path) -> Option<Result<String, String>> {
+    let path = run_dir.join(RULES_FILE);
+    let text = match std::fs::read_to_string(&path) {
+        Ok(t) => t,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return None,
+        Err(e) => return Some(Err(format!("{}: {e}", path.display()))),
+    };
+    if field(&text, "nuzlocke").as_deref() != Some("true") {
+        return Some(Err(format!("{}: not a Nuzlocke rules file", path.display())));
+    }
+    Some(Ok(text))
+}
+
+impl Nuz {
+    fn from_rules(path: PathBuf, gid: &str, run: &str, rules: String) -> Nuz {
+        let recruits = field(&rules, "recruits").unwrap_or_else(|| "all".into());
+        // the labels as the game holds them (cp932 bytes), as keys (`label_key`); a rules file
+        // without the keys list (hand-made, ASCII labels) gives its plain list
+        let mut never_recorded = str_list(&rules, "game_over_not_recorded_keys");
+        if never_recorded.is_empty() {
+            never_recorded = str_list(&rules, "game_over_not_recorded");
+        }
+        Nuz {
+            gid: gid.to_string(), run: run.to_string(), path, rules, recruits, never_recorded,
+            started: now(), dead: Vec::new(), events: Vec::new(), waiting: HashSet::new(), kills: 0, mode_undone: 0,
+        }
+    }
+
+    /// a new Nuzlocke game of run `run` (the New Game mode pick): a new id and an empty
+    /// graveyard, written at once.
+    pub fn new_game(data: &Path, run: &str, rules: String) -> Result<Nuz, String> {
+        let gid = new_gid();
+        let mut n = Nuz::from_rules(ledger_path(data, &gid), &gid, run, rules);
+        n.event("new game", &format!("run {run}, recruits={}", n.recruits));
+        n.save().map_err(|e| format!("{}: {e}", n.path.display()))?;
+        Ok(n)
+    }
+
+    /// the Nuzlocke game `gid` of run `run` (a save or a save state named it). A missing
+    /// graveyard starts empty (and says so) with the run's rules.
+    pub fn load(data: &Path, gid: &str, run: &str, rules: Option<String>) -> Result<Nuz, String> {
+        if !gid_ok(gid) {
+            return Err(format!("the Nuzlocke game id {gid:?} is not 1-32 hex digits"));
+        }
+        let path = ledger_path(data, gid);
+        let text = match std::fs::read_to_string(&path) {
+            Ok(t) => t,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                let rules = rules.ok_or_else(|| format!("{}: missing, and the run has no rules file", path.display()))?;
+                let mut n = Nuz::from_rules(path, gid, run, rules);
+                n.event("graveyard missing", "started again empty (the file was not found)");
+                n.save().map_err(|e| format!("{}: {e}", n.path.display()))?;
+                return Ok(n);
+            }
+            Err(e) => return Err(format!("{}: {e}", path.display())),
+        };
+        if field(&text, "version").as_deref() != Some(&LEDGER_VERSION.to_string())
+            || field(&text, "tool").as_deref() != Some(LEDGER_TOOL)
+        {
+            return Err(format!("{}: not a {LEDGER_TOOL} graveyard", path.display()));
+        }
+        let rules_text = rules_object(&text).or(rules).unwrap_or_else(|| "{\"nuzlocke\": true}".into());
+        let mut n = Nuz::from_rules(path, gid, field(&text, "run").as_deref().unwrap_or(run), rules_text);
+        n.started = field(&text, "started").unwrap_or_else(now);
+        for o in objects(&text, "dead") {
+            if let Some(pid) = field(&o, "pid") {
+                n.dead.push(Dead {
+                    pid,
+                    chapter: field(&o, "chapter").unwrap_or_default(),
+                    cause: field(&o, "cause").unwrap_or_else(|| "battle".into()),
+                    at: field(&o, "at").unwrap_or_default(),
+                });
+            }
+        }
+        for o in objects(&text, "events") {
+            n.events.push(Event {
+                at: field(&o, "at").unwrap_or_default(),
+                what: field(&o, "what").unwrap_or_default(),
+                detail: field(&o, "detail").unwrap_or_default(),
+            });
+        }
+        Ok(n)
+    }
+
+    pub fn is_dead(&self, pid: &str) -> bool {
+        self.dead.iter().any(|d| d.pid == pid)
+    }
+
+    fn event(&mut self, what: &str, detail: &str) {
+        self.events.push(Event { at: now(), what: what.into(), detail: detail.into() });
+    }
+
+    /// the graveyard file in tools/randomizer/nuzlocke.py's `Ledger` format (that tool's
+    /// `log` command prints it), written whole then renamed.
+    pub fn save(&self) -> std::io::Result<()> {
+        let mut s = String::new();
+        s.push_str("{\n");
+        s.push_str(&format!(" \"dead\": [{}],\n", self.dead.iter().map(|d| format!(
+            "\n  {{\"at\": \"{}\", \"cause\": \"{}\", \"chapter\": \"{}\", \"name\": \"\", \"pid\": \"{}\", \"turn\": 0}}",
+            esc(&d.at), esc(&d.cause), esc(&d.chapter), esc(&d.pid))).collect::<Vec<_>>().join(",")));
+        s.push_str(&format!(" \"events\": [{}],\n", self.events.iter().map(|e| format!(
+            "\n  {{\"at\": \"{}\", \"detail\": \"{}\", \"what\": \"{}\"}}", esc(&e.at), esc(&e.detail), esc(&e.what)))
+            .collect::<Vec<_>>().join(",")));
+        s.push_str(" \"first_recruit\": {},\n");
+        s.push_str(&format!(" \"game_id\": \"{}\",\n", esc(&self.gid)));
+        s.push_str(" \"joined\": [],\n");
+        s.push_str(&format!(" \"rules\": {},\n", self.rules.trim()));
+        s.push_str(&format!(" \"run\": \"{}\",\n", esc(&self.run)));
+        s.push_str(&format!(" \"started\": \"{}\",\n", esc(&self.started)));
+        s.push_str(&format!(" \"tool\": \"{LEDGER_TOOL}\",\n"));
+        s.push_str(&format!(" \"version\": {LEDGER_VERSION},\n"));
+        s.push_str(" \"voided\": null\n}\n");
+        let dir = self.path.parent().unwrap_or(Path::new("."));
+        std::fs::create_dir_all(dir)?;
+        let mut tmp = self.path.as_os_str().to_owned();
+        tmp.push(".tmp");
+        let tmp = PathBuf::from(tmp);
+        std::fs::write(&tmp, s)?;
+        std::fs::rename(&tmp, &self.path)
+    }
+
+    /// after a frame while a game is going on: deaths written, the fallen kept fallen,
+    /// Classic kept. Returns lines for the log (problems only); writes the graveyard when
+    /// something changed.
+    pub fn frame(&mut self, g: &mut dyn Guest) -> Vec<String> {
+        let mut notes = Vec::new();
+        let mut changed = false;
+        // 3. Classic
+        if let Some(gud) = g.r32(GAME_USER_DATA).filter(|&a| a != 0) {
+            if let Some(flags) = g.r32(gud.wrapping_add(0x28)) {
+                if flags & MODE_NOT_CLASSIC != 0 {
+                    g.write(gud.wrapping_add(0x28), &(flags & !MODE_NOT_CLASSIC).to_le_bytes());
+                    self.mode_undone += 1;
+                    let was = if flags & 0x8 != 0 { "Phoenix" } else { "Casual" };
+                    self.event("classic kept", &format!("{was} was picked; switched back to Classic"));
+                    log::info!("fates_rando: Nuzlocke: {was} switched back to Classic");
+                    changed = true;
+                }
+            }
+        }
+        let Some(pool) = g.r32(UNIT_POOL + 4).filter(|&p| p != 0) else {
+            if changed {
+                let _ = self.save();
+            }
+            return notes;
+        };
+        // 1. deaths
+        let chapter = chapter(g);
+        for unit in force_units(g, pool, FORCE_DEAD) {
+            let Some(pid) = unit_pid(g, unit) else { continue };
+            if self.is_dead(&pid) || self.never_recorded.contains(&pid) {
+                continue;
+            }
+            log::info!("fates_rando: Nuzlocke: {pid} fell in {chapter}: written to the graveyard");
+            self.dead.push(Dead { pid: pid.clone(), chapter: chapter.clone(), cause: "battle".into(), at: now() });
+            self.event("death", &format!("{pid} in {chapter}, turn 0 (battle)"));
+            changed = true;
+        }
+        // 2. the fallen stay fallen
+        for force in [FORCE_PLAYER, FORCE_RESERVE] {
+            for unit in force_units(g, pool, force) {
+                let Some(pid) = unit_pid(g, unit) else { continue };
+                if !self.is_dead(&pid) {
+                    continue;
+                }
+                match kill(g, pool, unit) {
+                    Ok(()) => {
+                        self.kills += 1;
+                        self.waiting.remove(&pid);
+                        log::info!("fates_rando: Nuzlocke: {pid} is in the graveyard: moved to the fallen again");
+                        self.event("dead again", &format!("{pid} was alive in the loaded game (force {force}): fallen again"));
+                        changed = true;
+                    }
+                    Err(why) => {
+                        if self.waiting.insert(pid.clone()) {
+                            notes.push(format!("Nuzlocke: {pid} is in the graveyard but {why}; it is moved as soon as it can be"));
+                        }
+                    }
+                }
+            }
+        }
+        if changed {
+            if let Err(e) = self.save() {
+                notes.push(format!("Nuzlocke: the graveyard {} could not be written: {e}", self.path.display()));
+            }
+        }
+        notes
+    }
+
+    /// the readable log (the Esc page's "This run").
+    pub fn text(&self) -> String {
+        let mut out = format!("Nuzlocke game {} (run {}), started {}\nGraveyard ({}):\n", self.gid, self.run,
+                              self.started, self.dead.len());
+        for d in &self.dead {
+            out.push_str(&format!("  {}: {} ({})\n", d.pid, d.chapter, d.at));
+        }
+        out
+    }
+}
+
+/// the `rules` object of a graveyard file, as text.
+fn rules_object(text: &str) -> Option<String> {
+    let at = text.find("\"rules\"")?;
+    let rest = &text[at + 7..];
+    let open = rest.find('{')?;
+    let body = &rest[open..];
+    let (mut depth, mut in_str, mut esc_next) = (0i32, false, false);
+    for (i, c) in body.char_indices() {
+        if in_str {
+            match (esc_next, c) {
+                (true, _) => esc_next = false,
+                (false, '\\') => esc_next = true,
+                (false, '"') => in_str = false,
+                _ => {}
+            }
+            continue;
+        }
+        match c {
+            '"' => in_str = true,
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(body[..=i].to_string());
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+fn r8(g: &mut dyn Guest, addr: u32) -> Option<u8> {
+    if !g.readable(addr, 1) {
+        return None;
+    }
+    let mut b = [0u8; 1];
+    g.read(addr, &mut b);
+    Some(b[0])
+}
+
+fn w8(g: &mut dyn Guest, addr: u32, v: u8) {
+    g.write(addr, &[v]);
+}
+
+fn w32(g: &mut dyn Guest, addr: u32, v: u32) {
+    g.write(addr, &v.to_le_bytes());
+}
+
+/// the units of one force, first to last.
+pub fn force_units(g: &mut dyn Guest, pool: u32, force: u8) -> Vec<u32> {
+    let mut out = Vec::new();
+    let mut unit = g.r32(pool.wrapping_add(12 * force as u32)).unwrap_or(0);
+    while unit != 0 && (out.len() as u32) < MAX_UNITS {
+        if !g.readable(unit, 0xC0) || out.contains(&unit) {
+            break;
+        }
+        out.push(unit);
+        unit = g.r32(unit.wrapping_add(0x14)).unwrap_or(0);
+    }
+    out
+}
+
+/// a label's key: its bytes as the game holds them (cp932), printable ASCII kept and every
+/// other byte (and `%`, `"`, `\`) as `%HH`, so two labels never share a key
+/// (tools/randomizer/nuzlocke.py `pid_key` makes the same from the tables).
+pub fn label_key(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len());
+    for &b in bytes {
+        if b.is_ascii_graphic() && b != b'%' && b != b'"' && b != b'\\' {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+/// a unit's person key (Unit +0x9C Person, Person +0x8 its PID_ label, `label_key`).
+pub fn unit_pid(g: &mut dyn Guest, unit: u32) -> Option<String> {
+    let person = g.r32(unit.wrapping_add(0x9C)).filter(|&p| p != 0)?;
+    let label = g.r32(person.wrapping_add(0x8)).filter(|&p| p != 0)?;
+    let bytes = g.cstr(label, 64)?;
+    if bytes.is_empty() {
+        return None;
+    }
+    Some(label_key(&bytes))
+}
+
+/// the chapter being played (GameUserData +0xC row, its label after "CID_"), or "?".
+pub fn chapter(g: &mut dyn Guest) -> String {
+    let Some(gud) = g.r32(GAME_USER_DATA).filter(|&a| a != 0) else { return "?".into() };
+    let Some(row) = g.r32(gud.wrapping_add(0xC)).filter(|&a| a != 0) else { return "?".into() };
+    let Some(s) = g.r32(row).filter(|&a| a != 0) else { return "?".into() };
+    match g.cstr(s, 64) {
+        Some(b) if b.len() > 4 => String::from_utf8_lossy(&b[4..]).into_owned(),
+        _ => "?".into(),
+    }
+}
+
+/// moves `unit` (force 0 or 3, no map actor) to force 4 as `Unit::TransferImpl(unit, 4, 1)`
+/// does: from force 0 the dead path (Unit +0xC &= ~0xA8, +0x8 &= DEAD_STATE_MASK,
+/// `unit::Enhance::Dead` on Unit +0x28, +0x12D and +0x135 cleared); from force 3 the list
+/// move only (TransferImpl skips the dead path for a unit off the map); then
+/// `Force::Remove` from its force and `Force::JoinLast` into force 4.
+pub fn kill(g: &mut dyn Guest, pool: u32, unit: u32) -> Result<(), String> {
+    let force = g.r32(unit.wrapping_add(0xA4)).filter(|&f| f != 0).ok_or("it has no force")?;
+    let idx = r8(g, force.wrapping_add(8)).ok_or("its force is unreadable")?;
+    if idx != FORCE_PLAYER && idx != FORCE_RESERVE {
+        return Err(format!("it is in force {idx}"));
+    }
+    if force != pool.wrapping_add(12 * idx as u32) {
+        return Err("its force is not the pool's".into());
+    }
+    let state = g.r32(unit.wrapping_add(0x8)).ok_or("it is unreadable")?;
+    if state & UNIT_GUEST != 0 {
+        return Err("it is a guest (the game never records a guest's death)".into());
+    }
+    if g.r32(unit.wrapping_add(0xB8)).unwrap_or(1) != 0 {
+        return Err("it is drawn on the map now".into());
+    }
+    let dead = pool.wrapping_add(12 * FORCE_DEAD as u32);
+    if r8(g, dead.wrapping_add(8)) != Some(FORCE_DEAD) {
+        return Err("force 4 is not where it should be".into());
+    }
+    if idx == FORCE_PLAYER {
+        let c = g.r32(unit.wrapping_add(0xC)).unwrap_or(0);
+        w32(g, unit.wrapping_add(0xC), c & !0xA8);
+        w32(g, unit.wrapping_add(0x8), state & DEAD_STATE_MASK);
+        let e = unit.wrapping_add(0x28);
+        let b4 = r8(g, e + 4).unwrap_or(0);
+        w8(g, e + 4, b4 & !0x03);
+        let b2 = r8(g, e + 2).unwrap_or(0);
+        w8(g, e + 2, b2 & !0x80);
+        w8(g, e + 3, 0);
+        let b0 = r8(g, e).unwrap_or(0);
+        w8(g, e, b0 & 0x01);
+        g.write(e + 16, &[0u8; 7]);
+        w8(g, unit.wrapping_add(0x12D), 0);
+        w8(g, unit.wrapping_add(0x135), 0);
+    }
+    // Force::Remove(force, unit) 0x0041C840
+    let prev = g.r32(unit.wrapping_add(0x10)).unwrap_or(0);
+    let next = g.r32(unit.wrapping_add(0x14)).unwrap_or(0);
+    if next != 0 {
+        w32(g, next.wrapping_add(0x10), prev);
+    } else {
+        w32(g, force.wrapping_add(4), prev);
+        if prev != 0 {
+            w32(g, prev.wrapping_add(0x14), 0);
+        }
+    }
+    if prev != 0 {
+        w32(g, prev.wrapping_add(0x14), next);
+    } else {
+        w32(g, force, next);
+        if next != 0 {
+            w32(g, next.wrapping_add(0x10), 0);
+        }
+    }
+    w32(g, unit.wrapping_add(0x10), 0);
+    w32(g, unit.wrapping_add(0x14), 0);
+    // Force::JoinLast(dead, unit) 0x0041C894
+    w32(g, unit.wrapping_add(0xA4), dead);
+    let last = g.r32(dead.wrapping_add(4)).unwrap_or(0);
+    if last == 0 {
+        w32(g, dead, unit);
+    } else {
+        w32(g, last.wrapping_add(0x14), unit);
+        w32(g, unit.wrapping_add(0x10), last);
+    }
+    w32(g, dead.wrapping_add(4), unit);
+    Ok(())
+}
+
+/// GameConfigData +0xB is not 1: a game is going on (the title and the mode pick have 1).
+pub fn in_game(g: &mut dyn Guest) -> bool {
+    let Some(cfg) = g.r32(GAME_CONFIG).filter(|&c| c != 0) else { return false };
+    matches!(r8(g, cfg.wrapping_add(0xB)), Some(b) if b != 1)
+}
