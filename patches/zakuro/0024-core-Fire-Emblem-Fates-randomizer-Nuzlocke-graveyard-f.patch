+    #[test]
+    fn deaths_written_at_once_and_kept_after_a_reload() {
+        let data = tmp("deaths");
+        let mut m = game();
+        let mut n = Nuz::new_game(&data, "s-1", RULES.into()).unwrap();
+        assert!(gid_ok(&n.gid));
+        assert!(n.path.ends_with(format!("rando/0004000000179800/nuzlocke/{}.json", n.gid)));
+        assert!(in_game(&mut m));
