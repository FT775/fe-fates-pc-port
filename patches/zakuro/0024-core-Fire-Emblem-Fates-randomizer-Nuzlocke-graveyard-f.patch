+        m.write(f4 + 4, &0u32.to_le_bytes());
+        // unit 4 into force 3 after unit 3
+        m.write(unit(4) + 0xA4, &(POOL + 36).to_le_bytes());
+        m.write(unit(3) + 0x14, &unit(4).to_le_bytes());
+        m.write(unit(4) + 0x10, &unit(3).to_le_bytes());
+        m.write(POOL + 36 + 4, &unit(4).to_le_bytes());
+        assert_eq!(pids(&mut m, 3), ["PID_3", "PID_4"]);
+        let mut n = back;
+        n.frame(&mut m);
+        assert_eq!(pids(&mut m, 3), ["PID_3"]);
+        assert_eq!(pids(&mut m, 4), ["PID_4"]);
+        assert_eq!(n.kills, 1);
+        assert_eq!(n.dead.len(), 1, "not written twice");
+        // a second frame changes nothing
+        n.frame(&mut m);
+        assert_eq!(n.kills, 1);
+        let _ = std::fs::remove_dir_all(&data);
