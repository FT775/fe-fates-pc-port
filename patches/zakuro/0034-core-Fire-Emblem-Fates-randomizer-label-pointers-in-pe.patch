+    /// round 74 (docs/rando/FULL_BLOCK.md section 2): a chapter person file with label
+    /// pointers, found in the Person list by its name and laid in memory after the game
+    /// stored it: a `g` cell (a label in GameData's pool), an `s` cell (a label in the file's
+    /// own pool) and a `v` cell, all or nothing, and put back by a revert. Made-up labels.
+    #[test]
+    fn person_file_label_pointers_are_laid_in_memory_all_or_nothing() {
+        let mut m = game();
+        // the person file R021 at data start PB: name pointer at +0 (the archive name), the
+        // aid pointer at +0x10 -> its own "AID_A" at +0x60, the name pointer at +0x14 -> its own
+        // "MPID_A" at +0x68, a byte at +0x20, its own "MPID_B" at +0x70
+        const PB: u32 = 0x3200_0020;
+        let mut blk = vec![0u8; 0x80];
+        blk[0..4].copy_from_slice(&(PB + 0x30).to_le_bytes());
+        blk[0x30..0x35].copy_from_slice(b"R021\0");
+        blk[0x10..0x14].copy_from_slice(&(PB + 0x60).to_le_bytes());
+        blk[0x14..0x18].copy_from_slice(&(PB + 0x68).to_le_bytes());
+        blk[0x20] = 5;
+        blk[0x60..0x66].copy_from_slice(b"AID_A\0");
+        blk[0x68..0x6F].copy_from_slice(b"MPID_A\0");
+        blk[0x70..0x77].copy_from_slice(b"MPID_B\0");
+        m.put(PB, &blk);
+        let mut node = vec![0u8; 12];
+        node[0..4].copy_from_slice(&PB.to_le_bytes());
+        m.put(0x2300_0000, &node);
+        m.put(PERSON_LIST, &0x2300_0000u32.to_le_bytes());
+        // GameData's pool gets "AID_B" at +0x120
+        let mut gdl = [0u8; 6];
+        gdl.copy_from_slice(b"AID_B\0");
+        m.write(GD + 0x120, &gdl);
+        let text = "fates-rando-patch 1
+seed r74test
+options {}
+gamedata-sha256 00
+file person GameData/Person/R021.bin.lz
+v 20 05 07
+p 10 4149445f41 4149445f42 g 120 60
+p 14 4d5049445f41 4d5049445f42 s 70 68
+end 3
+";
+        let patch = Patch::parse(text).unwrap();
+        let f = &patch.files[0];
+        assert_eq!(f.kind, Kind::Person);
+        let base = person_now(&mut m, "R021").unwrap();
+        assert_eq!(base, PB);
+        let gd = gamedata_start(&mut m).unwrap();
+        // a guard that fails (another mod changed the name pointer): nothing is written
+        let mut other = game();
+        let mut blk2 = blk.clone();
+        blk2[0x14..0x18].copy_from_slice(&(PB + 0x70).to_le_bytes());
+        other.put(PB, &blk2);
+        other.write(GD + 0x120, &gdl);
+        let before = other.writes;
+        assert!(apply_file(&mut other, f, PB, gd, false).is_err());
+        assert_eq!(other.writes, before);
+        // laid: the g cell points into GameData, the s cell into the file, the byte changed
+        assert_eq!(apply_file(&mut m, f, base, gd, false), Ok(3));
+        assert_eq!(m.u32_at(PB + 0x10), GD + 0x120);
+        assert_eq!(m.u32_at(PB + 0x14), PB + 0x70);
+        let name_at = m.u32_at(PB + 0x14);
+        assert_eq!(m.cstr(name_at, 16).unwrap(), b"MPID_B");
+        assert_eq!(m.r32(PB + 0x20).unwrap() & 0xFF, 7);
+        // and put back
+        assert_eq!(apply_file(&mut m, f, base, gd, true), Ok(3));
+        assert_eq!((m.u32_at(PB + 0x10), m.u32_at(PB + 0x14)), (PB + 0x60, PB + 0x68));
+        assert_eq!(m.r32(PB + 0x20).unwrap() & 0xFF, 5);
+    }
 }
