+/// how a file patched around the game's read is laid first.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Way {
+    /// patched inside the game's read (a too-big result still falls back to `Late` when
+    /// `late_ok`)
+    InRead,
+    /// laid in memory at the first system call after the game stored the file
+    Late,
+    /// kept original, with a notice
+    Refused,
+}
+
+/// files that have an in-memory path: placement files, and (round 60) chapter person files,
+/// found in the Person archive list by their name (patch 0018). Map settings have none:
+/// they are laid in the read or not at all, and say so (engine round E1).
+pub fn late_ok(kind: fates_rando::Kind) -> bool {
+    matches!(kind, fates_rando::Kind::Dispos | fates_rando::Kind::Person)
+}
+
+/// the first way a file is laid. Label pointers (class and item labels) are laid in memory
+/// after the game stores the file, never in the read: the round 58 robot check found them
+/// wrong in memory on every map whose file was patched in the read (A004: two units joined
+/// with no weapon), while the in-memory path laid every cell of every other file. Round 74
+/// (docs/rando/FULL_BLOCK.md section 2): a person file with label pointers (the full swap's
+/// aid / name / help cells, only in a run made with look = full) takes the same in-memory
+/// path as a placement file, all its cells together (its `v` cells too, all or nothing);
+/// a person file without them (every run the owner's page can make) is patched in the read
+/// exactly as before.
+pub fn first_way(kind: fates_rando::Kind, has_ptrs: bool) -> Way {
+    match (has_ptrs, late_ok(kind)) {
+        (false, _) => Way::InRead,
+        (true, true) => Way::Late,
+        (true, false) => Way::Refused,
+    }
+}
+
 fn make_placement(system: &mut System, k: usize) -> Option<Arc<Vec<u8>>> {
     let p = &system.rando.placements[k];
     let run = system.rando.run.as_ref()?;
     let f = run.patch.files.get(p.file)?.clone();
-    // label pointers (class and item labels) are laid in memory after the game stores the
-    // file, never in the read: the round 58 robot check found them wrong in memory on every
-    // map whose file was patched in the read (A004: two units joined with no weapon), while
-    // the in-memory path laid every cell of every other file
-    // (engine round E1) map settings have no in-memory path: they are laid in the read or
-    // not at all, and say so
-    let placement = f.kind == fates_rando::Kind::Dispos;
-    // round 60: a chapter person file too big for the read is laid in memory like a
-    // placement file (round 59 check: Seal of Flames R013 and R023, a few bytes over: "chapter
-    // people kept original"); found in the Person archive list by its name (patch 0018)
-    let late_ok = placement || (f.kind == fates_rando::Kind::Person && f.ptrs.is_empty());
-    if !f.ptrs.is_empty() && !placement {
-        notice(system, format!("{}: kept original (label pointers are laid only in placement files)", f.rel));
-        return None;
-    }
-    if !f.ptrs.is_empty() {
-        log::info!("fates_rando: {} has label pointers; laid in memory at the next system call after the game stores it", f.rel);
-        system.rando.placements[k].late = true;
-        return None;
+    let late_ok = late_ok(f.kind);
+    match first_way(f.kind, !f.ptrs.is_empty()) {
+        Way::Refused => {
+            notice(system, format!("{}: kept original (label pointers are laid only in placement and person files)", f.rel));
+            return None;
+        }
+        Way::Late => {
+            log::info!("fates_rando: {} has label pointers; laid in memory at the next system call after the game stores it", f.rel);
+            system.rando.placements[k].late = true;
+            return None;
+        }
+        Way::InRead => {}
     }
     let title = system.title.as_ref()?;
     let stored = if let Some(layered) = title.layered.as_ref() {
@@ -1737,4 +1766,20 @@ end 0
         assert_eq!(&whole[150..250], &patched[..]);
         assert!(whole[250..].iter().all(|&b| b == 0));
     }
+
+    /// round 74: a person file with label pointers goes the in-memory way (all its cells after
+    /// the game stored it); without them every file goes as before; map settings with them
+    /// are refused as before.
+    #[test]
+    fn person_files_with_label_pointers_take_the_in_memory_way() {
+        use fates_rando::Kind;
+        assert_eq!(first_way(Kind::Person, true), Way::Late);
+        assert_eq!(first_way(Kind::Dispos, true), Way::Late);
+        assert_eq!(first_way(Kind::MapConfig, true), Way::Refused);
+        for k in [Kind::Person, Kind::Dispos, Kind::MapConfig] {
+            assert_eq!(first_way(k, false), Way::InRead, "off: no pointer cell, the read path as before");
+        }
+        // a too-big result falls back to memory only where an in-memory path exists
+        assert!(late_ok(Kind::Person) && late_ok(Kind::Dispos) && !late_ok(Kind::MapConfig));
+    }
 }
