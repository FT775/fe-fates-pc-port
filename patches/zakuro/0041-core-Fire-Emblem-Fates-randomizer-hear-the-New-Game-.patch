+/// round 81b D2: what one svc at the trap gives, from one run of the checks.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct SvcOutcome {
+    /// the rows' pending store: only while a row is set and the checks held (as round 81)
+    pub pending: Option<Pending>,
+    /// the randomizer heard the New Game step: only while its hooks are on and the checks held
+    pub seen: bool,
+    /// the checks refused (nothing written; said by the rows' log line and / or the randomizer)
+    pub refused: Option<Refusal>,
+}
+
+/// round 81b D2: the svc's checks, run once for both listeners. Neither listening (Seal of
+/// Flames at the defaults, or a word a state brought back): no check, no guest memory read.
+pub fn svc_outcome(g: &mut dyn Guest, rows: bool, hooks: bool, thumb: bool, at: u32, lr: u32, r0: u32) -> SvcOutcome {
+    if !rows && !hooks {
+        return SvcOutcome::default();
+    }
+    match svc_checks(g, thumb, at, lr, r0) {
+        Ok(block) => SvcOutcome { pending: rows.then_some(Pending { block }), seen: hooks, refused: None },
+        Err(why) => SvcOutcome { pending: None, seen: false, refused: Some(why) },
+    }
+}
+
+/// round 81b D4: which "the trap cannot be laid" lines to say now, each once per program run.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct CannotLay {
+    /// round 81's log line for the New Game rows
+    pub rows: bool,
+    /// the randomizer's notice: Classic New Games cannot be heard
+    pub rando: bool,
+}
