+    #[test]
+    fn the_trap_is_wanted_for_the_rows_or_the_randomizer() {
+        assert!(!trap_wanted(false, false), "hooks off and no row: no trap (round 81)");
+        assert!(trap_wanted(true, false), "a row set: the trap (round 81)");
+        assert!(trap_wanted(false, true), "the randomizer's hooks on: the trap with no row set");
+        assert!(trap_wanted(true, true));
+        // the hooks follow the randomizer's own switch: Config::fates_rando off = hooks off
+        assert!(!trap_wanted(false, crate::fates_rando_session::hooks_on(Some(crate::fates_rando::TITLE), false)));
+        assert!(trap_wanted(false, crate::fates_rando_session::hooks_on(Some(crate::fates_rando::TITLE), true)));
+        // Seal of Flames (hooks on, F-047) at the defaults: no trap, as in round 81 (plan D1, P7)
+        let seal = crate::fates_rando_session::step_game(Some("seal"));
+        assert!(!trap_wanted(false, seal), "Seal with no row set: no trap");
+        assert!(trap_wanted(true, seal), "Seal with a row set: the rows' trap, as in round 81");
+        assert!(trap_wanted(false, crate::fates_rando_session::step_game(None)), "Fates: the trap");
+    }
+
+    #[test]
+    fn hooks_off_and_no_rows_lay_no_trap_and_touch_no_guest_memory() {
+        let mut w = Writer::default();
+        let mut m = title();
+        m.untouchable = true;
+        for f in 1..200 {
+            let j = w.jumped(f);
+            assert_eq!(w.word_step(&mut m, trap_wanted(false, false), j), WordStep::default());
+        }
+        // a svc there anyway (a state brought the word back): no check, no read, nothing heard
+        assert_eq!(svc_outcome(&mut m, false, false, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK),
+                   SvcOutcome::default());
+        m.untouchable = false;
+        assert_eq!(m.reads, 0);
+        assert!(m.writes.is_empty());
+        assert_eq!(m.word(START_FROM_BEGINNING), ORIGINAL_WORD);
+    }
+
+    #[test]
+    fn the_randomizer_alone_lays_the_trap_and_the_rows_store_stays_empty() {
+        let mut w = Writer::default();
+        let mut m = title();
+        assert!(!Helpers::default().any_new_game_row());
+        assert!(!w.jumped(1));
+        let s = w.word_step(&mut m, trap_wanted(false, true), false);
+        assert_eq!(s, WordStep { now: Some(ORIGINAL_WORD), write: Some(TRAP_WORD), stranger: false });
+        m.set_word(START_FROM_BEGINNING, TRAP_WORD);
+        // the Normal + Classic pick: word +0x4 stays at its reset value; the svc hears the step
+        let before = block_bytes(&m);
+        let heard = svc_outcome(&mut m, false, true, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK);
+        assert_eq!(heard, SvcOutcome { pending: None, seen: true, refused: None });
+        assert!(m.writes.is_empty(), "no guest byte written at the svc");
+        // nothing pending, so the frame's end stores nothing (no "New Game:" line, no byte)
+        assert_eq!(w.pending, None);
+        assert_eq!(block_bytes(&m), before);
+        assert!(Helpers::default().new_game_bytes().is_empty());
+        // the randomizer's hooks off again (and no row): the original word goes back
+        assert!(!w.jumped(2));
+        assert_eq!(w.word_step(&mut m, trap_wanted(false, false), false).write, Some(ORIGINAL_WORD));
+    }
+
+    #[test]
+    fn rows_and_randomizer_share_one_check() {
+        let mut m = title();
+        let ok = |rows, hooks| {
+            let mut m = title();
+            let o = svc_outcome(&mut m, rows, hooks, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK);
+            assert!(m.writes.is_empty());
+            o
+        };
+        assert_eq!(ok(true, false), SvcOutcome { pending: Some(Pending { block: BLOCK }), seen: false, refused: None },
+                   "rows only: exactly round 81's pending, nothing heard");
+        assert_eq!(ok(true, true), SvcOutcome { pending: Some(Pending { block: BLOCK }), seen: true, refused: None });
+        assert_eq!(ok(false, true), SvcOutcome { pending: None, seen: true, refused: None });
+        // a refusal: nothing pending and nothing heard, whoever listens
+        army(&mut m);
+        for (rows, hooks) in [(true, false), (false, true), (true, true)] {
+            let o = svc_outcome(&mut m, rows, hooks, false, START_FROM_BEGINNING, CALL_RETURN, BLOCK);
+            assert_eq!(o, SvcOutcome { pending: None, seen: false, refused: Some(Refusal::ArmyPresent) });
+        }
+        let o = svc_outcome(&mut title(), false, true, false, START_FROM_BEGINNING, CALL_RETURN + 4, BLOCK);
+        assert_eq!(o.refused, Some(Refusal::WrongCaller), "a load never reaches the step: the lr check");
+        assert!(!o.seen);
+        assert!(m.writes.is_empty());
+    }
+
+    #[test]
+    fn a_trap_that_cannot_be_laid_is_said_once_to_each_listener() {
+        // a stranger word with only the randomizer listening: the randomizer's line once, never
+        // the rows' line
+        let mut w = Writer::default();
+        let mut m = title();
+        m.set_word(START_FROM_BEGINNING, 0xE1A0_0000);
+        let s = w.word_step(&mut m, trap_wanted(false, true), false);
+        assert!(s.stranger);
+        assert_eq!(s.write, None);
+        assert_eq!(w.cannot_lay(false, true), CannotLay { rows: false, rando: true });
+        assert_eq!(w.cannot_lay(false, true), CannotLay::default(), "once");
+        // a row set later: round 81's line once too, the randomizer's not again
+        assert_eq!(w.cannot_lay(true, true), CannotLay { rows: true, rando: false });
+        assert_eq!(w.cannot_lay(true, true), CannotLay::default());
+        assert!(m.writes.is_empty());
+        // recompiled code that cannot check itself, both listening at once: each line once
+        let mut w = Writer::default();
+        assert_eq!(w.cannot_lay(true, true), CannotLay { rows: true, rando: true });
+        assert_eq!(w.cannot_lay(true, true), CannotLay::default());
+        // rows only (the randomizer's hooks off): exactly round 81's single line
+        let mut w = Writer::default();
+        assert_eq!(w.cannot_lay(true, false), CannotLay { rows: true, rando: false });
+        assert_eq!(w.cannot_lay(true, false), CannotLay::default());
+    }
