+/// the map's turn (`map::Situation` +0xC), or 0 when there is no map situation or the
+/// number is not a turn (1..999).
+pub fn turn(g: &mut dyn Guest) -> u32 {
+    let Some(sit) = g.r32(MAP_SITUATION).filter(|&a| a != 0) else { return 0 };
+    if !g.readable(sit.wrapping_add(0xC), 2) {
+        return 0;
+    }
+    let mut b = [0u8; 2];
+    g.read(sit.wrapping_add(0xC), &mut b);
+    let t = u16::from_le_bytes(b) as u32;
+    if (1..=999).contains(&t) { t } else { 0 }
+}
