+        assert_eq!(n.sweep(&mut m), 1);
+        assert!(!pids(&mut m, 0).contains(&"PID_2".to_string()));
+        assert_eq!(n.sweep(&mut m), 0);
+        // not armed: a fallen unit the game takes back into the army (CreateSortie from force 4)
+        // is moved at the next system call; the frame before learnt its unit
+        n.armed = 0;
+        n.frame(&mut m);
+        assert!(n.dead_units.contains(&unit(2)));
+        let f4 = POOL + 48;
+        let prev = m.r32(unit(2) + 0x10).unwrap();
+        // unlink unit 2 (last of force 4) and join it to force 3 after unit 3
+        m.write(f4 + 4, &prev.to_le_bytes());
+        m.write(prev + 0x14, &0u32.to_le_bytes());
+        m.write(unit(2) + 0x10, &unit(3).to_le_bytes());
+        m.write(unit(3) + 0x14, &unit(2).to_le_bytes());
+        m.write(POOL + 36 + 4, &unit(2).to_le_bytes());
+        m.write(unit(2) + 0xA4, &(POOL + 36).to_le_bytes());
+        assert!(pids(&mut m, 3).contains(&"PID_2".to_string()));
+        assert_eq!(n.sweep(&mut m), 1);
+        assert!(!pids(&mut m, 3).contains(&"PID_2".to_string()));
+        assert!(pids(&mut m, 4).contains(&"PID_2".to_string()));
+        let _ = std::fs::remove_dir_all(&data);
+    }
