+                g.r32(u.wrapping_add(0xA4)).filter(|&f| f != 0).and_then(|f| r8(g, f.wrapping_add(8)))
+                    .is_some_and(|i| i == FORCE_PLAYER || i == FORCE_RESERVE)
+            }).collect();
