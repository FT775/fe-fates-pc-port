+        assert_eq!((n.dead[0].pid.as_str(), n.dead[0].turn, n.dead[0].name.as_str()), ("PID_1", 3, "Felicia"));
+        let text = std::fs::read_to_string(&n.path).unwrap();
+        assert!(text.contains("\"name\": \"Felicia\"") && text.contains("\"turn\": 3"), "{text}");
+        assert!(n.text().contains("Felicia: A007, turn 3"));
+        // a turn that is not one reads 0
+        m.write(SIT + 0xC, &0u16.to_le_bytes());
+        assert_eq!(turn(&mut m), 0);
+        // the sweep: PID_2 in the graveyard; armed -> moved at once, not armed -> nothing
+        n.dead.push(Dead { pid: "PID_2".into(), chapter: "X".into(), turn: 1, name: String::new(), cause: "battle".into(),
+                           at: String::new() });
+        n.armed = 0;
+        assert_eq!(n.sweep(&mut m), 0);
+        n.rearm();
