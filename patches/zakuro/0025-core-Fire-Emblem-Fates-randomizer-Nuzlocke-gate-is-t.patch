+    pub fn sweep(&mut self, g: &mut dyn Guest) -> u32 {
+        if self.dead.is_empty() || (self.armed == 0 && self.dead_units.is_empty()) {
+            return 0;
+        }
+        let Some(pool) = g.r32(UNIT_POOL + 4).filter(|&p| p != 0) else { return 0 };
