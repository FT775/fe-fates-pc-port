+    // ----------------------------------------------------------------- the window, a fake game
+
+    #[derive(Default)]
+    struct Fake {
+        blocks: BTreeMap<u32, Vec<u8>>,
+        writes: u32,
+    }
+
+    impl Fake {
+        fn put(&mut self, at: u32, len: usize) {
+            self.blocks.insert(at, vec![0; len]);
+        }
+        fn w32(&mut self, at: u32, v: u32) {
+            let (b, o) = self.find(at, 4).unwrap();
+            self.blocks.get_mut(&b).unwrap()[o..o + 4].copy_from_slice(&v.to_le_bytes());
+        }
+        fn find(&self, addr: u32, len: u32) -> Option<(u32, usize)> {
+            let (&b, v) = self.blocks.range(..=addr).next_back()?;
+            let o = (addr - b) as usize;
+            (o + len as usize <= v.len()).then_some((b, o))
+        }
+    }
+
+    impl Guest for Fake {
+        fn readable(&self, addr: u32, len: u32) -> bool {
+            self.find(addr, len).is_some()
+        }
+        fn read(&mut self, addr: u32, out: &mut [u8]) {
+            let (b, o) = self.find(addr, out.len() as u32).unwrap();
+            out.copy_from_slice(&self.blocks[&b][o..o + out.len()]);
+        }
+        fn write(&mut self, _addr: u32, _data: &[u8]) {
+            self.writes += 1;
+        }
+    }
+
+    const ROOTS: u32 = PROC_ROOTS;
+    const MAIN: u32 = 0x3000_0000;
+    const OTHER: u32 = 0x3000_1000;
+    const SEQ: u32 = 0x3100_0000;
+    const INFO: u32 = 0x3200_0000;
+    const CONFIG: u32 = 0x3300_0000;
+
+    /// root 0 -> MAIN; MAIN's child OTHER; OTHER's sibling the target select, its window slid
+    /// in, side 0 shows 70 with two strikes, side 1 shows 98 with one.
+    fn game() -> Fake {
+        let mut m = Fake::default();
+        m.put(ROOTS, 12);
+        m.put(GAME_CONFIG, 4);
+        m.put(MAIN, 0x40);
+        m.put(OTHER, 0x40);
+        m.put(SEQ, 0x1520);
+        m.put(INFO, 0x400);
+        m.put(CONFIG, 0x20);
+        m.w32(ROOTS, MAIN);
+        m.w32(MAIN, 0x0064_0000);
+        m.w32(MAIN + PROC_CHILD, OTHER);
+        m.w32(OTHER, 0x0064_0010);
+        m.w32(OTHER + PROC_SIBLING, SEQ);
+        m.w32(SEQ, TARGET_SELECT_VTABLE);
+        m.w32(SEQ + WINDOW + WINDOW_INFO, INFO);
+        m.w32(SEQ + WINDOW + WINDOW_SLIDE, 1.0f32.to_bits());
+        m.w32(GAME_CONFIG, CONFIG);
+        m.w32(INFO + SIDE_HIT, 70);
+        m.w32(INFO + SIDE_ATTACKS, 2);
+        m.w32(INFO + SIDE_SIZE + SIDE_HIT, 98);
+        m.w32(INFO + SIDE_SIZE + SIDE_ATTACKS, 1);
+        m
+    }
+
+    #[test]
+    fn the_walk_finds_the_window_and_reads_both_sides() {
+        let mut g = game();
+        assert_eq!(target_select(&mut g), Some(SEQ));
+        assert_eq!(forecast(&mut g), Some(Forecast { page: Page::Detail, hit: [Some(70), Some(98)] }));
+        g.w32(CONFIG + 4, 0x80);
+        assert_eq!(forecast(&mut g).map(|f| f.page), Some(Page::Simple));
+        assert_eq!(g.writes, 0, "nothing is written to the game");
+    }
+
+    #[test]
+    fn no_window_no_forecast() {
+        // a dying target select is not the window
+        let mut g = game();
+        g.blocks.get_mut(&SEQ).unwrap()[PROC_FLAGS as usize] = 1;
+        assert_eq!(forecast(&mut g), None);
+        // no BattleInfo yet
+        let mut g = game();
+        g.w32(SEQ + WINDOW + WINDOW_INFO, 0);
+        assert_eq!(forecast(&mut g), None);
+        // still sliding in
+        let mut g = game();
+        g.w32(SEQ + WINDOW + WINDOW_SLIDE, 0.8f32.to_bits());
+        assert_eq!(forecast(&mut g), None);
+        // nearly in: the offset is already 0 (trunc of -0.02)
+        g.w32(SEQ + WINDOW + WINDOW_SLIDE, 0.99f32.to_bits());
+        assert!(forecast(&mut g).is_some());
+        // no proc tree at all
+        let mut g = Fake::default();
+        assert_eq!(forecast(&mut g), None);
+        // a list that loops ends
+        let mut g = game();
+        g.w32(OTHER + PROC_SIBLING, MAIN);
+        assert_eq!(target_select(&mut g), None);
+    }
+
+    #[test]
+    fn a_side_with_no_attack_has_no_number() {
+        let mut g = game();
+        g.w32(INFO + SIDE_SIZE + SIDE_ATTACKS, 0);
+        assert_eq!(forecast(&mut g).unwrap().hit, [Some(70), None]);
+    }
