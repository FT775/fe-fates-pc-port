+    // ----------------------------------------------------------------- the painter
+
+    /// a detail page at `scale`: cream rows, their dark lower edges, dark digits in each side's
+    /// number box, and an orange ground everywhere else.
+    fn detail_picture(scale: u32) -> Vec<u8> {
+        let (w, h) = (400 * scale, 240 * scale);
+        let mut px = vec![0u8; (w * h * 4) as usize];
+        let mut put = |x: u32, y: u32, c: [u8; 3]| {
+            for dy in 0..scale {
+                for dx in 0..scale {
+                    let i = (((y * scale + dy) * w + x * scale + dx) * 4) as usize;
+                    px[i..i + 3].copy_from_slice(&c);
+                    px[i + 3] = 255;
+                }
+            }
+        };
+        for y in 0..240 {
+            for x in 0..400 {
+                put(x, y, [196, 121, 39]);
+            }
+        }
+        for (l, r) in [(50, 130), (268, 352)] {
+            for y in 195..210 {
+                for x in l..=r {
+                    put(x, y, [241, 216, 158]);
+                }
+            }
+            for x in l..=r {
+                put(x, 210, [60, 30, 10]);
+            }
+        }
+        for (l, r) in [(82, 103), (305, 327)] {
+            for y in 197..=207 {
+                for x in (l..=r).step_by(2) {
+                    put(x, y, [70, 20, 20]);
+                }
+            }
+        }
+        px
+    }
+
+    fn get(px: &[u8], scale: u32, x: u32, y: u32) -> [u8; 4] {
+        let i = (((y * scale + scale / 2) * 400 * scale + x * scale + scale / 2) * 4) as usize;
+        [px[i], px[i + 1], px[i + 2], px[i + 3]]
+    }
+
+    fn inside((l, t, r, b): (u32, u32, u32, u32), x: u32, y: u32) -> bool {
+        x >= l && x <= r && y >= t && y <= b
+    }
+
+    #[test]
+    fn paints_the_detail_page_beside_side_1_and_nothing_else() {
+        for scale in [1, 2, 3] {
+            let before = detail_picture(scale);
+            let mut px = before.clone();
+            let f = Forecast { page: Page::Detail, hit: [Some(70), Some(98)] };
+            assert!(paint(&f, &mut px, 400 * scale, 240 * scale));
+            // side 0 has no place on the detail page (round 80 repair): only side 1's box changes
+            let boxes = [label_box(place(Page::Detail, 1).unwrap(), "real 99")];
+            for y in 0..240 {
+                for x in 0..400 {
+                    let (a, b) = (get(&before, scale, x, y), get(&px, scale, x, y));
+                    if boxes.iter().any(|&bx| inside(bx, x, y)) {
+                        assert!(b[..3] == BROWN || b[..3] == CREAM, "the label at {x},{y}");
+                    } else {
+                        assert_eq!(a, b, "a game pixel at {x},{y} (scale {scale})");
+                    }
+                }
+            }
+            // some cream text in each box, and never in the game's number or "%"
+            for bx in boxes.iter() {
+                let n = place(Page::Detail, 1).unwrap().number;
+                assert!(bx.0 > n.2 || bx.2 < n.0, "the box is beside the number");
+                let cream = (bx.0..=bx.2).flat_map(|x| (bx.1..=bx.3).map(move |y| (x, y))).filter(|&(x, y)| get(&px, scale, x, y)[..3] == CREAM).count();
+                assert!(cream > 40, "the text is painted ({cream})");
+            }
+        }
+        // side 1's label starts after the big HP number (x 254); side 0 has no place
+        assert!(label_box(place(Page::Detail, 1).unwrap(), "real 99").0 > 254);
+        assert!(place(Page::Detail, 0).is_none());
+    }
