+        assert_eq!(real(1), 1);
+        assert_eq!(real(50), 50);
+        assert_eq!(real(70), 79);
+        assert_eq!(real(98), 99);
+        assert_eq!(real(99), 99);
+        assert_eq!(real(100), 100);
+        for s in 0..100 {
+            assert!(real(s) <= 99, "only a sure hit says 100 (shown {s})");
+        }
+        assert_eq!(shown_real(1), 1, "above 0 shows at least 1");
+        assert_eq!(shown_real(49), 1);
+        assert_eq!(shown_real(9999), 99);
+        assert_eq!(shown_real(10000), 100);
