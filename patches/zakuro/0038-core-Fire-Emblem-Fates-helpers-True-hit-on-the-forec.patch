+    #[test]
+    fn the_table_is_the_rule() {
+        for s in 0..=100u32 {
+            let want = if s <= 50 {
+                s * 100
+            } else {
+                let angle = ((s as f64 - 50.0) * 3.6).to_radians();
+                (s as f64 * 100.0 + (40.0 / 3.0) * s as f64 * angle.sin()).trunc() as u32
+            };
+            assert_eq!(threshold(s), Some(want), "shown {s}");
+        }
+        assert_eq!(threshold(70), Some(7887));
+        assert_eq!(threshold(100), Some(10000));
+        assert_eq!(threshold(101), None);
+        assert!(THRESHOLDS.windows(2).all(|w| w[0] < w[1]), "the real chance grows with the shown one");
+        assert!((0..=100).all(|s| THRESHOLDS[s] as usize >= s * 100), "never below the shown chance");
+    }
+
+    #[test]
