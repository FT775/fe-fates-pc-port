+    #[test]
+    fn the_simple_page_labels_stay_outside_the_numbers() {
+        // round 80 repair: above each side's "Hit" box, centred on it, never over a number
+        for (side, (box_l, box_r)) in [(137u32, 183u32), (217, 261)].into_iter().enumerate() {
+            let p = place(Page::Simple, side).unwrap();
+            let b = label_box(p, "real 99");
+            assert!(b.3 < SIMPLE_BOX_TOP, "side {side}: the label ends above the box ({b:?})");
+            assert!(b.3 < p.number.1, "side {side}: above the game's number");
+            assert!(b.0 >= box_l && b.2 <= box_r, "side {side}: within the box's width ({b:?})");
+            let mid = (b.0 + b.2) / 2;
+            assert!(mid.abs_diff((box_l + box_r) / 2) <= 1, "side {side}: centred ({mid})");
+        }
+        // the two labels never meet
+        let (l, r) = (label_box(place(Page::Simple, 0).unwrap(), "real 99"), label_box(place(Page::Simple, 1).unwrap(), "real 99"));
+        assert!(l.2 < r.0);
+        let mut px = vec![30u8; 800 * 480 * 4];
+        assert!(paint(&Forecast { page: Page::Simple, hit: [Some(70), Some(98)] }, &mut px, 800, 480));
+    }
