+        let unit_window = [corner(4.0, 256.0), corner(4.0, 400.0), corner(44.0, 256.0), corner(44.0, 400.0)];
+        let terrain_window = [corner(4.0, 0.0), corner(4.0, 144.0), corner(44.0, 0.0), corner(44.0, 144.0)];
+        let place = Place { left: [0.55, 0.98], top: [0.0, 0.06], width: [0.3, 0.42], height: [0.12, 0.21] };
+        let marker = Marker { id: 7, format: 0xD, width: 32, height: 32, place, bottom: false };
+        assert_eq!(marker_drawn(&registers, &[marker], Some(&unit_window), top_screen).map(|(id, _)| id), Some(7));
+        assert_eq!(marker_drawn(&registers, &[marker], Some(&terrain_window), top_screen), None);
+        assert_eq!(marker_drawn(&registers, &[marker], None, top_screen), None);
+        assert_eq!(marker_drawn(&registers, &[marker], Some(&unit_window), bottom_screen), None);
+        let wider = Marker { width: 64, ..marker };
+        assert_eq!(marker_drawn(&registers, &[wider], Some(&unit_window), top_screen), None);
+        registers[REG_TEXTURE_CONFIG] = 0;
