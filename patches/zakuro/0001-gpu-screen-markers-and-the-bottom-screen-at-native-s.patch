+    /// a screen's newest picture at the console's own size, upright RGBA,
+    /// from the capture its buffer is written back to memory from. asking
+    /// once watches the buffer: each later picture is read out as its batch
+    /// finishes, so the first call may find none yet.
+    pub(crate) fn native_picture(&mut self, screen: ScreenRef) -> Option<Vec<u8>> {
+        let (row_pixels, rows) = screen.size;
+        if screen.rows != (0, rows) || screen.columns != row_pixels {
+            return None;
+        }
+        let index = self.surfaces.iter().position(|s| {
+            s.addr == screen.addr && s.width == row_pixels && s.height == rows && s.kind == Kind::Color(screen.format) && !s.tiled
+        })?;
+        let capture = self.surfaces[index].capture.as_mut()?;
+        capture.watched = true;
+        let (_, image) = capture.pictures.back()?;
+        let (width, height) = (rows as usize, row_pixels as usize);
+        if image.len() < width * height * 4 {
+            return None;
+        }
+        let mut out = vec![0u8; width * height * 4];
+        for x in 0..width {
+            for y in 0..height {
+                let at = ((width - 1 - x) * height + (height - 1 - y)) * 4;
+                out[(y * width + x) * 4..][..4].copy_from_slice(&image[at..at + 4]);
+            }
+        }
+        Some(out)
+    }
