+    fn placed_at((x, y): (f32, f32), (width, height): (f32, f32), w: f32, uv: [f32; 2]) -> Vertex {
+        let clip = [(x / width * 2.0 - 1.0) * w, (y / height * 2.0 - 1.0) * w, 0.0, w];
