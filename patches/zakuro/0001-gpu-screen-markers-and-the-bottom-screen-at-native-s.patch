+/// a draw's vertices through the shaders on the CPU, none for arrays only
+/// the GPU decodes.
+fn cpu_shaded_vertices(registers: &[u32], vertices: Vertices) -> Option<Vec<Vertex>> {
+    match vertices {
+        Vertices::Unshaded { vertex_shader, geometry_shader, inputs, order } if registers[REG_GEOSTAGE_CONFIG] & 0x3 != 2 => {
+            Some(process_vertices(registers, vertex_shader, geometry_shader, inputs, order).0)
+        }
+        Vertices::Shaded(shaded) => Some(shaded.to_vec()),
+        Vertices::Prepared(prepared) => Some(prepared.shaded.clone()),
+        _ => None,
+    }
+}
