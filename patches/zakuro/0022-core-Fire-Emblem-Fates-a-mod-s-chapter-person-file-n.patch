+/// the archive name set to the file's stem (true = changed).
+fn person_name(path: &str, stem: &str, bin: &mut crate::fates_rando_file::IsBin) -> bool {
+    let Some(ptr) = bin.word(0) else { return false };
+    let Some(name) = bin.string_at(ptr).map(|n| n.to_vec()) else { return false };
+    if name == stem.as_bytes() {
+        return false;
+    }
+    if name.len() != stem.len() || bin.relocs.iter().filter(|&&r| bin.word(r) == Some(ptr)).count() != 1 {
+        log::warn!("mods: {path}: its person archive is named {}; not changed (a battle save of this chapter will not reload its own people)", String::from_utf8_lossy(&name));
+        return false;
+    }
+    let at = (ptr - bin.se()) as usize;
+    bin.strtab[at..at + stem.len()].copy_from_slice(stem.as_bytes());
+    true
+}
+
+/// a Person block's records: the count (u16 at +4), 0x98 bytes each from +0x10, the number
+/// (u16) at record +0x24. Numbered in file order from the first record's number when the
+/// numbers are that range in another order (true = changed).
+fn person_numbers(path: &str, bin: &mut crate::fates_rando_file::IsBin) -> bool {
+    const REC: usize = 0x98;
+    let n = match bin.data.get(4..6) {
+        Some(c) => u16::from_le_bytes([c[0], c[1]]) as usize,
+        None => return false,
+    };
+    if n == 0 || bin.data.len() < 0x10 + n * REC {
+        return false;
+    }
+    let at = |i: usize| 0x10 + i * REC + 0x24;
+    let nums: Vec<u32> = (0..n).map(|i| u16::from_le_bytes([bin.data[at(i)], bin.data[at(i) + 1]]) as u32).collect();
+    let first = nums[0];
+    if nums.iter().enumerate().all(|(i, &v)| v == first + i as u32) {
+        return false;
+    }
+    let mut sorted = nums.clone();
+    sorted.sort_unstable();
+    if first + n as u32 > 0x1_0000 || sorted.iter().enumerate().any(|(i, &v)| v != first + i as u32) {
+        log::warn!("mods: {path}: its people are numbered {nums:x?}, not a reordering of {first:#x}..; not changed (a battle save of this chapter will not reload its own people)");
+        return false;
+    }
+    for i in 0..n {
+        let v = (first + i as u32) as u16;
+        bin.data[at(i)..at(i) + 2].copy_from_slice(&v.to_le_bytes());
+    }
+    log::info!("mods: {path}: its people served numbered in file order from {first:#x} (they were {nums:x?}; a battle save reloads each unit's own person)");
+    true
+}
