+
+    /// a Person block with `nums.len()` records of 0x98 bytes, numbered `nums`; word 0 points
+    /// at the archive name, each record's +8 at a PID string.
+    fn people(name: &str, nums: &[u16]) -> Vec<u8> {
+        let mut strtab = name.as_bytes().to_vec();
+        strtab.push(0);
+        let mut data = vec![0u8; 0x10 + nums.len() * 0x98];
+        data[4..6].copy_from_slice(&(nums.len() as u16).to_le_bytes());
+        let mut relocs = vec![0u32];
+        let mut pids = Vec::new();
+        for (i, _) in nums.iter().enumerate() {
+            pids.push(strtab.len() as u32);
+            strtab.extend_from_slice(format!("PID_{i}\0").as_bytes());
+            relocs.push((0x10 + i * 0x98 + 8) as u32);
+        }
+        let mut bin = IsBin { pad: [0; 16], data, relocs, labels: vec![], strtab };
+        let se = bin.se();
+        bin.data[0..4].copy_from_slice(&se.to_le_bytes());
+        for (i, &v) in nums.iter().enumerate() {
+            let r = 0x10 + i * 0x98;
+            bin.data[r + 8..r + 12].copy_from_slice(&(se + pids[i]).to_le_bytes());
+            bin.data[r + 0x24..r + 0x26].copy_from_slice(&v.to_le_bytes());
+            bin.data[r + 0x30] = 0x40 + i as u8; // something else in the record, kept
+        }
+        let raw = bin.build();
+        // stored like a mod's file: compressed less tightly than ours (16 bytes of room)
+        let mut z = lz11_compress(&raw, 0x13, raw.len() as u32);
+        z.extend_from_slice(&[0; 16]);
+        z
+    }
+
+    fn numbers(z: &[u8]) -> Vec<u16> {
+        let bin = IsBin::parse(&lz_decompress(z).unwrap().data).unwrap();
+        let n = u16::from_le_bytes([bin.data[4], bin.data[5]]) as usize;
+        (0..n).map(|i| u16::from_le_bytes([bin.data[0x10 + i * 0x98 + 0x24], bin.data[0x10 + i * 0x98 + 0x25]])).collect()
+    }
+
+    #[test]
+    fn people_out_of_file_order_are_numbered_in_file_order() {
+        // R021's shape: a record numbered first+9 put in at position 7
+        let nums = [0x7a00, 0x7a01, 0x7a02, 0x7a03, 0x7a04, 0x7a05, 0x7a06, 0x7a09, 0x7a07, 0x7a08];
+        let z = people("C021", &nums);
+        let out = fates_person_fix("GameData/Person/C/R021.bin.lz", &z).expect("fixed");
+        assert_eq!(out.len(), z.len(), "the mod's stored size");
+        assert_eq!(numbers(&out), (0x7a00..0x7a0a).collect::<Vec<u16>>());
+        // only the name and the numbers differ
+        let (a, b) = (lz_decompress(&z).unwrap().data, lz_decompress(&out).unwrap().data);
+        assert_eq!(a.len(), b.len());
+        let diff: Vec<usize> = (0..a.len()).filter(|&i| a[i] != b[i]).collect();
+        let name_at = IsBin::parse(&a).unwrap().se() as usize + 0x20;
+        assert!(diff.iter().all(|&i| (name_at..name_at + 4).contains(&i) || (i >= 0x30 && ((i - 0x30) % 0x98 == 0x24 || (i - 0x30) % 0x98 == 0x25))), "{diff:x?}");
+        // Y004's shape: the first record is not 0x7A00; it keeps its number
+        let y = people("X015", &[0x7a0b, 0x7a0c, 0x7a0d, 0x7a16, 0x7a0e, 0x7a0f, 0x7a10, 0x7a11, 0x7a12, 0x7a13, 0x7a14, 0x7a15]);
+        let out = fates_person_fix("GameData/Person/C/Y004.bin.lz", &y).expect("fixed");
+        assert_eq!(numbers(&out), (0x7a0b..0x7a17).collect::<Vec<u16>>());
+        // already in order and already named: nothing
+        assert_eq!(fates_person_fix("GameData/Person/C/R002.bin.lz", &people("R002", &[0x7a05, 0x7a06, 0x7a07])), None);
+        // in order but misnamed: only the name
+        let out = fates_person_fix("GameData/Person/C/R002.bin.lz", &people("X020", &[0x7a00, 0x7a01])).expect("renamed");
+        assert_eq!(numbers(&out), vec![0x7a00, 0x7a01]);
+    }
+
+    #[test]
+    fn numbers_that_are_not_a_reordering_are_left_alone() {
+        // a gap (a new number) or a repeat: not changed, the name is still fixed
+        let out = fates_person_fix("GameData/Person/C/R021.bin.lz", &people("C021", &[0x7a00, 0x7a02, 0x7a01, 0x7a05])).expect("renamed");
+        assert_eq!(numbers(&out), vec![0x7a00, 0x7a02, 0x7a01, 0x7a05]);
+        assert_eq!(fates_person_fix("GameData/Person/C/R021.bin.lz", &people("R021", &[0x7a00, 0x7a01, 0x7a01])), None);
+        // the first record is not the lowest: the range would start elsewhere, not changed
+        assert_eq!(fates_person_fix("GameData/Person/C/R021.bin.lz", &people("R021", &[0x7a01, 0x7a00, 0x7a02])), None);
     }
