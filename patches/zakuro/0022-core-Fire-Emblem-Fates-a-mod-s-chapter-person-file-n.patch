-        log::warn!("mods: {path}: renamed archive compresses to {} bytes, more than the mod's {}; not changed", out.len(), bytes.len());
+        log::warn!("mods: {path}: fixed archive compresses to {} bytes, more than the mod's {}; not changed", out.len(), bytes.len());
         return None;
     }
     if lz.format == 0x13 {
@@ -220,6 +225,54 @@ pub fn fates_person_name(path: &str, bytes: &[u8]) -> Option<Vec<u8>> {
     Some(out)
