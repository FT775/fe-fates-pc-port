 const FEMALE_GUARD: u32 = 0x006D_3B2C;
 const FEMALE_MASK: u32 = 0x006D_3B70;
+/// the Preparations sequence while it is alive (`sortie::Sequence::GetInstance`)
+pub const SORTIE_SEQUENCE: u32 = 0x006D_9030;
+/// the player's map cursor sequence while it is alive (`map::SequenceHuman::GetInstance`)
+pub const MAP_HUMAN: u32 = 0x006D_7BA4;
 
