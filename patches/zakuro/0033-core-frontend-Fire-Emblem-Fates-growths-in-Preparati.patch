+pub fn growth_help(keys: &Keys, pad: &PadButtons) -> String {
+    format!(
+        "Growths on the unit panel: Y in Preparations (key {}, pad {}), Select or Tab on the battle map.",
+        key_name(keys.y),
+        button_name(pad.y)
+    )
+}
