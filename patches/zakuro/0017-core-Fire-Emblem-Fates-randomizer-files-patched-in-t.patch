+    /// decodes an LZ13 file the way the game does: stored bytes at the end of a buffer of
+    /// the outer size, output written from its start over the same buffer.
+    fn inplace_decode(stored: &[u8]) -> Vec<u8> {
+        let outer = u32::from_le_bytes([stored[1], stored[2], stored[3], 0]) as usize;
+        let size = u32::from_le_bytes([stored[5], stored[6], stored[7], 0]) as usize;
+        let mut buf = vec![0u8; outer.max(stored.len())];
+        let p = buf.len() - stored.len();
+        buf[p..].copy_from_slice(stored);
+        let (mut r, mut w) = (p + 8, 0usize);
+        while w < size {
+            let flags = buf[r];
+            r += 1;
+            for bit in (0..8).rev() {
+                if w >= size {
+                    break;
+                }
+                if flags & (1 << bit) == 0 {
+                    buf[w] = buf[r];
+                    r += 1;
+                    w += 1;
+                    continue;
+                }
+                let ind = buf[r] >> 4;
+                let (len, n) = match ind {
+                    0 => (((buf[r] as usize & 15) << 4 | (buf[r + 1] as usize >> 4)) + 0x11, 3),
+                    1 => (((buf[r] as usize & 15) << 12 | (buf[r + 1] as usize) << 4 | (buf[r + 2] as usize >> 4)) + 0x111, 4),
+                    _ => (ind as usize + 1, 2),
+                };
+                let d = ((buf[r + n - 2] as usize & 15) << 8 | buf[r + n - 1] as usize) + 1;
+                r += n;
+                for _ in 0..len {
+                    buf[w] = buf[w - d];
+                    w += 1;
+                }
+            }
+        }
+        buf.truncate(size);
+        buf
+    }
+
+    /// round 59: a patched LZ13 file (shorter than the original, zero padded) decodes right
+    /// in place with the outer size patch_stored writes (with the original outer it would
+    /// not: the writes run over the unread end, which holds the string pool)
+    #[test]
+    fn patched_lz13_decodes_in_place() {
+        let mut b = sample();
+        b.strtab.extend_from_slice(b"STRM_BOSS_C1\0");
+        b.data = (0..0x400u32).map(|i| (i % 7) as u8).collect();
+        b.relocs = vec![];
+        b.labels = vec![(0, 0)];
+        let se = b.se();
+        let raw = b.build();
+        // the "game's" file: our compressor, then padding the size of a less tight stream
+        let z = lz11_compress(&raw, 0x13, raw.len() as u32);
+        let mut stored = z.clone();
+        stored.extend_from_slice(&[0u8; 200]);
+        let f = FilePatch {
+            kind: Kind::Person,
+            rel: "GameData/Person/C/S002.bin.lz".into(),
+            values: vec![Value { off: se + 19, old: b"STRM_BOSS_C1\0".to_vec(), new: b"STRM_BOSS_A2\0".to_vec() }],
+            ptrs: vec![],
+        };
+        let out = patch_stored(&stored, &f).unwrap();
+        let dec = inplace_decode(&out);
+        let nb = IsBin::parse(&dec).unwrap();
+        assert_eq!(nb.string_at(se + 19), Some(&b"STRM_BOSS_A2"[..]), "the pool at the end decodes right in place");
+        // the margin rule matches a plain decode everywhere
+        assert_eq!(dec, lz_decompress(&out).unwrap().data);
+    }
