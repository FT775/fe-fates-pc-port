+/// for an LZ13 stream (the 4-byte LZ13 header, then LZ11) read from its first byte: the
+/// largest (bytes written so far - index of the next byte to read) over every byte the
+/// decoder reads. Placed at `outer - stored` in a buffer of `outer` bytes, the stream is
+/// decoded in place without a write over an unread byte when `outer >= stored + margin`.
+pub fn inplace_margin(z: &[u8]) -> i64 {
+    let mut worst = 0i64;
+    let at = |w: usize, j: usize, worst: &mut i64| *worst = (*worst).max(w as i64 - j as i64);
+    let mut j = 4; // after the LZ13 header
+    if z.len() < 8 {
+        return 0;
+    }
+    let mut size = u32::from_le_bytes([z[j + 1], z[j + 2], z[j + 3], 0]) as usize;
+    j += 4;
+    if size == 0 {
+        if z.len() < 12 {
+            return 0;
+        }
+        size = u32::from_le_bytes([z[j], z[j + 1], z[j + 2], z[j + 3]]) as usize;
+        j += 4;
+    }
+    let mut w = 0usize;
+    while w < size && j < z.len() {
+        at(w, j, &mut worst);
+        let flags = z[j];
+        j += 1;
+        for bit in (0..8).rev() {
+            if w >= size || j >= z.len() {
+                break;
+            }
+            at(w, j, &mut worst);
+            if flags & (1 << bit) == 0 {
+                j += 1;
+                w += 1;
+                continue;
+            }
+            let ind = z[j] >> 4;
+            let (len, n) = match ind {
+                0 => (((z[j] as usize & 15) << 4 | (z[j + 1] as usize >> 4)) + 0x11, 3),
+                1 => (((z[j] as usize & 15) << 12 | (z[j + 1] as usize) << 4 | (z[j + 2] as usize >> 4)) + 0x111, 4),
+                _ => (ind as usize + 1, 2),
+            };
+            // every byte of the token is read before the copy writes
+            at(w, j + n - 1, &mut worst);
+            j += n;
+            w += len;
+        }
+    }
+    // the last write ends at w; the next "read" position is the end of the stream
+    at(w, j, &mut worst);
+    worst
+}
