+/// round 81: one byte the New Game writer stores: at `offset` in `GameConfigData`, the value
+/// `value`, on a line of the game that holds `line_values` values.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct NewGameByte {
+    pub offset: u32,
+    pub value: u8,
+    pub line_values: u8,
+}
+
+/// round 81: reads one key on its own: a value this build does not know (a word it never wrote,
+/// a number, a table) gives that key's default and leaves every other key as read. Serde only,
+/// so it works under any format (settings.toml goes through toml).
+pub fn lenient<'de, D, T>(deserializer: D) -> Result<T, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de> + Default,
+{
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum Either<T> {
+        Known(T),
+        Other(serde::de::IgnoredAny),
+    }
+    Ok(match Either::<T>::deserialize(deserializer)? {
+        Either::Known(value) => value,
+        Either::Other(_) => T::default(),
+    })
+}
+
+fn is_default<T: Default + PartialEq>(value: &T) -> bool {
+    *value == T::default()
+}
+
