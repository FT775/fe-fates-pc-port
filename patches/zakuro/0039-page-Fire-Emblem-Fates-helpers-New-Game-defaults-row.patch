+        let two = Helpers { hp_bars: HpBars::Off, battle_animations: BattleAnimations::On, ..Helpers::default() };
+        assert_eq!(two.new_game_bytes(), [byte(0x8, 1, 5), byte(0x16, 0, 2)]);
