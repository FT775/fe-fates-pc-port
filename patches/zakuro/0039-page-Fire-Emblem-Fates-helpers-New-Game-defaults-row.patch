-/// the Helpers rows. `Default` (Normal, Off) is today's game and is never written to the file.
+/// the first choice of every New Game row.
+pub const GAMES_CHOICE: &str = "Game's choice";
+
+/// round 81: the "New Game defaults" rows' enums share this shape: Game's choice first and the
+/// default (nothing stored), then the game's own values in the game's order (byte 0, 1, ...).
+macro_rules! new_game_row {
+    ($(#[$doc:meta])* $name:ident { $($variant:ident = $key:literal, $word:literal, $byte:literal;)* }) => {
+        $(#[$doc])*
+        #[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
+        pub enum $name {
+            /// Game's choice: the game's own setting is left alone (the default).
+            #[default]
+            #[serde(rename = "game")]
+            Game,
+            $(#[serde(rename = $key)] $variant,)*
+        }
+
+        impl $name {
+            /// Game's choice first, then the game's values in the game's order.
+            pub const ALL: &'static [$name] = &[$name::Game, $($name::$variant),*];
+
+            /// the byte the game's Options block gets; None for Game's choice (nothing stored).
+            pub fn byte(self) -> Option<u8> {
+                match self {
+                    $name::Game => None,
+                    $($name::$variant => Some($byte),)*
+                }
+            }
+
+            /// the word the row shows.
+            pub fn name(self) -> &'static str {
+                match self {
+                    $name::Game => GAMES_CHOICE,
+                    $($name::$variant => $word,)*
+                }
+            }
+
+            /// the value written in settings.toml (and in the page robot's target names).
+            pub fn key(self) -> &'static str {
+                match self {
+                    $name::Game => "game",
+                    $($name::$variant => $key,)*
+                }
+            }
+        }
+    };
+}
