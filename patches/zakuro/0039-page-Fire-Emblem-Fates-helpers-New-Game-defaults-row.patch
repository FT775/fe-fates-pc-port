+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let log = dir.join("pagebot.jsonl");
+        let file = dir.join("settings.toml");
+        let mut settings = crate::settings::Settings::default();
+        std::fs::write(&file, toml::to_string_pretty(&settings).unwrap()).unwrap();
+        let mut bot = bot(json!([
+            {"esc": "paused"},
+            {"expect_settings": {"battle_animations": "game", "map_speed": "game", "enemy_skip": "game", "hp_bars": "game", "true_hit": false}, "mark": "before"},
+            {"click": "helpers:newgame:section"},
+            {"click": "helpers:opt:battle_animations=off"},
+            {"click": "helpers:opt:enemy_skip=all"},
+            {"expect_settings": {"battle_animations": "off", "enemy_skip": "all", "map_speed": "game"}, "mark": "set"},
+            {"click": "helpers:opt:battle_animations=game"},
