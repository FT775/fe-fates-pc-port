 impl Run {
     pub fn new(patch: Patch, id: impl Into<String>) -> Run {
-        Run { patch, id: id.into(), gamedata_at: None, dispos_done: HashSet::new(), notices: vec![] }
+        Run { patch, id: id.into(), gamedata_at: None, resident_at: vec![], dispos_done: HashSet::new(), notices: vec![] }
     }
 
     pub fn gamedata_applied(&self) -> bool {
@@ -447,24 +504,72 @@ impl Run {
         self.gamedata_at = Some(base);
     }
 
+    /// assume_applied, and the recolour's resident files found where they are now (a save
+    /// state holds them laid too), so going back to the original puts them back as well.
+    pub fn assume_applied_in(&mut self, g: &mut dyn Guest, base: u32) {
+        self.gamedata_at = Some(base);
+        self.resident_at = self.patch.files.iter().enumerate()
+            .filter(|(_, f)| is_resident(f.kind))
+            .filter_map(|(i, f)| resident_start(g, f.kind).map(|s| (i, s)))
+            .collect();
+    }
+
     /// lays the GameData cells (Start game with Randomizer on, or a randomized save loaded).
     pub fn apply_gamedata(&mut self, g: &mut dyn Guest) -> Result<usize, Vec<String>> {
         if self.gamedata_at.is_some() {
             return Ok(0);
         }
         let base = gamedata_start(g).ok_or_else(|| vec!["GameData is not loaded".to_string()])?;
+        // the recolour's resident files (model table, FaceData): every one found and its
+        // guard passed before anything is written, so the run is laid whole or not at all
+        let mut resident = Vec::new();
+        let mut bad = Vec::new();
+        for (i, f) in self.patch.files.iter().enumerate().filter(|(_, f)| is_resident(f.kind)) {
+            match resident_start(g, f.kind) {
+                Some(start) => resident.push((i, start)),
+                None => bad.push(format!("{}: not in memory (or not the file the patch was made for)", f.rel)),
+            }
+        }
+        if !bad.is_empty() {
+            return Err(bad);
+        }
         let n = match self.patch.gamedata() {
             Some(f) => apply_file(g, f, base, base, false)?,
             None => 0,
         };
+        let mut done: Vec<(usize, u32)> = Vec::new();
+        let mut cells = n;
+        for &(i, start) in &resident {
+            match apply_file(g, &self.patch.files[i], start, base, false) {
+                Ok(k) => {
+                    cells += k;
+                    done.push((i, start));
+                }
+                Err(e) => {
+                    for &(j, s) in done.iter().rev() {
+                        let _ = apply_file(g, &self.patch.files[j], s, base, true);
+                    }
+                    if let Some(f) = self.patch.gamedata() {
+                        let _ = apply_file(g, f, base, base, true);
+                    }
+                    return Err(e);
+                }
+            }
+        }
+        self.resident_at = done;
         self.gamedata_at = Some(base);
-        Ok(n)
+        Ok(cells)
     }
 
     /// puts GameData back as the original (title screen, a save of the original game loaded).
     pub fn revert_gamedata(&mut self, g: &mut dyn Guest) -> Result<usize, Vec<String>> {
         let Some(base) = self.gamedata_at else { return Ok(0) };
-        let n = match self.patch.gamedata() {
+        let mut n = 0;
+        for &(i, start) in self.resident_at.clone().iter().rev() {
+            n += apply_file(g, &self.patch.files[i], start, base, true)?;
+        }
+        self.resident_at.clear();
+        n += match self.patch.gamedata() {
             Some(f) => apply_file(g, f, base, base, true)?,
             None => 0,
         };
