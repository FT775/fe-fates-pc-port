+    /// whether the map cursor is on a unit (the unit window shows).
+    pub fn cursor_on_unit(&self) -> bool {
+        self.scenes.shown(scenes::ON_UNIT, self.frames)
+    }
+
+    /// whether a talk is on, its window over the top screen.
+    pub fn talking(&self) -> bool {
+        self.scenes.shown(scenes::TALKING, self.frames)
+    }
+
+    pub fn world_map(&self) -> bool {
+        self.scenes.shown(scenes::WORLD_MAP, self.frames)
+    }
+
+    /// whether the battle forecast shows, in full or brief.
+    pub fn forecast(&self) -> bool {
+        self.scenes.shown(scenes::FORECAST, self.frames)
+    }
+
+    pub fn brief_forecast(&self) -> bool {
+        self.scenes.shown(scenes::BRIEF_FORECAST, self.frames)
+    }
+
