+/// the European release.
+pub const FIRE_EMBLEM_AWAKENING: u64 = 0x0004_0000_0009_F100;
+/// the North American release.
+pub const FIRE_EMBLEM_AWAKENING_USA: u64 = 0x0004_0000_000A_0500;
+
+/// whether a title is Fire Emblem: Awakening, a release the extras know.
+pub fn is_awakening(program_id: u64) -> bool {
+    matches!(program_id, FIRE_EMBLEM_AWAKENING | FIRE_EMBLEM_AWAKENING_USA)
+}
