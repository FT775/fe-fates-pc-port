+    pub battle_banners: &'static Banners,
+    pub title_pieces: &'static [Piece],
+    pub world_map_pieces: &'static [Piece],
+}
+
+pub fn for_game(program_id: u64) -> Option<&'static GameUi> {
+    is_awakening(program_id).then_some(&AWAKENING)
+}
