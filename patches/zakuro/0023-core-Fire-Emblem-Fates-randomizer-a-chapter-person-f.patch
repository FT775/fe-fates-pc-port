+
+    #[test]
+    fn a_chapter_person_archive_is_found_in_the_person_list_by_name() {
+        // the list: GameData's node, then R021's (node = {data start, ArchiveFile*, next})
+        let mut m = Fake::default();
+        let (n0, n1) = (0x2100_0000u32, 0x2100_0100u32);
+        let (b0, b1) = (0x3100_0020u32, 0x3200_0020u32);
+        let mut node = vec![0u8; 12];
+        node[0..4].copy_from_slice(&b0.to_le_bytes());
+        node[8..12].copy_from_slice(&n1.to_le_bytes());
+        m.put(n0, &node);
+        let mut node = vec![0u8; 12];
+        node[0..4].copy_from_slice(&b1.to_le_bytes());
+        m.put(n1, &node);
+        for (b, name) in [(b0, &b"resident\0"[..]), (b1, &b"R021\0"[..])] {
+            let mut blk = vec![0u8; 0x40];
+            blk[0..4].copy_from_slice(&(b + 0x30).to_le_bytes());
+            blk[0x30..0x30 + name.len()].copy_from_slice(name);
+            m.put(b, &blk);
+        }
+        let mut head = vec![0u8; 4];
+        head.copy_from_slice(&n0.to_le_bytes());
+        m.put(PERSON_LIST, &head);
+        assert_eq!(person_now(&mut m, "R021"), Some(b1));
+        assert_eq!(person_now(&mut m, "r021"), Some(b1));
+        assert_eq!(person_now(&mut m, "R023"), None);
+    }
 }
