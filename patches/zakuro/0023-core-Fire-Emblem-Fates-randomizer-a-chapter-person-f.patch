+/// the Person archive list's first node (`Person::Initialize` 0044A04C stores it; GameData's
+/// own block): each node is {data start of the archive, ArchiveFile*, next node}, and
+/// `Person::Load` (0044A808) / `Person::LoadArchive` (0044A388) append a chapter's file at
+/// the end once it is read and relocated.
+pub const PERSON_LIST: u32 = 0x006D_3B28;
+
+/// round 60: the data start of the loaded Person archive named `name` (its first word points
+/// at the archive name, which patch 0018/0022 keep equal to the file stem), or None.
+pub fn person_now(g: &mut dyn Guest, name: &str) -> Option<u32> {
+    let mut node = g.r32(PERSON_LIST)?;
+    for _ in 0..64 {
+        if node == 0 {
+            return None;
+        }
+        let start = g.r32(node)?;
+        if start != 0 {
+            if let Some(ptr) = g.r32(start).filter(|&p| p != 0) {
+                if g.cstr(ptr, 32).is_some_and(|n| n.eq_ignore_ascii_case(name.as_bytes())) {
+                    return Some(start);
+                }
+            }
+        }
+        node = g.r32(node.wrapping_add(8))?;
+    }
+    None
+}
+
 /// where a resident file of the recolour (Asset, Face) starts in memory now (the data
 /// start its offsets count from); None = not loaded or not the file the patch names.
