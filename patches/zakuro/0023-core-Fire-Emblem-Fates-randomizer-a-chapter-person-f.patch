-                                           bad.len(), bad[0])),
+    for (name, i, before, left) in std::mem::take(&mut system.rando.waits) {
+        let Some(f) = system.rando.run.as_ref().and_then(|r| r.patch.files.get(i)).cloned() else { continue };
+        let what = if f.kind == fates_rando::Kind::Person { "chapter people" } else { "placements" };
+        let now = stored_at(&mut system.memory, f.kind, &name);
+        let base = match now {
+            Some(b) if Some(b) != before => b,
+            _ => {
+                if left == 0 {
