+/// the answer as the tool gets it: for Fire Emblem Fates exactly the page's; for another
+/// game (Seal of Flames) the same with `"game": "<game>"` first, so its runs get their own
+/// ids and their options.json names the game.
+pub fn answer_for(answer: &str, game: Option<&str>) -> String {
+    match (game, answer.trim_start().strip_prefix('{')) {
+        (Some(g), Some(rest)) if json_field(answer, "game").is_none() => {
+            let rest = rest.trim_start();
+            let sep = if rest.starts_with('}') { "" } else { ", " };
+            format!("{{\"game\": \"{g}\"{sep}{rest}")
+        }
+        _ => answer.to_string(),
+    }
+}
+
+/// where Seal of Flames' files are for the tool: Zakuro's mod folder of the title in the
+/// game's data folder (upper-case id unless only the lower-case one exists, as mods.rs).
+pub fn mod_romfs(data: &Path) -> PathBuf {
+    let mods = data.join("mods");
+    let upper = mods.join(format!("{TITLE:016X}"));
+    let lower = mods.join(format!("{TITLE:016x}"));
+    let dir = if !upper.exists() && lower.exists() { lower } else { upper };
+    dir.join("romfs")
+}
