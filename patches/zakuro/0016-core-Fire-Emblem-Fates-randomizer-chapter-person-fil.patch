+        let out = patch_stored(&stored, &f).unwrap();
+        assert_eq!(out.len(), stored.len());
+        let nb = IsBin::parse(&out).unwrap();
+        assert_eq!(nb.string_at(nb.word(0x4).unwrap()), Some(&b"STRM_MAP_B2"[..]));
+        assert_eq!(nb.word(0x4), b.word(0x4), "the pointer itself is unchanged");
+        assert_eq!(nb.string_at(se), Some(&b"SHEET"[..]), "the label name is untouched");
