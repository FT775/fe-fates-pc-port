+        let mut long = f.clone();
+        long.values[0].new = b"STRM_MAP_C1R\0".to_vec();
+        assert!(patch_stored(&stored, &long).is_err(), "a longer name never fits");
+        let mut ptr = f.clone();
+        ptr.ptrs.push(Ptr { off: 0x4, old: Some(b"STRM_MAP_E1".to_vec()), new: None, target: None, old_value: Some(se + 6) });
