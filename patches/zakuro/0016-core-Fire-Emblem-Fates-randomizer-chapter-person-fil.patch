+/// engine round E1: a file stored plain (`map/config/*.bin`): the IS .bin itself, patched
+/// in place. Only plain cells (the data or the pool); the result must keep the exact size,
+/// because the game reads the size its RomFS directory gives.
+pub fn patch_plain(stored: &[u8], f: &FilePatch) -> Result<Vec<u8>, Vec<String>> {
+    let one = |e: String| vec![format!("{}: {e}", f.rel)];
+    if !f.ptrs.is_empty() {
+        return Err(one("label pointers are not laid in a plain file".into()));
+    }
+    let mut bin = IsBin::parse(stored).map_err(one)?;
+    let bad = guard(&bin, f);
+    if !bad.is_empty() {
+        return Err(bad);
+    }
+    apply(&mut bin, f);
+    let out = bin.build();
+    if out.len() != stored.len() {
+        return Err(one(format!("the patched file has {} bytes, the original {}", out.len(), stored.len())));
+    }
+    Ok(out)
+}
