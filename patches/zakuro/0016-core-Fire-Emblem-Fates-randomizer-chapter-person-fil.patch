+    /// `len` bytes at `off` (from the data start): in the data, or (engine round E1) in the
+    /// string pool at or past its start; never in the relocation or label lists, never
+    /// across the end of either.
+    pub fn cell(&self, off: u32, len: usize) -> Option<&[u8]> {
+        let (o, se) = (off as usize, self.se() as usize);
+        if o + len <= self.data.len() {
+            Some(&self.data[o..o + len])
+        } else if o >= se {
+            self.strtab.get(o - se..o - se + len)
+        } else {
+            None
+        }
+    }
+
+    pub fn cell_mut(&mut self, off: u32, len: usize) -> Option<&mut [u8]> {
+        let (o, se) = (off as usize, self.se() as usize);
+        if o + len <= self.data.len() {
+            Some(&mut self.data[o..o + len])
+        } else if o >= se {
+            self.strtab.get_mut(o - se..o - se + len)
+        } else {
+            None
+        }
+    }
