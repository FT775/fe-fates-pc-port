+/// round 59 (docs/rando/SPEED.md 4, headless half): a randomized answer known before the
+/// mode pick (boot-server's `rando-answer`, FEF_RANDO_ANSWER) with its seed is made in a
+/// background thread, exactly as `answer` would make it (same text, same run id). Only
+/// files are written (`build/rando-make/<id>/`, the run folder, the cache); nothing is laid
+/// before the pick, which then waits for this make and only lays it. A changed answer starts
+/// a new make; the old one is left to end (a run folder is only complete with patch.txt).
+fn prebuild(system: &mut System) {
+    let Some(text) = system.rando.known_answer(system.frames) else { return };
+    if system.rando.prebuild.as_ref().is_some_and(|p| p.text == text) {
+        return;
+    }
+    if let Some(old) = system.rando.prebuild.take() {
+        old.cancel.store(true, Ordering::Relaxed);
+        log::info!("fates_rando: the answer changed: background make {} is a guess thrown away", old.id);
+        system.rando.discarded.push(old);
+    }
+    if json_field(&text, "randomizer").as_deref() != Some("true") {
+        return;
+    }
+    let game = system.config.fates_rando_game.clone();
+    let Ok((seed, id)) = run_id_for(&text, game.as_deref()) else { return };
+    let data = data_dir(system);
+    let made = run_dir(&data, &id);
+    let cancel = Arc::new(AtomicBool::new(false));
+    if made.join("patch.txt").is_file() {
+        let handle = std::thread::spawn(move || Ok(made));
+        system.rando.prebuild = Some(Prebuilt { text, id, cancel, fresh: false, handle });
+        return;
+    }
+    let full = answer_for(&text, game.as_deref());
+    log::info!("fates_rando: making {id} in the background (nothing is laid before the mode pick)");
+    let (c, i) = (cancel.clone(), id.clone());
+    let handle = std::thread::spawn(move || {
+        make_run_cancellable(&data, &i, &seed, &full, game.as_deref(), &c, &Arc::new(AtomicU8::new(0)))
+    });
+    system.rando.prebuild = Some(Prebuilt { text, id, cancel, fresh: true, handle });
+}
+
+/// one headless background make: its answer text, run id, cancel flag, whether this
+/// program made it (only then may it be thrown away), and its thread.
+#[derive(Debug)]
+pub struct Prebuilt {
+    text: String,
+    id: String,
+    cancel: Arc<AtomicBool>,
+    fresh: bool,
+    handle: std::thread::JoinHandle<Result<PathBuf, String>>,
+}
