+/// guess, thrown away (cancelled, its folders removed) the moment the page's values change.
+pub struct Prebuild {
+    pub text: String,
+    pub id: String,
+    cancel: Arc<AtomicBool>,
+    progress: Arc<AtomicU8>,
+    done: Receiver<Result<PathBuf, String>>,
+    pub result: Option<Result<PathBuf, String>>,
+    /// made by this page (a run that was already complete, which a save may name, is never
+    /// thrown away)
+    pub fresh: bool,
+}
+
+impl Prebuild {
+    /// starts the make of `text` (None when the answer has no valid seed or game data).
+    pub fn start(text: String, data: &Path, game: Option<&str>) -> Option<Prebuild> {
+        let (seed, id) = zakuro_core::fates_rando_session::run_id_for(&text, game).ok()?;
+        let full = zakuro_core::fates_rando_session::answer_for(&text, game);
+        let (cancel, progress) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicU8::new(0)));
+        let (send, done) = channel();
+        let (c, pr, d, i, g) = (cancel.clone(), progress.clone(), data.to_path_buf(), id.clone(), game.map(str::to_owned));
+        let fresh = !zakuro_core::fates_rando_session::run_dir(data, &id).join("patch.txt").is_file();
+        log::info!(target: "zakuro::rando", "background make of {id} started (a guess: nothing is laid before Start game)");
+        std::thread::spawn(move || {
+            let made = zakuro_core::fates_rando_session::run_dir(&d, &i);
+            let r = if made.join("patch.txt").is_file() {
+                Ok(made)
+            } else {
+                zakuro_core::fates_rando_session::make_run_cancellable(&d, &i, &seed, &full, g.as_deref(), &c, &pr)
+            };
+            let _ = send.send(r);
+        });
+        Some(Prebuild { text, id, cancel, progress, done, result: None, fresh })
+    }
+
+    /// the make's result once it ended.
+    pub fn poll(&mut self) -> Option<&Result<PathBuf, String>> {
+        if self.result.is_none() {
+            match self.done.try_recv() {
+                Ok(r) => self.result = Some(r),
+                Err(TryRecvError::Disconnected) => self.result = Some(Err("the background make stopped".into())),
+                Err(TryRecvError::Empty) => {}
+            }
+        }
+        self.result.as_ref()
+    }
+
+    pub fn percent(&self) -> u8 {
+        self.progress.load(Ordering::Relaxed)
+    }
+
+    pub fn cancel(&self) {
+        self.cancel.store(true, Ordering::Relaxed);
+    }
