+    /// the FE options page. Stores values only. Does not read a save, does
+    /// not write Zakuro's settings, and does not rebuild anything.
+    pub fn fe_options_page(&mut self, ctx: &egui::Context) {
+        if !self.fe_options_open {
+            return;
+        }
+        let mut open = true;
+        let path = crate::fe_options::options_path();
+        let mut options = path.as_deref().map(crate::fe_options::load).unwrap_or_default();
+        let slot = self.slot.clamp(1, 9);
+        let mark = path.as_deref().map(crate::fe_options::mark_path);
+        let mut run = mark.as_deref().and_then(|path| crate::fe_options::load_mark(path).get(&slot).copied()).unwrap_or(options.run);
+        let before_display = options.display;
+        let before_run = run;
+        egui::Window::new("FE options")
+            .collapsible(false)
+            .resizable(false)
+            .open(&mut open)
+            .anchor(egui::Align2::CENTER_CENTER, Vec2::ZERO)
+            .show(ctx, |ui| {
+                ui.label(RichText::new("Off is the original game. Nothing here is applied yet.").weak());
+                match &path {
+                    Some(path) => ui.label(RichText::new(path.display().to_string()).monospace().weak()),
+                    None => ui.label(RichText::new("PLAY has not set FE_OPTIONS, so this page will not write.").color(Color32::from_rgb(230, 160, 80))),
+                };
+                ui.add_space(6.0);
+                ui.label(RichText::new("Display").strong());
+                for (index, (_, label)) in crate::fe_options::DISPLAY.iter().enumerate() {
+                    let mut on = options.display[index] != 0;
+                    if ui.checkbox(&mut on, *label).changed() {
+                        options.display[index] = u8::from(on);
+                    }
+                }
+                ui.add_space(6.0);
+                ui.label(RichText::new(format!("Run options, slot {slot}")).strong());
+                ui.label(RichText::new("Saved for this slot only. Not written into the game's save.").weak());
+                for (index, (_, max, label)) in crate::fe_options::RUN.iter().enumerate() {
+                    ui.add(egui::Slider::new(&mut run[index], 0..=*max).text(*label));
+                }
+            });
+        self.fe_options_open = open;
+        if options.display == before_display && run == before_run {
+            return;
+        }
+        options.run = run;
+        let Some(path) = path else {
+            self.message = Some("FE options were not saved. PLAY has not set FE_OPTIONS.".to_owned());
+            return;
+        };
+        if let Err(error) = crate::fe_options::store(&path, &options) {
+            self.message = Some(format!("Could not write {}: {error}", path.display()));
+            return;
+        }
+        if run != before_run {
+            let mark = crate::fe_options::mark_path(&path);
+            if let Err(error) = crate::fe_options::store_mark(&mark, slot, run) {
+                self.message = Some(format!("Could not write {}: {error}", mark.display()));
+            }
+        }
+    }
+
     /// the settings window, when open. own says the running game has
     /// settings of its own, which go over these.
     pub fn settings(&mut self, ctx: &egui::Context, settings: &mut Settings, own: bool) -> Vec<Action> {
